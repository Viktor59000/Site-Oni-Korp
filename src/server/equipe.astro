---
// Espace équipe (connexion Discord) : matchs et scrims du roster, séances avec réponse en un clic, disponibilités,
// agenda perso à synchroniser, et pour l'encadrement le bilan de présence.
// Les données viennent de la base partagée avec Oni Bot ; une réponse ici met à jour le message Discord dans la minute.
import { currentSession, icsKey, userKeys } from './session';
import { rows, weekKey } from './db';
import { access, canLead } from './equipe/access';
import { CHOICES, HOURS, encode, loadDispos } from './equipe/dispos';
import { kindLabel } from './ics';
import Qg from './equipe/Qg.astro';
import { scope } from './equipe/outils';
import InsideIntro from './equipe/InsideIntro.astro';

export const prerender = false;

const user = await currentSession(Astro.cookies);
const erreur = Astro.url.searchParams.get('erreur');
const me = user ? await access(user.id) : null;

const GAME: Record<string, { label: string; color: string; code: string }> = {
  rl: { label: 'Rocket League', color: '#2f6bff', code: 'RL' }, lol: { label: 'League of Legends', color: '#0f8a9b', code: 'LoL' },
  valo: { label: 'Valorant', color: '#ff4655', code: 'VAL' }, osu: { label: 'osu!', color: '#ff66aa', code: 'osu!' },
};
const tz = { timeZone: 'Europe/Paris' } as const;
const fDay = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', ...tz });
const fMonth = new Intl.DateTimeFormat('fr-FR', { month: 'short', ...tz });
const fWhen = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', hour: '2-digit', minute: '2-digit', ...tz });
// Disponibilités : semaine prochaine par défaut (on prépare), cette semaine sur demande
const sem = Astro.url.searchParams.get('sem') === 'cur' ? 'cur' : 'next';
const week = weekKey(sem === 'next');
const weekLabel = week.split('-').reverse().join('/');
const weekDays = Array.from({ length: 7 }, (_, d) => { const x = new Date(`${week}T12:00:00Z`); x.setUTCDate(x.getUTCDate() + d); return x; });
const fDayShort = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', timeZone: 'UTC' });

// Agenda perso : lien secret à ajouter une fois dans Google / Apple / Outlook
const host = Astro.url.host;
const icsPath = user && process.env.SESSION_SECRET ? `/api/equipe/agenda.ics?u=${user.id}&k=${icsKey(user.id, (await userKeys(user.id)).salt)}` : null;
const icsGoogle = icsPath ? `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(`webcal://${host}${icsPath}`)}` : null;

type T = { id: number; roster_id: number; at: number; duration: number; kind: string; note: string | null; plan?: string | null };
type A = { training_id: number; user_id: string; status: string; reason: string | null };
type Mb = { id: string; name: string; avatar: string };

const sc = me ? scope(me.rosters, Astro.url, Astro.cookies) : { active: null, list: [] };
const spaces = me ? await Promise.all(sc.list.map(async (r) => {
  const members = await rows<Mb>(`SELECT id, name, avatar FROM guild_members WHERE roles LIKE ? ORDER BY name`, `%"${r.role_id}"%`);
  const byId = new Map(members.map((m) => [m.id, m]));
  const trainings = await rows<T>('SELECT * FROM trainings WHERE roster_id = ? AND cancelled = 0 AND at > ? ORDER BY at LIMIT 8', r.id, Date.now() - 3 * 3600_000);
  const games = await rows<{ id: number; opponent: string; format: string; at: number; kind: string | null; link: string | null }>(
    'SELECT id, opponent, format, at, kind, link FROM matches WHERE roster_id = ? AND cancelled = 0 AND score_us IS NULL AND at > ? ORDER BY at LIMIT 6', r.id, Date.now() - 3 * 3600_000);
  const answers = trainings.length ? await rows<A>(`SELECT * FROM attendance WHERE training_id IN (${trainings.map(() => '?').join(',')})`, ...trainings.map((t) => t.id)) : [];
  const dispos = await loadDispos(r.id, r.game, week, members, user!.id);
  // Bilan 30 jours (encadrement)
  let bilan: { name: string; avatar: string; rate: number; p: number; a: number; m: number; n: number }[] = [];
  let past = 0;
  if (me.staff) {
    const done = await rows<{ id: number }>('SELECT id FROM trainings WHERE roster_id = ? AND cancelled = 0 AND at BETWEEN ? AND ?', r.id, Date.now() - 30 * 86400_000, Date.now());
    past = done.length;
    const ans = past ? await rows<A>(`SELECT * FROM attendance WHERE training_id IN (${done.map(() => '?').join(',')})`, ...done.map((t) => t.id)) : [];
    bilan = members.map((m) => {
      const mine = ans.filter((x) => x.user_id === m.id);
      const p = mine.filter((x) => x.status === 'present').length;
      return { name: m.name, avatar: m.avatar, p, a: mine.filter((x) => x.status === 'absent').length, m: mine.filter((x) => x.status === 'peut-etre').length, n: past - mine.length, rate: past ? Math.round((p / past) * 100) : 0 };
    }).sort((x, y) => y.rate - x.rate);
  }
  return {
    r, g: GAME[r.game] ?? { label: r.game, color: '#e5251f', code: r.game.toUpperCase() }, members, past, bilan, dispos, total: members.length || 1, games,
    trainings: trainings.map((t) => {
      const list = answers.filter((a) => a.training_id === t.id);
      const who = (s: string) => list.filter((a) => a.status === s).map((a) => ({ ...(byId.get(a.user_id) ?? { id: a.user_id, name: 'Membre', avatar: '' }), reason: a.reason }));
      return {
        ...t, mine: list.find((a) => a.user_id === user!.id)?.status ?? null,
        groups: [
          { key: 'ok', label: 'Présents', people: who('present') },
          { key: 'maybe', label: 'Peut-être', people: who('peut-etre') },
          { key: 'ko', label: 'Absents', people: who('absent') },
          { key: 'wait', label: 'Sans réponse', people: members.filter((m) => !list.some((a) => a.user_id === m.id)).map((m) => ({ ...m, reason: null })) },
        ],
        answered: list.length,
      };
    }),
  };
})) : [];
const date = (ms: number) => new Date(Number(ms));
// Pas d'accès (non connecté, ou membre sans roster, sans staff ni contenu) : présentation d'Inside
if (me?.mod && !me.rosters.length && !me.content.length) return Astro.redirect('/equipe/vue/');
const noAccess = !user || !!(me?.member && !me.staff && !me.rosters.length && !me.content.length) || (import.meta.env.DEV && Astro.url.searchParams.has('intro')); // ?intro : aperçu en local

---
<Qg title={noAccess ? 'Oni Inside' : 'Planning · Inside'} heading={noAccess ? 'Oni Inside' : 'Planning'}
  lead={noAccess ? 'Ce que les joueurs et le staff du club ont sous la main, et comment y entrer.' : 'Séances à venir, disponibilités de la semaine et présence.'}
  current="planning" rosters={me?.rosters ?? []} staff={!!me?.staff} active={sc.active} bare={!(me?.member && (me.staff || me.rosters.length > 0))}
  user={user ? { name: me?.member?.name ?? user.name, avatar: me?.member?.avatar ?? user.avatar } : null}>
  {icsPath && me?.rosters.length ? (
    <details class="qg-drawer" slot="actions">
      <summary class="btn btn--ghost">Synchroniser mon agenda</summary>
      <div class="qg-drawer__panel" role="dialog" aria-label="Agenda perso">
        <div class="qg-drawer__head"><h2>Mon agenda perso</h2><button type="button" class="qg-close" aria-label="Fermer" onclick="this.closest('details').open = false">×</button></div>
        <p>Séances, scrims et matchs de {me.staff ? 'tous les rosters' : 'ton roster'}, dans ton agenda. À ajouter une seule fois : il se met à jour tout seul.</p>
        <a class="btn" href={icsGoogle!} rel="noopener">Ajouter à Google Agenda</a>
        <a class="btn btn--ghost" href={`webcal://${host}${icsPath}`}>Apple · Outlook</a>
        <label class="eq-note">Lien personnel (ne le partage pas)
          <input type="text" readonly value={`https://${host}${icsPath}`} onfocus="this.select()" />
        </label>
        <form method="post" action="/api/equipe/outils">
          <input type="hidden" name="action" value="ics-regen" /><input type="hidden" name="back" value="/equipe/planning/" />
          <button class="btn btn--ghost" type="submit">Lien partagé par erreur ? En créer un nouveau</button>
        </form>
        <p class="eq-note">L'ancien lien cesse aussitôt de marcher : il faudra ré-ajouter l'agenda.</p>
      </div>
    </details>
  ) : null}
    <div class="eq">
      {noAccess && <InsideIntro connected={!!user} erreur={erreur} />}

      {user && me && !me.member && (
        <div class="eq-login">
          <p class="eq-alert">Oni Bot n'a pas encore transmis la liste des membres du serveur au site.</p>
          <p class="eq-note">Ça se fait automatiquement dès qu'Oni Bot tourne relié à la base de données. Reviens dans quelques minutes.</p>
        </div>
      )}
      {user && me?.member && me.staff && !me.rosters.length && (
        <div class="eq-login">
          <p>Aucun roster n'existe encore.</p>
          <p class="eq-note">Crée-les sur Discord avec <code>/roster creer</code>, puis ajoute les joueurs avec <code>/roster ajouter</code> : ils apparaîtront ici.</p>
        </div>
      )}

      {me?.staff && !sc.active && <p class="eq-note"><a href="/equipe/vue/">Vue d'ensemble de l'encadrement</a> : santé des rosters, alertes, candidatures.</p>}


      {spaces.map((s) => (
        <article class="eq-roster" style={`--team:${s.g.color}`} id={`roster-${s.r.slug}`}>
          <header class:list={["eq-roster__head", { "is-single": spaces.length === 1 }]}>
            <b class="eq-roster__code" aria-hidden="true" translate="no">{s.g.code}</b>
            <div>
              <h2>{s.r.name}</h2>
              <p>{s.g.label} · {s.members.length} joueur{s.members.length > 1 ? 's' : ''}</p>
            </div>
            <ul class="eq-faces" aria-label="Joueurs du roster">
              {s.members.map((m) => <li title={m.name}><img src={m.avatar} alt="" width="32" height="32" loading="lazy" crossorigin="anonymous" referrerpolicy="no-referrer" /><span class="sr-only">{m.name}</span></li>)}
            </ul>
          </header>

          {s.games.length > 0 && (
            <>
              <h3>Matchs et scrims</h3>
              <ol class="eq-games">
                {s.games.map((m) => (
                  <li>
                    <time class="eq-date" datetime={date(m.at).toISOString()}><b>{fDay.format(date(m.at))}</b>{fMonth.format(date(m.at))}</time>
                    <div>
                      <p class="eq-games__vs">vs {m.opponent}</p>
                      <p class="eq-note">{fWhen.format(date(m.at))} · {m.format}</p>
                    </div>
                    <span class:list={['eq-kind', { 'is-public': (m.kind ?? 'officiel') !== 'scrim' }]}>{kindLabel(m.kind)}</span>
                  </li>
                ))}
              </ol>
            </>
          )}

          <h3>Prochaines séances</h3>
          {s.trainings.length ? (
            <ol class="eq-list">
              {s.trainings.map((t) => (
                <li class="eq-seance" id={`seance-${t.id}`}>
                  <time class="eq-date" datetime={date(t.at).toISOString()}><b>{fDay.format(date(t.at))}</b>{fMonth.format(date(t.at))}</time>
                  <div class="eq-seance__body">
                    <p class="eq-seance__title"><strong>{t.kind}</strong> <span>{fWhen.format(date(t.at))} · {t.duration} min</span></p>
                    {t.note && <p class="eq-seance__note">{t.note}</p>}
                    {/* Plan de séance (07/10) : écrit par le capitaine ou le coach, repris sur la carte Discord de la séance */}
                    {me && canLead(me, s.r.id) ? (
                      <details class="eq-plan" open={!!t.plan}>
                        <summary>{t.plan ? 'Plan de la séance' : 'Écrire le plan de la séance'}</summary>
                        <form method="post" action="/api/equipe/outils">
                          <input type="hidden" name="action" value="plan-seance" /><input type="hidden" name="training" value={t.id} /><input type="hidden" name="back" value={`/equipe/planning/?r=${s.r.slug}#seance-${t.id}`} />
                          <textarea name="plan" rows="4" maxlength="1000" placeholder={['Échauffement 15 min', 'Thème : …', 'Exercices : …', 'Scrim ou revue de VOD'].join(String.fromCharCode(10))}>{t.plan ?? ''}</textarea>
                          <button class="btn btn--ghost">Enregistrer le plan</button>
                        </form>
                      </details>
                    ) : t.plan && <div class="eq-plan"><p class="eq-plan__h">Plan de la séance</p><p class="eq-plan__txt">{t.plan}</p></div>}
                    <form method="post" action="/api/equipe/presence" class="eq-answer">
                      <input type="hidden" name="training" value={t.id} />
                      <div class="eq-seg" role="group" aria-label="Ma réponse">
                        <button name="status" value="present" class:list={['is-ok', { 'is-on': t.mine === 'present' }]} aria-pressed={t.mine === 'present'}>Présent</button>
                        <button name="status" value="peut-etre" class:list={['is-maybe', { 'is-on': t.mine === 'peut-etre' }]} aria-pressed={t.mine === 'peut-etre'}>Peut-être</button>
                        <button name="status" value="absent" class:list={['is-ko', { 'is-on': t.mine === 'absent' }]} aria-pressed={t.mine === 'absent'}>Absent</button>
                      </div>
                      <input name="reason" type="text" maxlength="100" placeholder="Raison (si absent ou peut-être)" aria-label="Raison" />
                    </form>
                    <div class="eq-who-list">
                      <span class="eq-count"><b>{t.answered}</b>/{s.members.length} réponses</span>
                      {t.groups.filter((g) => g.people.length).map((g) => (
                        <ul class={`eq-chips is-${g.key}`} aria-label={g.label}>
                          {g.people.map((p) => (
                            <li title={p.reason ? `${p.name} · ${p.reason}` : p.name}>
                              {p.avatar && <img src={p.avatar} alt="" width="24" height="24" loading="lazy" crossorigin="anonymous" referrerpolicy="no-referrer" />}{p.name}{p.reason && <small>{p.reason}</small>}
                            </li>
                          ))}
                        </ul>
                      ))}
                    </div>
                  </div>
                </li>
              ))}
            </ol>
          ) : <p class="eq-empty">Aucune séance prévue. L'encadrement les planifie avec <code>/entrainement</code> sur Discord.</p>}

          <h3 id={`dispos-${s.r.id}`}>Disponibilités · semaine du {weekLabel}</h3>
          <nav class="dp-weeks" aria-label="Semaine">
            <a href={`?r=${s.r.slug}&sem=cur#dispos-${s.r.id}`} aria-current={sem === 'cur' ? 'page' : undefined}>Cette semaine</a>
            <a href={`?r=${s.r.slug}&sem=next#dispos-${s.r.id}`} aria-current={sem === 'next' ? 'page' : undefined}>Semaine prochaine</a>
          </nav>

          {/* Ma semaine : un menu par jour, comme dans un Sheet, plus le poste et la semaine type */}
          {s.dispos.mine && (
            <form method="post" action="/api/equipe/dispos" class="dp-mine">
              <input type="hidden" name="roster" value={s.r.id} />
              <input type="hidden" name="week" value={week} />
              <input type="hidden" name="slug" value={s.r.slug} />
              <input type="hidden" name="sem" value={sem} />
              <p class="dp-label">Ma semaine</p>
              <div class="dp-days">
                {weekDays.map((day, d) => (
                  <label class:list={['dp-day', `is-${s.dispos.mine![d].state || 'vide'}`]}>
                    <span>{fDayShort.format(day)}</span>
                    <select name={`d${d}`}>
                      {CHOICES.map(([v, l]) => <option value={v} selected={encode(s.dispos.mine![d].state ? s.dispos.mine![d] : undefined) === v}>{l}</option>)}
                    </select>
                  </label>
                ))}
              </div>
              <div class="dp-actions">
                <label class="dp-poste">Mon poste
                  <select name="poste">
                    <option value="">À choisir</option>
                    {s.dispos.postes.map((po) => <option value={po} selected={s.dispos.myPoste === po}>{po}</option>)}
                  </select>
                </label>
                <button class="btn" name="action" value="save">Enregistrer</button>
                <button class="btn btn--ghost" name="action" value="save-type" title="Enregistre aussi ces jours comme tes dispos habituelles">Enregistrer comme semaine type</button>
                {s.dispos.hasType && <button class="btn btn--ghost" name="action" value="apply-type" title="Remplit la semaine avec tes dispos habituelles">Remplir avec ma semaine type</button>}
              </div>
            </form>
          )}

          {/* L'équipe, par poste, et le verdict de chaque jour */}
          <div class="dp-team-wrap">
            <table class="dp-team">
              <thead><tr><th scope="col">Poste</th><th scope="col">Joueur</th>{weekDays.map((day) => <th scope="col">{fDayShort.format(day)}</th>)}</tr></thead>
              <tbody>
                {s.dispos.people.map((p) => (
                  <tr class:list={{ 'is-me': p.id === user!.id, 'is-coach': p.poste === 'Coach' }}>
                    <th scope="row" class="dp-poste-cell">{p.poste ?? '—'}</th>
                    <td class="dp-name">{p.name}</td>
                    {p.days.map((d) => (
                      <td class:list={['dp-cell', `is-${d.state || 'vide'}`]}>{d.state === 'oui' ? (d.start ? d.start.replace(':', 'h') : 'Dispo') : d.state === 'peut' ? 'Pas sûr' : d.state === 'non' ? 'Pas dispo' : ''}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <th scope="row" colspan="2">Jouable ?</th>
                  {s.dispos.verdicts.map((v) => <td class:list={['dp-verdict', { 'is-ok': v.ok }]}><strong>{v.ok ? `✓ ${v.label}` : v.label}</strong>{v.detail && <small>{v.detail}</small>}</td>)}
                </tr>
                <tr class="dp-prog-row">
                  <th scope="row" colspan="2">Programme</th>
                  {s.dispos.plans.map((pl, d) => (
                    <td class:list={['dp-prog', { 'is-todo': !pl && s.dispos.verdicts[d].ok, 'is-off': pl?.kind === 'OFF' }]}>
                      {pl ? <strong>{pl.kind}</strong> : s.dispos.verdicts[d].ok ? <strong>À programmer</strong> : <span>—</span>}
                      {pl?.start && <small>{pl.start.replace(':', 'h')}</small>}
                    </td>
                  ))}
                </tr>
              </tfoot>
            </table>
          </div>
          <p class="eq-note">Un jour est jouable quand assez de joueurs sont dispo et que chaque poste titulaire renseigné est couvert. L'heure indiquée est celle où le dernier joueur nécessaire arrive. « À programmer » : tout le monde est là, reste à décider ce qu'on fait.</p>
          {me && canLead(me, s.r.id) && (
            <form method="post" action="/api/equipe/dispos" class="dp-prog-form">
              <input type="hidden" name="roster" value={s.r.id} /><input type="hidden" name="week" value={week} />
              <input type="hidden" name="slug" value={s.r.slug} /><input type="hidden" name="sem" value={sem} />
              <p class="dp-label">Programme de la semaine <small>(capitaine, coach, staff)</small></p>
              <div class="dp-days">
                {weekDays.map((day, d) => (
                  <label class:list={['dp-day', { 'is-oui': s.dispos.verdicts[d].ok }]}>
                    <span>{fDayShort.format(day)}{s.dispos.verdicts[d].ok ? ' ✓' : ''}</span>
                    <select name={`p${d}`} aria-label={`Programme du ${fDayShort.format(day)}`}>
                      <option value="">—</option>
                      {[...new Set([...s.dispos.programmes, ...(s.dispos.plans[d] ? [s.dispos.plans[d]!.kind] : [])])].map((k) => <option value={k} selected={s.dispos.plans[d]?.kind === k}>{k}</option>)}
                    </select>
                    <select name={`h${d}`} aria-label={`Heure du ${fDayShort.format(day)}`}>
                      <option value="">Heure</option>
                      {HOURS.map((h) => <option value={h} selected={s.dispos.plans[d]?.start === h}>{h.replace(':', 'h')}</option>)}
                    </select>
                  </label>
                ))}
              </div>
              <div class="dp-actions"><button class="btn" name="action" value="programme">Enregistrer le programme</button></div>
            </form>
          )}

          {me!.staff && (
            <>
              <h3>Présences · 30 derniers jours <span>({s.past} séance{s.past > 1 ? 's' : ''})</span></h3>
              {s.past ? (
                <ul class="eq-bilan">
                  {s.bilan.map((b) => (
                    <li>
                      <span class="eq-bilan__name">{b.avatar && <img src={b.avatar} alt="" width="24" height="24" loading="lazy" crossorigin="anonymous" referrerpolicy="no-referrer" />}{b.name}</span>
                      <span class="eq-bilan__bar" style={`--rate:${b.rate}%`}><span></span></span>
                      <strong>{b.rate} %</strong>
                      <span class="eq-note">{b.p} présent · {b.m} peut-être · {b.a} absent · {b.n} sans réponse</span>
                    </li>
                  ))}
                </ul>
              ) : <p class="eq-empty">Pas encore de séance passée sur cette période.</p>}
            </>
          )}
        </article>
      ))}
    </div>
</Qg>

<style>
  .eq { display: grid; gap: clamp(3rem, 6vw, 5rem); }
  .eq-head h1 { font-size: clamp(2.4rem, 7vw, 4.5rem); }
  .eq-who { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .eq-who img { border-radius: 50%; }
  .eq-who p { margin: 0; max-width: none; font-size: 1rem; }
  .eq-who strong { font-size: 1.15rem; }
  .eq-tag { margin-left: .6rem; font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; background: var(--lacquer); color: #fff; padding: .15rem .5rem; vertical-align: .2em; }
  .eq-cal { margin-left: auto; position: relative; }
  .eq-cal summary { list-style: none; cursor: pointer; }
  .eq-cal summary::-webkit-details-marker { display: none; }
  .eq-cal__panel { position: absolute; right: 0; top: calc(100% + .5rem); z-index: 5; width: min(24rem, 90vw); display: grid; gap: .75rem; padding: 1.25rem; background: var(--surface); border: 1px solid var(--line); box-shadow: 0 12px 32px rgb(0 0 0 / .25); }
  .eq-cal__panel p { font-size: var(--step--1); color: var(--ink); max-width: none; margin: 0; }
  .eq-cal__panel input { width: 100%; margin-top: .3rem; padding: .5rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: .75rem monospace; }
  @media (max-width: 640px) { .eq-cal { margin-left: 0; width: 100%; } .eq-cal__panel { position: static; width: auto; margin-top: .5rem; } }

  .eq-staff { display: grid; grid-template-columns: auto 1fr; gap: 1rem 2.5rem; align-items: start; padding: 1.25rem; border: 1px solid var(--line); }
  .eq-bot { display: flex; align-items: center; gap: .5rem; font-weight: 700; white-space: nowrap; }
  .eq-bot span { width: .65rem; height: .65rem; border-radius: 50%; background: var(--lacquer); }
  .eq-bot.is-on span { background: #1f8f55; }
  .eq-staff__title { font-weight: 700; margin-bottom: .4rem; }
  .eq-cands { display: grid; gap: .3rem; }
