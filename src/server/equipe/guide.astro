---
import { exec } from '../db';
// Guide de l'espace équipe : démarrage rapide (joueurs, encadrement) et rôle de chaque outil, avec les commandes Discord liées.
import Qg from './Qg.astro';
import { teamUser } from './outils';

export const prerender = false;
const t = await teamUser(Astro.cookies);
if (!t) return Astro.redirect('/equipe/');
// Pour la carte « Bien démarrer » de l'accueil
await exec('INSERT INTO meta VALUES (?, ?) ON CONFLICT(key) DO NOTHING', `guide:${t.user.id}`, String(Date.now())).catch(() => {});
const { me } = t;
const JOUEUR = [
  ['Relie tes comptes', 'Onglet Joueurs : Riot ID (LoL et Valorant), pseudo Rocket League, pseudo osu!. Tes rangs et tes parties arrivent tout seuls.', '/equipe/joueurs/'],
  ['Remplis ton setup', 'Sensibilité, viseur, caméra, zone de tablette : utile à tout le roster.', '/equipe/setup/'],
  ['Réponds aux séances', 'Présent, peut-être ou absent, ici ou sur Discord : c\'est la même réponse.', '/equipe/planning/'],
  ['Coche tes dispos', 'Chaque semaine, tes créneaux : le staff planifie avec.', '/equipe/planning/'],
  ['Écris ton débrief', 'Après chaque match ou scrim, deux minutes : ce qui a marché, ce qu\'on travaille.', '/equipe/notes/'],
];
const STAFF = [
  ['Crée le roster', '/roster creer puis /roster ajouter sur Discord : rôle, salons et espace sur le site.'],
  ['Planifie', '/entrainement planifier pour les séances, /match ajouter pour les matchs (type « scrim » pour ce qui reste interne).'],
  ['Fixe des objectifs', 'Onglet Objectifs : par joueur ou pour tout le roster, avec une échéance.'],
  ['Prépare les matchs', 'Avant-match : compo, fiche de l\'adversaire (Scouting), tableau blanc, check-in.'],
  ['Suis le club', 'Vue d\'ensemble : alertes, présence, débriefs manquants, candidatures.'],
];
const OUTILS = [
  ['Planning', 'Séances à venir avec réponses, disponibilités de la semaine avec le programme de chaque soir (Scrim, Clash, Flex, OFF…), présence sur 30 jours.', '/entrainement, /dispos, /presences'],
  ['Calendrier', 'Le mois du roster : séances (avec ta réponse), matchs, scrims, échéances.', ''],
  ['Avant-match', 'Une page par match : horaires, compo, plan contre l\'adversaire, strats, checklist, puis débrief et stats.', '/match compo'],
  ['Stats', 'Mesures en jeu par joueur avec tendances : LoL, Valorant et osu! automatiques, Rocket League via Oni Sync (ou ballchasing, ou saisie).', ''],
  ['Trackers', 'Un par jeu (RL, LoL, Valorant, osu!) : tes parties analysées en détail, ce qui ressort par rapport au roster, et « En faire un objectif » sur un point à travailler.', ''],
  ['Objectifs', 'Ce qu\'on vise et où on en est. Un objectif fixé à un joueur est privé (lui et l\'encadrement), sauf si on le rend visible à tout le roster. Ceux créés depuis un Tracker se mesurent tout seuls.', ''],
  ['Notes de match', 'Débriefs écrits ; le bot les demande 2 h après chaque match.', ''],
  ['VOD', 'Vidéos commentées avec des repères horodatés, un clic saute au moment.', ''],
  ['Scouting', 'Fiches des adversaires avec l\'historique contre nous, et l\'annuaire des scrims : niveau, contact, statut, message « Proposer un scrim » prêt à copier.', ''],
  ['Écoute des scrims', 'Le bot transcrit la comm du vocal (voix des joueurs qui ont accepté, jamais le son) et écrit un rapport dans les Docs : à travailler, temps de parole, transcription.', '/ecoute, bouton « Écouter la comm » du rappel de match'],
  ['Tableau blanc', 'Carte, éléments, crayon, post-it et étapes, en direct ; mode présentation et export en image pour Discord.', ''],
  ['Drafter LoL · Lineups Valorant · Défis osu!', 'Les outils propres à chaque jeu.', ''],
  ['Docs', 'Dans Préparer : les docs du roster (routines, règles, appels), ceux du jeu (écrits par le responsable du jeu) et ceux du club (fiches de poste, règlement).', ''],
  ['Setups · Joueurs', 'Réglages de chacun, comptes de jeu et profils.', ''],
];
// Les rôles et ce qu'ils ouvrent (SWOT-ROLES.md, chantier 1)
const ROLES: [string, string][] = [
  ['Joueur', 'Ton roster : planning, matchs, stats, objectifs, outils du jeu. Titulaire, remplaçant ou en essai (avec une date de fin et un retour écrit).'],
  ['Capitaine', 'Gère son roster : séances, compo, objectifs, épingles, statuts des joueurs. Sur Discord : /match, /entrainement, /dispos, /presences pour son roster.'],
  ['Analyste', 'Suit un roster (scouting, drafter, VOD) sans compter comme joueur.'],
  ['Responsable d\'un jeu', 'Tous les rosters de son jeu, l\'Espace de ce jeu (candidatures, essais, tournois), les docs du jeu et les commandes du bot pour ces rosters.'],
  ['Coach, manager', 'Encadrement : tous les rosters, tout gérer.'],
  ['Pôle contenu', 'Casteur, graphiste, monteur, community manager, créateur, marketing : l\'onglet Contenu (matchs à couvrir, tâches, calendrier éditorial, indicateurs). Rien n\'est publié sans validation de la direction.'],
  ['Modération, accueil, organisation', 'L\'espace Communauté d\'Inside : arrivées, soirées et tournois communautaires ; la modération (tickets, avertissements) pour les modérateurs.'],
];
// Fiches de poste (NUIT-2026-10-07.md, § 1.3) : [titre, mission, semaine type, ce que le club donne, première semaine, interlocuteur]
const FICHES: [string, string, string, string, string, string][] = [
  ['Responsable d\'un jeu', 'Faire vivre un jeu dans le club, des rosters au recrutement.', 'Répondre aux candidatures du jeu sous 48 h, un point avec chaque capitaine, tenir à jour les tournois visés, lire la vue d\'ensemble du jeu. Environ 3 h.', 'La vue d\'ensemble filtrée sur ton jeu, tous ses rosters dans Inside, /match, /entrainement, /dispos et /presences sur Discord.', 'Lire les candidatures, rencontrer chaque capitaine (15 min), ajouter 2 tournois réalistes dans Tournois, écrire la règle de compo du jeu dans Docs.', 'La direction.'],
  ['Capitaine', 'La voix du roster, en jeu et hors jeu.', 'Planifier les séances, ouvrir les dispos, faire la compo des matchs, relancer qui ne répond pas, tenir les statuts à jour.', 'La gestion de ton roster dans Inside (objectifs, compo, épingles, statuts) et les commandes du bot pour ton roster.', 'Désigner un remplaçant, fixer 2 séances, créer 1 objectif de roster.', 'Le responsable du jeu.'],
  ['Manager', 'L\'organisation : inscriptions, contacts avec les adversaires, logistique des matchs.', 'Chercher des scrims, inscrire aux tournois, annoncer les matchs avec /match ajouter (le brief contenu part tout seul).', 'Les messages d\'approche prêts, le suivi des tournois.', 'Contacter 3 équipes de la bonne tranche de niveau, avec des messages validés par la direction.', 'Le responsable du jeu.'],
  ['Coach', 'Faire progresser le roster.', 'Une séance de travail, une revue de VOD, un débrief après chaque match, les objectifs individuels.', 'VOD avec repères, tableau blanc, drafter LoL, lineups Valorant, stats et notes de match.', 'Fixer un objectif individuel par joueur, avec lui.', 'Le responsable du jeu.'],
  ['Analyste', 'Préparer les adversaires, analyser les drafts et les VOD.', 'Une fiche de scouting avant chaque match, la revue des drafts.', 'Le rôle Analyste (tu suis un roster sans compter comme joueur), scouting, drafter, VOD.', 'Une fiche de scouting sur le prochain adversaire.', 'Le coach, sinon le capitaine.'],
  ['Casteur', 'Commenter les matchs et les inhouses.', 'Prendre les matchs publics à caster, préparer les fiches des équipes.', 'L\'appel au cast sur Discord (« Je caste »), les matchs à venir dans Contenu, la chaîne Twitch du club.', 'Caster un inhouse pour t\'échauffer. Préviens 24 h avant si tu ne peux plus caster.', 'La direction.'],
  ['Graphiste', 'Les visuels d\'annonce et de résultat, les demandes du calendrier.', 'Les visuels des matchs publics (tâches créées toutes seules), les demandes ponctuelles.', 'Les tâches dans Contenu, le kit de marque, le crédit sur la page Staff.', 'Prendre une tâche « Visuel », déposer le lien du livrable : la direction valide.', 'Le community manager, sinon la direction.'],
  ['Monteur vidéo', 'Les clips des temps forts et les formats courts.', 'Le clip de chaque match casté (J+3), les vidéos du calendrier.', 'Les VOD des casts, les repères horodatés, la tâche « Clip » de chaque match.', 'Prendre la tâche « Clip » du prochain match casté.', 'Le community manager, sinon la direction.'],
  ['Community manager', 'La voix du club sur les réseaux.', 'Annonces, rappels et résultats (tâches automatiques), calendrier éditorial, un chiffre d\'abonnés par semaine dans Contenu.', 'La charte éditoriale, le calendrier éditorial, les indicateurs.', 'Remplir le calendrier de la semaine et saisir les abonnés de chaque réseau. Rien n\'est publié sans validation de la direction.', 'La direction.'],
  ['Modérateur', 'Un serveur sain.', 'Suivre les tickets, appliquer le règlement et la procédure de médiation.', 'La modération automatique par paliers, les tickets, le journal, et l’espace Communauté d’Inside (tickets, avertissements, sanctions ; jamais les stratégies des rosters).', 'Relire le règlement et la procédure. Une exclusion ne se décide jamais seul.', 'La direction.'],
  ['Accueil', 'Que personne n\'arrive sans qu\'on lui parle.', 'Saluer les arrivées, proposer un inhouse, orienter vers le bon salon.', 'Un message privé d’Oni Bot à chaque arrivée (pseudo, jeux choisis, quoi proposer), la carte de bienvenue et le parcours d’arrivée (relances à 3 et 7 jours).', 'Répondre aux 5 prochaines arrivées dans l’heure : un bonjour dans #général, un inhouse ou un vocal à proposer.', 'Le modérateur, sinon la direction.'],
  ['Organisateur', 'Une soirée ou un tournoi communautaire par semaine.', 'Choisir le format, annoncer, lancer, annoncer le résultat.', '/tournoi, les inhouses, l\'agenda public.', 'Organiser une soirée inhouse.', 'La direction.'],
];
// Médiation et sanctions (choix du 07/10 : grille progressive, avec exclusion directe pour faute grave)
const CONFLIT: [string, string][] = [
  ['Désamorcer', 'Le capitaine, ou un modérateur hors roster, sépare les personnes (vocaux différents) et note les faits.'],
  ['Écouter', 'Un échange privé avec chacun, dans les 48 h.'],
  ['Décider', 'Le coach ou le responsable du jeu pour un sujet de jeu (compo, temps de jeu), la direction pour un sujet de comportement.'],
  ['Écrire', 'Un résumé dans le ticket : les faits, la décision, la suite.'],
];
const SANCTIONS: [string, string][] = [
  ['1. Rappel', 'Un message privé qui rappelle la règle. Rien n\'est inscrit.'],
  ['2. Avertissement', 'Écrit, gardé dans le ticket. Il compte pendant 6 mois.'],
  ['3. Exclusion temporaire', '7 jours sans accès au serveur ni au roster.'],
  ['4. Exclusion définitive', 'Décidée par deux personnes de la direction.'],
  ['Faute grave', 'Harcèlement, propos discriminatoires, triche, partage de données personnelles : exclusion possible sans étape préalable, toujours à deux.'],
  ['Réexamen', 'Un ticket dans #🎫・support (motif « Contester une sanction ») dans les 7 jours, examiné par deux personnes de la direction qui n\'ont pas pris la décision.'],
];
---
<Qg title="Guide · Inside" heading="Guide" lead="Tout le roster au même endroit. Voici comment s'en servir." current="guide" rosters={me.rosters} staff={me.staff || me.games.length > 0} contenu={me.staff || me.content.length > 0} communaute={me.community} user={{ name: t.me.member?.name ?? t.user.name, avatar: t.me.member?.avatar ?? t.user.avatar }}>
    <div class="gd">
      <section>
        <h2 class="gd-h">Joueur : démarrer en 5 minutes</h2>
        <ol class="gd-steps">{JOUEUR.map(([t2, d, href]) => <li><a href={href}><strong>{t2}</strong><span>{d}</span></a></li>)}</ol>
      </section>
      {me.staff && (
        <section>
          <h2 class="gd-h">Encadrement</h2>
          <ol class="gd-steps">{STAFF.map(([t2, d]) => <li><div><strong>{t2}</strong><span>{d}</span></div></li>)}</ol>
        </section>
      )}
      <section>
        <h2 class="gd-h">Les rôles : qui voit quoi, qui gère quoi</h2>
        <dl class="gd-tools">{ROLES.map(([t2, d]) => <div><dt>{t2}</dt><dd>{d}</dd></div>)}</dl>
        <p class="eq-note">Les rôles se donnent sur Discord. Une question sur le tien : ton responsable de jeu, ou la direction.</p>
      </section>
      <section>
        <h2 class="gd-h">Conflits et sanctions</h2>
        <p class="eq-note">On parle avant de sanctionner. Une sanction grave n'est jamais décidée par une seule personne. Toute personne sanctionnée peut demander un réexamen.</p>
        <ol class="gd-steps">{CONFLIT.map(([t2, d]) => <li><div><strong>{t2}</strong><span>{d}</span></div></li>)}</ol>
        <dl class="gd-fiche gd-sanctions">{SANCTIONS.map(([t2, d]) => <><dt>{t2}</dt><dd>{d}</dd></>)}</dl>
      </section>
      <section class="gd-faq">
        <h2 class="gd-h">Fiches de poste</h2>
        <p class="eq-note">Pour chaque fonction : la mission, la semaine type, ce que le club te donne et ta première semaine. Les temps sont indicatifs.</p>
        {FICHES.map(([titre, mission, semaine, outils, debut, contact]) => (
          <details>
            <summary>{titre}</summary>
            <dl class="gd-fiche">
              <dt>Mission</dt><dd>{mission}</dd>
              <dt>La semaine type</dt><dd>{semaine}</dd>
              <dt>Ce que le club te donne</dt><dd>{outils}</dd>
              <dt>Ta première semaine</dt><dd>{debut}</dd>
              <dt>Ton interlocuteur</dt><dd>{contact}</dd>
            </dl>
          </details>
        ))}
      </section>
      <section>
        <h2 class="gd-h">Les outils</h2>
        <dl class="gd-tools">{OUTILS.map(([t2, d, cmd]) => <div><dt>{t2}</dt><dd>{d}{cmd && <code>{cmd}</code>}</dd></div>)}</dl>
      </section>
      <section class="gd-faq">
        <h2 class="gd-h">Questions fréquentes</h2>
        <details><summary>Mes stats ne s'affichent pas</summary><p>Vérifie ton compte dans Joueurs (Riot ID avec le #TAG). Le relevé passe toutes les 30 minutes. Rocket League : lance Oni Sync (Tracker RL) avant de jouer. Pour le rang et les stats avancées, clique « Sauvegarder le replay » en fin de partie : Oni Sync l’envoie tout seul.</p></details>
        <details><summary>Qui voit quoi ?</summary><p>Tu vois les rosters dont tu fais partie (le détail par rôle est juste au-dessus). L'encadrement et les administrateurs Discord voient tout. Le public ne voit que l'agenda des matchs officiels, jamais les scrims ni l'espace équipe.</p></details>
        <details><summary>Ma réponse sur le site apparaît-elle sur Discord ?</summary><p>Oui : le message de la séance sur Discord se met à jour dans la minute, et inversement.</p></details>
        <details><summary>Je veux une fonction en plus</summary><p>Dis-le au staff sur Discord : l'espace évolue avec le club.</p></details>
      </section>
    </div>
</Qg>

<style>
  .eq-mini { padding-block: 2.5rem 1.5rem; }
  .eq-mini h1 { font-size: clamp(2rem, 6vw, 3.5rem); }
  .gd { display: grid; gap: 2.5rem; max-width: 60rem; }
  .gd-fiche { display: grid; grid-template-columns: 11rem 1fr; gap: .4rem 1rem; margin: .75rem 0 .5rem; font-size: .9rem; }
  .gd-fiche dt { font-weight: 700; color: var(--muted); }
  .gd-fiche dd { margin: 0; }
  @media (max-width: 640px) { .gd-fiche { grid-template-columns: 1fr; } .gd-fiche dd { margin-bottom: .4rem; } }
  .gd-h { font-size: var(--step-1); padding-bottom: .5rem; border-bottom: 2px solid var(--ink); margin-bottom: 1rem; }
  .gd-steps { display: grid; gap: .5rem; counter-reset: s; }
  .gd-steps li { counter-increment: s; }
  .gd-steps a, .gd-steps div { display: grid; grid-template-columns: 2.5rem 1fr; grid-template-rows: auto auto; column-gap: .75rem; padding: .8rem 1rem; border: 1px solid var(--line); color: inherit; text-decoration: none; }
  .gd-steps a:hover { border-color: var(--ink); }
  .gd-steps a::before, .gd-steps div::before { content: counter(s); grid-row: span 2; font-family: var(--font-display); font-size: 1.6rem; color: var(--red-text); }
  .gd-steps span { color: var(--muted); font-size: .92rem; }
  .gd-tools { display: grid; gap: .1rem; margin: 0; }
  .gd-tools div { display: grid; grid-template-columns: minmax(10rem, 14rem) 1fr; gap: 1rem; padding: .7rem 0; border-bottom: 1px solid var(--line); }
  .gd-tools dt { font-weight: 700; }
  .gd-tools dd { margin: 0; color: var(--muted); }
  .gd-tools code { display: inline-block; margin-left: .5rem; font-size: .78rem; }
  .gd-faq details { padding: .7rem 0; border-bottom: 1px solid var(--line); }
  .gd-faq summary { cursor: pointer; font-weight: 700; }
  .gd-faq p { margin: .5rem 0 0; color: var(--muted); }
  @media (max-width: 600px) { .gd-tools div { grid-template-columns: 1fr; gap: .2rem; } }
</style>
