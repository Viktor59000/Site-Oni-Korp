---
// Espace Contenu d'Inside : pour le pôle contenu (casteurs, graphistes, monteurs, CM, créateurs, marketing) et l'encadrement.
// - Brief de match : chaque match public reçoit ses tâches (visuels, posts, rappel, clip) avec leurs échéances.
// - Calendrier éditorial : posts, visuels et vidéos hors match, ajoutés à la main.
// - Circuit : à faire → en cours (quelqu'un la prend) → à valider (livrable déposé) → fait (la direction valide et publie).
// Pas d'accès aux stratégies ni aux notes des rosters.
import Qg from './Qg.astro';
import { teamUser } from './outils';
import { rows } from '../db';
import { METRICS, NETWORKS, TASK_KINDS, ensureMatchTasks, renderTask } from './contenu-taches';
import { spark } from './ui';
import { TIERS_FR, valoTierFr } from './stats';
import { exec } from '../db';
import type { Task } from './contenu-taches';

export const prerender = false;
const t = await teamUser(Astro.cookies);
if (!t) return Astro.redirect('/equipe/planning/');
const { me, user } = t;
if (!(me.staff || me.content.length)) return Astro.redirect('/equipe/');
await ensureMatchTasks();

const now = Date.now(), DAY = 86400_000;
const back = '/equipe/contenu/';
const GAMES: Record<string, { label: string; color: string }> = {
  rl: { label: 'Rocket League', color: '#2f6bff' }, lol: { label: 'League of Legends', color: '#0f8a9b' },
  valo: { label: 'Valorant', color: '#ff4655' }, osu: { label: 'osu!', color: '#ff66aa' },
};
const fmt = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' });
const short = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' });
const when = (ms: number) => {
  const d = Number(ms) - now, h = Math.round(Math.abs(d) / 3600_000);
  const rel = Math.abs(d) < DAY ? `${h} h` : `${Math.round(Math.abs(d) / DAY)} j`;
  return `${short.format(new Date(Number(ms)))} · ${d < 0 ? `il y a ${rel}` : `dans ${rel}`}`;
};

type M = { id: number; opponent: string; at: number; kind: string | null; format: string | null; caster: string | null; caster_name: string | null; roster: string | null; game: string | null; score_us: number | null; score_them: number | null; link: string | null };
const matches = await rows<M>(
  `SELECT m.id, m.opponent, m.at, m.kind, m.format, m.caster, c.name AS caster_name, r.name AS roster, COALESCE(r.game, m.game) AS game, m.score_us, m.score_them, m.link
   FROM matches m LEFT JOIN rosters r ON r.id = m.roster_id LEFT JOIN guild_members c ON c.id = m.caster
   WHERE m.cancelled = 0 AND m.at > ? AND m.at < ? ORDER BY m.at`, now - 3 * DAY, now + 30 * DAY).catch(() => [] as M[]);
const tasks = await rows<Task>(
  `SELECT t.*, g.name AS assignee_name FROM content_tasks t LEFT JOIN guild_members g ON g.id = t.assignee
   WHERE t.status != 'fait' OR t.due > ? ORDER BY t.due`, now - 7 * DAY).catch(() => [] as Task[]);
const isPublic = (m: { kind: string | null }) => (m.kind ?? 'officiel') !== 'scrim';
const pub = matches.filter(isPublic), scrims = matches.filter((m) => !isPublic(m) && Number(m.at) > now);
const byMatch = (id: number) => tasks.filter((x) => x.match_id === id);
const mine = tasks.filter((x) => x.assignee === user.id && x.status !== 'fait');
const toValidate = me.staff ? tasks.filter((x) => x.status === 'a-valider') : [];
const calendar = tasks.filter((x) => !x.match_id);
const myRoles = new Set(me.content);
const late = (x: Task) => x.status !== 'fait' && x.status !== 'a-valider' && Number(x.due) < now;
const label = (x: Task) => x.title || TASK_KINDS[x.kind]?.label || x.kind;
const matchOf = (x: Task) => matches.find((m) => m.id === x.match_id);
// Mes contributions (07/10) : ce que j'ai livré et qui a été validé, avec les liens ; copiable comme portfolio
const contributions = await rows<Task>(`SELECT * FROM content_tasks WHERE assignee = ? AND status = 'fait' ORDER BY due DESC LIMIT 60`, user.id).catch(() => [] as Task[]);
const fmtDay = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/Paris' });
const portfolio = contributions.map((x) => `- ${fmtDay.format(new Date(Number(x.due)))} · ${label(x)}${x.url ? ` : ${x.url}` : ''}`).join(String.fromCharCode(10));

// Calendrier par semaine (lundi)
const weekOf = (ms: number) => { const d = new Date(Number(ms)); const day = (d.getDay() + 6) % 7; d.setHours(0, 0, 0, 0); d.setDate(d.getDate() - day); return d.getTime(); };
const weeks = [...new Set(calendar.map((x) => weekOf(x.due)))].sort().map((w) => ({ w, list: calendar.filter((x) => weekOf(x.due) === w) }));
const wfmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', timeZone: 'Europe/Paris' });
const today = new Date(now + 2 * DAY).toLocaleDateString('sv-SE', { timeZone: 'Europe/Paris' });

const ROLE_HINT: Record<string, string> = {
  Casteur: 'Les matchs publics sans casteur sont signalés : prends-en un depuis Discord avec le bouton « Je caste ».',
  Graphiste: 'Tes tâches : visuels d\'annonce et de résultat, plus les demandes du calendrier.',
  'Monteur vidéo': 'Tes tâches : les clips des matchs castés et les vidéos du calendrier.',
  'Community manager': 'Tes tâches : annonces, rappels et résultats, plus le calendrier éditorial.',
  'Créateur de contenu': 'Les matchs et les inhouses sont autant de moments à streamer sous les couleurs du club.',
  'Responsable marketing': 'Les matchs publics sont les moments à proposer aux partenaires (mention, logo sur le visuel).',
};
const hints = me.content.map((r) => ROLE_HINT[r]).filter(Boolean);
const err = Astro.url.searchParams.get('erreur');

// ---------- Fiche de cast (07/10) : ?cast=<match> ----------
// Ce qu'un casteur doit savoir avant l'antenne, uniquement des infos publiques (jamais les stratégies ni le scouting) :
// format, compo annoncée avec postes et rangs, historique contre l'adversaire, derniers résultats du roster.
const castId = Number(Astro.url.searchParams.get('cast')) || null;
const cast = castId ? await (async () => {
  const [m] = await rows<{ id: number; roster_id: number; opponent: string; at: number; format: string | null; kind: string | null; link: string | null; lineup: string | null; game: string | null; roster: string | null; caster_name: string | null }>(
    `SELECT m.id, m.roster_id, m.opponent, m.at, m.format, m.kind, m.link, m.lineup, COALESCE(r.game, m.game) AS game, r.name AS roster, c.name AS caster_name
     FROM matches m LEFT JOIN rosters r ON r.id = m.roster_id LEFT JOIN guild_members c ON c.id = m.caster WHERE m.id = ?`, castId);
  if (!m) return null;
  let lineup: { titulaires: { id: string; nom: string }[]; remplacant: { id: string; nom: string } | null; coach: { id: string; nom: string } | null } | null = null;
  try { lineup = m.lineup ? JSON.parse(m.lineup) : null; } catch {}
  const ids = (lineup?.titulaires ?? []).map((p) => p.id);
  const postes = new Map<string, string>((await rows<{ user_id: string; poste: string }>('SELECT user_id, poste FROM roster_postes WHERE roster_id = ?', m.roster_id).catch(() => [])).map((x) => [String(x.user_id), x.poste] as [string, string]));
  const accs = ids.length ? await rows<{ user_id: string; game: string; ident: string; region: string | null }>(`SELECT user_id, game, ident, region FROM accounts WHERE user_id IN (${ids.map(() => '?').join(',')})`, ...ids).catch(() => []) : [];
  const cacheGet = async (k: string) => { const [c] = await rows<{ value: string }>('SELECT value FROM stats_cache WHERE key = ?', k).catch(() => []); try { return c ? JSON.parse(c.value) : null; } catch { return null; } };
  const rankOf = async (uid: string) => {
    const riot = accs.find((a) => a.user_id === uid && a.game === 'riot'), osu = accs.find((a) => a.user_id === uid && a.game === 'osu');
    if (m.game === 'lol' && riot) { const r = await cacheGet(`lol:${riot.region ?? 'euw'}:${riot.ident.toLowerCase()}`); return r && r.tier !== 'UNRANKED' ? `${TIERS_FR[r.tier] ?? r.tier} ${r.rank ?? ''}`.trim() : null; }
    if (m.game === 'valo' && riot) { const r = await cacheGet(`valo:${riot.ident.toLowerCase()}`); return r?.tier ? valoTierFr(r.tier) : null; }
    if (m.game === 'osu' && osu) { const r = await cacheGet(`osu:${osu.ident.toLowerCase()}`); return r?.rank ? `#${Number(r.rank).toLocaleString('fr-FR')}` : null; }
    return null;
  };
  // Accord d'image de chacun : sans lui, pas de visuel ni de clip centré sur la personne
  const ok = new Set(ids.length ? (await rows<{ user_id: string }>(`SELECT user_id FROM consents WHERE image = 1 AND user_id IN (${ids.map(() => '?').join(',')})`, ...ids).catch(() => [])).map((x) => x.user_id) : []);
  const players = await Promise.all((lineup?.titulaires ?? []).map(async (p) => ({ nom: p.nom, poste: postes.get(p.id) ?? null, rang: await rankOf(p.id), image: ok.has(p.id) })));
  const norm = (x: string) => x.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '').replace(/[^a-z0-9]/g, '');
  const past = await rows<{ opponent: string; at: number; score_us: number; score_them: number; kind: string | null }>(
    'SELECT opponent, at, score_us, score_them, kind FROM matches WHERE roster_id = ? AND cancelled = 0 AND score_us IS NOT NULL ORDER BY at DESC LIMIT 30', m.roster_id);
  return { m, lineup, players, vs: past.filter((x) => norm(x.opponent) === norm(m.opponent)), last: past.filter((x) => (x.kind ?? 'officiel') !== 'scrim').slice(0, 5) };
})() : null;

// Indicateurs : dernière valeur, écart sur 30 jours et courbe
await exec('CREATE TABLE IF NOT EXISTS metrics (day TEXT, key TEXT, value REAL, source TEXT, PRIMARY KEY (day, key))').catch(() => {});
const since = new Date(now - 90 * DAY).toLocaleDateString('sv-SE', { timeZone: 'Europe/Paris' });
const mrows = await rows<{ day: string; key: string; value: number }>('SELECT day, key, value FROM metrics WHERE day >= ? ORDER BY day', since).catch(() => []);
const ago30 = new Date(now - 30 * DAY).toLocaleDateString('sv-SE', { timeZone: 'Europe/Paris' });
const indicators = Object.entries(METRICS).map(([key, m]) => {
  const serie = mrows.filter((r) => r.key === key);
  const last = serie.at(-1), base = [...serie].reverse().find((r) => r.day <= ago30) ?? serie[0];
  return { key, ...m, last, delta: last && base && base !== last ? Number(last.value) - Number(base.value) : null, sp: spark(serie.map((r) => Number(r.value)), { w: 100, h: 26 }) };
});
const dshort = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', timeZone: 'Europe/Paris' });
const todayIso = new Date(now).toLocaleDateString('sv-SE', { timeZone: 'Europe/Paris' });

// Chiffres du club, prêts à copier pour un partenaire ou le kit presse : seulement des valeurs relevées (jamais d'estimation)
const seasonStart = (() => { const d = new Date(now); const y = d.getUTCMonth() >= 8 ? d.getUTCFullYear() : d.getUTCFullYear() - 1; return Date.UTC(y, 8, 1); })();
const [season] = await rows<{ v: number; d: number; n: number }>(
  `SELECT SUM(score_us > score_them) AS v, SUM(score_us < score_them) AS d, COUNT(*) AS n FROM matches
   WHERE cancelled = 0 AND score_us IS NOT NULL AND COALESCE(kind, 'officiel') != 'scrim' AND at >= ?`, seasonStart).catch(() => [{ v: 0, d: 0, n: 0 }]);
const lastOf = (k: string) => indicators.find((x) => x.key === k)?.last;
const fmtN = (v: number) => Number(v).toLocaleString('fr-FR');
const facts = [
  'Club esport français fondé le 12 juillet 2021, sur Rocket League, League of Legends, Valorant et osu!.',
  lastOf('discord_membres') && `${fmtN(lastOf('discord_membres')!.value)} membres sur Discord (relevé du ${dshort.format(new Date(lastOf('discord_membres')!.day))}).`,
  lastOf('twitch_followers') && `${fmtN(lastOf('twitch_followers')!.value)} followers sur Twitch.`,
  ...['x_abonnes', 'instagram_abonnes', 'tiktok_abonnes', 'youtube_abonnes'].map((k) => lastOf(k) && `${fmtN(lastOf(k)!.value)} ${METRICS[k].label.toLowerCase()}.`),
  lastOf('inhouses_7j') && Number(lastOf('inhouses_7j')!.value) > 0 && `${fmtN(lastOf('inhouses_7j')!.value)} inhouses joués sur les 7 derniers jours.`,
  Number(season?.n ?? 0) > 0 && `Saison en cours : ${season.n} match${Number(season.n) > 1 ? 's' : ''} public${Number(season.n) > 1 ? 's' : ''}, ${season.v ?? 0} victoire${Number(season.v) > 1 ? 's' : ''}.`,
].filter(Boolean) as string[];

// Contexte du rendu des tâches (personne connectée)
const ctx = { user: user.id, staff: me.staff, roles: myRoles, back, now };
const row = (x: Task, withMatch = false) => renderTask(x, ctx, withMatch ? matchOf(x)?.opponent : undefined);
---
<Qg title="Contenu · Inside" heading="Contenu" lead="Ce qui arrive dans le club, ce qu'il faut produire autour, et qui s'en occupe." current="contenu" rosters={me.rosters} staff={me.staff || me.games.length > 0} contenu user={{ name: me.member?.name ?? user.name, avatar: me.member?.avatar ?? user.avatar }}>
  {cast && (
    <article class="ct-cast" style={`--g:${GAMES[cast.m.game ?? '']?.color ?? 'var(--line)'}`}>
      <p class="ct-cast__nav"><a class="ct-back" href="/equipe/contenu/">← Contenu</a> · <button type="button" class="ct-print" onclick="window.print()">Imprimer</button></p>
      <p class="ct-game">Fiche de cast · {GAMES[cast.m.game ?? '']?.label ?? 'Club'}{cast.m.roster ? ` · ${cast.m.roster}` : ''}</p>
      <h2>Oni Korp vs {cast.m.opponent}</h2>
      <p class="ct-when">{fmt.format(new Date(Number(cast.m.at)))}{cast.m.format ? ` · ${cast.m.format}` : ''}{cast.m.caster_name ? ` · cast : ${cast.m.caster_name}` : ''}{cast.m.link && <> · <a href={cast.m.link} rel="noopener" target="_blank">lien du live</a></>}</p>
      <div class="ct-cast__grid">
        <section>
          <h3>Notre compo</h3>
          {cast.players.length ? (
            <ul>{cast.players.map((p) => <li><strong>{p.nom}</strong>{p.poste && <span>{p.poste}</span>}{p.rang && <span>{p.rang}</span>}<span class:list={['ct-img', { 'is-no': !p.image }]}>{p.image ? 'image : accord' : 'image : pas d’accord'}</span></li>)}</ul>
          ) : <p class="eq-note">Compo pas encore annoncée (capitaine : Avant-match ou <code>/match compo</code>).</p>}
          {cast.lineup?.remplacant && <p class="eq-note">Remplaçant : {cast.lineup.remplacant.nom}{cast.lineup.coach ? ` · coach : ${cast.lineup.coach.nom}` : ''}</p>}
        </section>
        <section>
          <h3>Contre {cast.m.opponent}</h3>
          {cast.vs.length ? <ul>{cast.vs.map((x) => <li><strong>{x.score_us}-{x.score_them}</strong><span>{short.format(new Date(Number(x.at)))}{(x.kind ?? '') === 'scrim' ? ' · scrim' : ''}</span></li>)}</ul> : <p class="eq-note">Première rencontre entre les deux équipes.</p>}
        </section>
        <section>
          <h3>Nos 5 derniers matchs</h3>
          {cast.last.length ? <ul>{cast.last.map((x) => <li><strong class:list={{ 'is-win': x.score_us > x.score_them }}>{x.score_us}-{x.score_them}</strong><span>vs {x.opponent} · {short.format(new Date(Number(x.at)))}</span></li>)}</ul> : <p class="eq-note">Premier match officiel du roster.</p>}
        </section>
      </div>
    </article>
  )}
  <section class="ct">
    {me.content.length > 0 && <p class="ct-roles">Ton rôle : {me.content.join(', ')}. {hints.join(' ')}</p>}
    <p class="eq-note">Le circuit : <b>à faire</b> → quelqu'un la prend (<b>en cours</b>) → livrable déposé (<b>à valider</b>) → la direction valide et publie (<b>fait</b>). Rien n'est publié sans validation.</p>

    {(mine.length > 0 || toValidate.length > 0) && (
      <div class="ct-top">
        {mine.length > 0 && (
          <div><h2>Mes tâches <small>{mine.length}</small></h2><ul class="ct-tasks">{mine.map((x) => <Fragment set:html={row(x, true)} />)}</ul></div>
        )}
        {toValidate.length > 0 && (
          <div><h2>À valider <small>{toValidate.length}</small></h2><ul class="ct-tasks">{toValidate.map((x) => <Fragment set:html={row(x, true)} />)}</ul></div>
        )}
      </div>
    )}

    <h2>Matchs <small>publics, 30 jours</small></h2>
    {pub.length ? (
      <div class="ct-matches">
        {pub.map((m) => {
          const g = GAMES[m.game ?? ''];
          const played = m.score_us !== null;
          return (
            <article class="ct-match" style={`--g:${g?.color ?? 'var(--line)'}`}>
              <header>
                <span class="ct-game">{g?.label ?? 'Club'}{m.roster ? ` · ${m.roster}` : ''}</span>
                <strong>vs {m.opponent}{played ? ` · ${m.score_us}-${m.score_them}` : ''}</strong>
                <span class="ct-when">{fmt.format(new Date(Number(m.at)))}{m.format ? ` · ${m.format}` : ''}</span>
                <span class="ct-tags">
                  {played ? <em class:list={{ 'is-ok': Number(m.score_us) > Number(m.score_them) }}>{Number(m.score_us) > Number(m.score_them) ? 'Victoire' : Number(m.score_us) < Number(m.score_them) ? 'Défaite' : 'Égalité'}</em>
                    : <em class:list={{ 'is-warn': !m.caster }}>{m.caster ? `Casté par ${m.caster_name ?? 'un casteur'}` : 'Cherche casteur'}</em>}
                  {m.link && <a href={m.link} rel="noopener" target="_blank">Live</a>}
                  {!played && <a href={`/equipe/contenu/?cast=${m.id}`}>Fiche de cast</a>}
                </span>
              </header>
              <ul class="ct-tasks">{byMatch(m.id).map((x) => <Fragment set:html={row(x)} />)}</ul>
            </article>
          );
        })}
      </div>
    ) : <p class="eq-note">Aucun match public dans les 30 prochains jours. L'encadrement les ajoute sur Discord avec <code>/match ajouter</code> ; les tâches de contenu se créent toutes seules.</p>}
    {scrims.length > 0 && <p class="eq-note">Et {scrims.length} scrim{scrims.length > 1 ? 's' : ''} interne{scrims.length > 1 ? 's' : ''} à venir (rien à publier).</p>}

    {contributions.length > 0 && (
      <details class="ct-contrib">
        <summary><h2>Mes contributions <small>{contributions.length}</small></h2></summary>
        <ul>{contributions.map((x) => <li><time>{fmtDay.format(new Date(Number(x.due)))}</time><span>{label(x)}</span>{x.url && <a href={x.url} rel="noopener" target="_blank">voir</a>}</li>)}</ul>
        <button type="button" class="btn btn--ghost" data-portfolio={portfolio}>Copier la liste (portfolio)</button>
      </details>
    )}

    <h2>Calendrier éditorial <small>hors matchs</small></h2>
    {weeks.length ? weeks.map(({ w, list }) => (
      <div class="ct-week">
        <h3>Semaine du {wfmt.format(new Date(w))}</h3>
        <ul class="ct-tasks">{list.map((x) => <Fragment set:html={row(x)} />)}</ul>
      </div>
    )) : <p class="eq-note">Rien de prévu hors matchs. Ajoute un post, un visuel ou une vidéo ci-dessous.</p>}

    <details class="ct-add" open={err === 'tache' || undefined}>
      <summary>Ajouter au calendrier ou demander un visuel</summary>
      {err === 'tache' && <p class="ct-err">Il manque le titre ou la date.</p>}
      <form method="post" action="/api/equipe/outils">
        <input type="hidden" name="action" value="tache" /><input type="hidden" name="back" value={back} />
        <label>Type<select name="kind"><option value="post">Post</option><option value="visuel">Visuel</option><option value="video">Vidéo</option></select></label>
        <label class="ct-wide">Titre<input name="title" maxlength="120" required placeholder="Ex. : présentation du roster Valorant" /></label>
        <label>Jour<input type="date" name="jour" value={today} required /></label>
        <label>Heure<input type="time" name="heure" value="18:00" /></label>
        <fieldset><legend>Réseaux</legend>{NETWORKS.map((n) => <label class="ct-chk"><input type="checkbox" name="networks" value={n} />{n}</label>)}</fieldset>
        <label class="ct-full">Brief<textarea name="brief" rows="3" maxlength="1500" placeholder="Le message, le ton, les formats attendus, les liens utiles"></textarea></label>
        <button class="btn">Ajouter</button>
      </form>
    </details>

    <h2>Indicateurs <small>90 jours</small></h2>
    <ul class="ct-kpi">
      {indicators.map((x) => (
        <li>
          <span>{x.label}{!x.auto && <em title="Saisi à la main"> · manuel</em>}</span>
          <b>{x.last ? Number(x.last.value).toLocaleString('fr-FR') : '—'}</b>
          <small>{x.delta !== null ? `${x.delta >= 0 ? '+' : '−'}${Math.abs(x.delta).toLocaleString('fr-FR')} sur 30 j` : x.last ? `relevé le ${dshort.format(new Date(x.last.day))}` : x.auto ? 'premier relevé demain (Oni Bot)' : 'à saisir'}</small>
          <Fragment set:html={x.sp} />
        </li>
      ))}
    </ul>
    <div class="ct-facts">
      <h3>Chiffres du club <small>à copier pour un partenaire ou le kit presse</small></h3>
      <ul data-facts>{facts.map((f) => <li>{f}</li>)}</ul>
      <button type="button" class="btn btn--ghost" data-copy-facts>Copier</button>
      <p class="eq-note">Seulement des chiffres relevés : un chiffre manquant n'apparaît pas (saisis les abonnés de chaque réseau ci-dessous).</p>
    </div>
    <details class="ct-add">
      <summary>Saisir un chiffre (X, Instagram, TikTok, YouTube)</summary>
      <form method="post" action="/api/equipe/outils">
        <input type="hidden" name="action" value="metric" /><input type="hidden" name="back" value={back} />
        <label>Indicateur<select name="key">{Object.entries(METRICS).filter(([, m]) => !m.auto).map(([k, m]) => <option value={k}>{m.label}</option>)}</select></label>
        <label>Jour<input type="date" name="day" value={todayIso} required /></label>
        <label>Valeur<input type="number" name="value" min="0" step="1" required /></label>
        <button class="btn">Enregistrer</button>
      </form>
      <p class="eq-note">Une fois par semaine suffit (le lundi par exemple). Ces chiffres servent au bilan de saison et aux partenaires : seulement des chiffres réels.</p>
    </details>

    <p class="eq-note ct-foot">Charte éditoriale et kit de marque : <a href="/marque/">page Marque</a>. Les textes suivent la charte : 0 à 2 emojis, pas de tics d'IA.</p>
  </section>
</Qg>

<script>
  document.querySelector<HTMLButtonElement>('[data-portfolio]')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try { await navigator.clipboard.writeText(b.dataset.portfolio ?? ''); b.textContent = 'Copiée !'; } catch { b.textContent = 'Copie impossible'; }
    setTimeout(() => (b.textContent = 'Copier la liste (portfolio)'), 2000);
  });
</script>

<script is:inline>
  // Copier les chiffres du club en texte simple, une phrase par ligne
  document.addEventListener('click', async (e) => { const b = e.target.closest('[data-copy-facts]'); if (!b) return; const t = [...document.querySelectorAll('[data-facts] li')].map((li) => li.textContent).join(String.fromCharCode(10)); try { await navigator.clipboard.writeText(t); b.textContent = 'Copié'; setTimeout(() => (b.textContent = 'Copier'), 1500); } catch {} });
  // Le champ du lien du livrable n'apparaît qu'au clic sur « Livrer »
  document.addEventListener('click', (e) => { const b = e.target.closest('[data-livrer]'); if (!b) return; const f = b.closest('form'); const u = f.querySelector('input[name=url]'); if (u.hidden) { e.preventDefault(); u.hidden = false; u.focus(); } });
</script>

