---
// Setups : réglages et matériel de chaque joueur, par jeu. Pratique pour comparer, dépanner, ou copier le viseur d'un coéquipier.
import Qg from './Qg.astro';
import { scope, teamUser } from './outils';
import { rows } from '../db';

export const prerender = false;
const t = await teamUser(Astro.cookies);
if (!t) return Astro.redirect('/equipe/');
const { me, user } = t;
const sc = scope(me.rosters, Astro.url, Astro.cookies);
const back = `/equipe/setup/${sc.active ? `?r=${sc.active}` : ''}`;

type F = { key: string; label: string; type?: 'number' | 'url' | 'text'; wide?: boolean; hint?: string };
const COMMON: F[] = [
  { key: 'souris', label: 'Souris' }, { key: 'clavier', label: 'Clavier' }, { key: 'casque', label: 'Casque / micro' },
  { key: 'ecran', label: 'Écran (Hz)' }, { key: 'resolution', label: 'Résolution' },
];
const FIELDS: Record<string, F[]> = {
  valo: [
    { key: 'dpi', label: 'DPI', type: 'number' }, { key: 'sens', label: 'Sensibilité', type: 'number' }, { key: 'scope', label: 'Sensi. lunette', type: 'number' },
    { key: 'viseur', label: 'Code du viseur', wide: true, hint: 'Paramètres → Viseur → Importer / exporter le profil' }, ...COMMON,
  ],
  lol: [{ key: 'dpi', label: 'DPI', type: 'number' }, { key: 'sens', label: 'Sensibilité souris', type: 'number' }, { key: 'camera', label: 'Caméra (verrouillée ?)' }, { key: 'smartcast', label: 'Smart cast' }, ...COMMON],
  rl: [
    { key: 'controle', label: 'Manette / clavier' }, { key: 'fov', label: 'FOV', type: 'number' }, { key: 'distance', label: 'Distance', type: 'number' }, { key: 'hauteur', label: 'Hauteur', type: 'number' },
    { key: 'angle', label: 'Angle', type: 'number' }, { key: 'stiffness', label: 'Rigidité', type: 'number' }, { key: 'swivel', label: 'Vitesse de pivot', type: 'number' }, { key: 'transition', label: 'Transition', type: 'number' },
    { key: 'deadzone', label: 'Zone morte', type: 'number' }, { key: 'dodge', label: 'Zone morte esquive', type: 'number' }, { key: 'sensi', label: 'Sensibilité direction', type: 'number' },
    { key: 'binds', label: 'Touches particulières', wide: true }, { key: 'ecran', label: 'Écran (Hz)' },
  ],
  osu: [
    { key: 'tablette', label: 'Tablette' }, { key: 'zone', label: 'Zone (L × H mm)' }, { key: 'position', label: 'Position (X, Y)' },
    { key: 'osurea', label: 'Lien Osurea de ma zone', type: 'url', wide: true, hint: 'Règle ta zone sur osurea.yuzuctus.fr puis colle le lien partagé' },
    { key: 'touches', label: 'Touches' }, { key: 'clavier', label: 'Clavier' }, { key: 'skin', label: 'Skin (nom ou lien)', wide: true, hint: 'Les skins de Yuzuctus : skins.yuzuctus.fr' },
    { key: 'ecran', label: 'Écran (Hz)' },
  ],
};
const GAME_LABEL: Record<string, string> = { rl: 'Rocket League', lol: 'League of Legends', valo: 'Valorant', osu: 'osu!' };
const games = [...new Set(sc.list.map((r) => r.game))].filter((g) => FIELDS[g]);
const blocks = await Promise.all(games.map(async (g) => {
  const roleIds = sc.list.filter((r) => r.game === g).map((r) => r.role_id);
  const members = roleIds.length ? await rows<{ id: string; name: string; avatar: string }>(`SELECT id, name, avatar FROM guild_members WHERE ${roleIds.map(() => 'roles LIKE ?').join(' OR ')} ORDER BY name`, ...roleIds.map((id) => `%"${id}"%`)) : [];
  const setups = members.length ? await rows<{ user_id: string; data: string }>(`SELECT user_id, data FROM setups WHERE game = ? AND user_id IN (${members.map(() => '?').join(',')})`, g, ...members.map((m) => m.id)) : [];
  const of = (id: string) => JSON.parse(setups.find((s) => s.user_id === id)?.data ?? '{}');
  return { g, members, of, mine: of(user.id), inRoster: members.some((m) => m.id === user.id) };
}));
const edpi = (d: Record<string, string>) => (Number(d.dpi) && Number(d.sens) ? Math.round(Number(d.dpi) * Number(d.sens)) : null);
---
<Qg title="Setups · Inside" heading="Setups" lead="Réglages et matériel de chacun : pour comparer, dépanner, ou copier un viseur." current="setup" rosters={me.rosters} staff={me.staff || me.games.length > 0} contenu={me.staff || me.content.length > 0} active={sc.active} user={{ name: t.me.member?.name ?? t.user.name, avatar: t.me.member?.avatar ?? t.user.avatar }}>
    <div class="su">
      {!blocks.length && <p class="eq-note">Aucun roster pour l'instant.</p>}
      {blocks.map((b) => (
        <section>
          <h2 class="su-h">{GAME_LABEL[b.g]}</h2>
          {(b.inRoster || me.staff) && (
            <details class="su-edit" open={b.inRoster && !Object.keys(b.mine).length}>
              <summary>{Object.keys(b.mine).length ? 'Modifier mon setup' : 'Remplir mon setup'}</summary>
              <form method="post" action="/api/equipe/outils">
                <input type="hidden" name="action" value="setup" /><input type="hidden" name="game" value={b.g} /><input type="hidden" name="back" value={back} />
                {FIELDS[b.g].map((f) => (
                  <label class:list={{ 'su-wide': f.wide }}>{f.label}{f.hint && <small>{f.hint}</small>}
                    <input name={f.key} type={f.type === 'number' ? 'text' : f.type ?? 'text'} inputmode={f.type === 'number' ? 'decimal' : undefined} maxlength="200" value={b.mine[f.key] ?? ''} />
                  </label>
                ))}
                <button class="btn">Enregistrer</button>
              </form>
            </details>
          )}
          {b.g === 'valo' && (
            <details class="su-vc" data-vc>
              <summary>Bibliothèque de viseurs <small>VCRDB, plus de 14 000 viseurs de pros et de la communauté</small></summary>
              <div class="su-vc__bar">
                <input type="search" placeholder="Chercher un viseur ou un pro (TenZ, Demon1…)" aria-label="Chercher un viseur" data-vc-q />
                <div class="su-vc__seg" role="group" aria-label="Filtre">
                  <button type="button" data-vc-tag="" aria-pressed="true">Tous</button><button type="button" data-vc-tag="team" aria-pressed="false">Pros</button><button type="button" data-vc-tag="fun" aria-pressed="false">Fun</button>
                </div>
                <div class="su-vc__seg" role="group" aria-label="Tri">
                  <button type="button" data-vc-sort="semaine" aria-pressed="true">Cette semaine</button><button type="button" data-vc-sort="total" aria-pressed="false">De tous les temps</button>
                </div>
              </div>
              <ul class="su-vc__grid" data-vc-grid><li class="eq-note">Chargement…</li></ul>
              <p class="eq-note">Viseurs de <a href="https://www.vcrdb.net/" rel="noopener" target="_blank">VCRDB</a> (Valorant Crosshair Database), avec leur accord. « Mettre dans mon setup » remplit le champ, il reste à enregistrer.</p>
            </details>
          )}
          <div class="su-grid">
            {b.members.map((m) => {
              const d = b.of(m.id);
              const filled = FIELDS[b.g].filter((f) => d[f.key]);
              return (
                <article class="su-card">
                  <p class="su-who">{m.avatar && <img src={m.avatar} alt="" width="30" height="30" loading="lazy" crossorigin="anonymous" referrerpolicy="no-referrer" />}<strong>{m.name}</strong></p>
                  {b.g === 'valo' && edpi(d) && <p class="su-big"><b>{edpi(d)}</b> eDPI</p>}
                  {filled.length ? (
                    <dl>
                      {filled.map((f) => (
                        <div class:list={{ 'su-wide': f.wide }}>
                          <dt>{f.label}</dt>
                          <dd>
                            {f.key === 'viseur' ? <><canvas class="su-xh" width="192" height="108" data-xh={d[f.key]} aria-label="Aperçu du viseur"></canvas><code>{d[f.key]}</code><button type="button" class="su-copy" data-copy={d[f.key]}>Copier</button></>
                              : /^https?:\/\//.test(d[f.key]) ? <a href={d[f.key]} rel="noopener" target="_blank">{f.key === 'osurea' ? 'Voir ma zone' : 'Ouvrir'}</a> : d[f.key]}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  ) : <p class="eq-note">Pas encore rempli.</p>}
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
</Qg>

<script>
  import { parseCrosshair, drawCrosshair } from '../../lib/crosshair';
  // Aperçu de chaque viseur Valorant, sur un fond de carte
  document.querySelectorAll<HTMLCanvasElement>('[data-xh]').forEach((cv) => { const x = parseCrosshair(cv.dataset.xh ?? ''); if (x) drawCrosshair(cv, x, 2.5); else cv.hidden = true; });
  // Bibliothèque VCRDB : recherche, filtres, aperçu, copier ou mettre dans mon setup
  const vc = document.querySelector<HTMLDetailsElement>('[data-vc]');
  if (vc) {
    const grid = vc.querySelector<HTMLElement>('[data-vc-grid]')!;
    const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    let tag = '', sort = 'semaine', tok = 0, timer = 0;
    const load = async () => {
      const t = ++tok, q = vc.querySelector<HTMLInputElement>('[data-vc-q]')!.value.trim();
      const d = await fetch(`/api/equipe/outils?type=vc&q=${encodeURIComponent(q)}&tag=${tag}&sort=${sort}`).then((r) => (r.ok ? r.json() : null)).catch(() => null);
      if (t !== tok) return;
      if (!d) { grid.innerHTML = '<li class="eq-note">VCRDB ne répond pas pour le moment.</li>'; return; }
      grid.innerHTML = d.list.length ? d.list.map((x: { id: number; name: string; code: string; team: boolean; copied: number; weekly: number }) => `<li>
        <canvas width="192" height="108" data-vc-xh="${esc(x.code)}" aria-label="Aperçu du viseur ${esc(x.name)}"></canvas>
        <strong>${esc(x.name)}${x.team ? ' <em>pro</em>' : ''}</strong>
        <small>${x.weekly.toLocaleString('fr-FR')} copies cette semaine · ${x.copied.toLocaleString('fr-FR')} au total</small>
        <span><button type="button" class="su-copy" data-copy="${esc(x.code)}">Copier</button><button type="button" class="su-copy" data-vc-use="${esc(x.code)}">Mettre dans mon setup</button><a href="https://www.vcrdb.net/crosshair/${x.id}" rel="noopener" target="_blank">VCRDB</a></span>
      </li>`).join('') : '<li class="eq-note">Aucun viseur trouvé.</li>';
      grid.querySelectorAll<HTMLCanvasElement>('[data-vc-xh]').forEach((cv) => { const x = parseCrosshair(cv.dataset.vcXh ?? ''); if (x) drawCrosshair(cv, x, 2.5); });
    };
    vc.addEventListener('toggle', () => { if (vc.open && grid.querySelector('.eq-note')) load(); });
    vc.querySelector('[data-vc-q]')!.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(load, 300); });
    vc.addEventListener('click', (e) => {
      const el = e.target as HTMLElement;
      const tb = el.closest<HTMLElement>('[data-vc-tag]'), sb = el.closest<HTMLElement>('[data-vc-sort]'), use = el.closest<HTMLElement>('[data-vc-use]');
      if (tb) { tag = tb.dataset.vcTag!; vc.querySelectorAll('[data-vc-tag]').forEach((b) => b.setAttribute('aria-pressed', String(b === tb))); load(); }
      if (sb) { sort = sb.dataset.vcSort!; vc.querySelectorAll('[data-vc-sort]').forEach((b) => b.setAttribute('aria-pressed', String(b === sb))); load(); }
      if (use) {
        const form = vc.closest('section')?.querySelector<HTMLDetailsElement>('.su-edit'); const input = form?.querySelector<HTMLInputElement>('input[name="viseur"]');
        if (form && input) { form.open = true; input.value = use.dataset.vcUse!; input.focus(); input.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
      }
    });
  }
  document.addEventListener('click', async (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-copy]'); if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copié !'; setTimeout(() => (b.textContent = 'Copier'), 1500); } catch {}
  });
</script>

<style>
  .su-vc { margin-bottom: 1.25rem; padding: .75rem 1rem; border: 1px solid var(--line); }
  .su-vc summary { cursor: pointer; font-weight: 700; }
  .su-vc summary small { margin-left: .4rem; font-weight: 400; color: var(--muted); }
  .su-vc__bar { display: flex; flex-wrap: wrap; gap: .6rem 1rem; align-items: center; margin: .9rem 0; }
  .su-vc__bar input { flex: 1 1 16rem; min-height: 38px; padding: .35rem .6rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: 400 .9rem var(--font-body); }
  .su-vc__seg { display: flex; border: 1px solid var(--line); }
  .su-vc__seg button { padding: .35rem .7rem; border: 0; background: none; color: var(--muted); font: 700 .8rem var(--font-body); cursor: pointer; }
  .su-vc__seg button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
  .su-vc__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); gap: .8rem; margin: 0 0 .8rem; padding: 0; list-style: none; }
  .su-vc__grid :global(li) { display: grid; gap: .3rem; align-content: start; padding: .6rem; border: 1px solid var(--line); transition: border-color .15s; }
  .su-vc__grid :global(li:hover) { border-color: var(--ink); }
  .su-vc__grid :global(canvas) { width: 100%; aspect-ratio: 16 / 9; height: auto; background: #6d7a76 url('https://media.valorant-api.com/maps/7eaecc1b-4337-bbf6-6ab9-04b8f06b3319/splash.png') center / cover; }
  .su-vc__grid :global(strong) { font-size: .9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .su-vc__grid :global(em) { padding: 0 .3rem; border: 1px solid #ff4655; color: #ff4655; font-style: normal; font-size: .65rem; vertical-align: middle; }
  .su-vc__grid :global(small) { color: var(--muted); font-size: .72rem; }
  .su-vc__grid :global(span) { display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; }
  .su-vc__grid :global(.su-copy) { min-height: 30px; padding: 0 .6rem; border: 1.5px solid var(--line); background: none; color: var(--ink); font: 700 .75rem var(--font-body); cursor: pointer; }
  .su-vc__grid :global(span a) { font-size: .75rem; color: var(--red-text); }
  .su-xh { display: block; width: 100%; max-width: 16rem; aspect-ratio: 16 / 9; height: auto; margin-bottom: .4rem; background: #6d7a76 url('https://media.valorant-api.com/maps/7eaecc1b-4337-bbf6-6ab9-04b8f06b3319/splash.png') center / cover; border: 1px solid var(--line); }
  .eq-mini { padding-block: 2.5rem 1.5rem; }
  .eq-mini h1 { font-size: clamp(2rem, 6vw, 3.5rem); }
  .eq-note { color: var(--muted); font-size: var(--step--1); }
  .su { display: grid; gap: 3rem; }
  .su-h { font-size: var(--step-1); padding-bottom: .5rem; border-bottom: 2px solid var(--ink); margin-bottom: 1rem; }
  .su-edit { margin-bottom: 1.25rem; }
  .su-edit summary { cursor: pointer; font-weight: 700; color: var(--red-text); }
  .su-edit form { display: grid; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: .8rem; margin-top: .8rem; padding: 1rem; border: 1px solid var(--line); align-items: end; }
  .su-edit label { display: grid; gap: .25rem; font-weight: 700; font-size: .8rem; }
  .su-edit small { font-weight: 400; color: var(--muted); font-size: .72rem; }
  .su-edit .su-wide { grid-column: span 2; }
  .su-edit input { width: 100%; box-sizing: border-box; min-height: 38px; padding: .35rem .55rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: 400 .92rem var(--font-body); }
  .su-edit .btn { justify-self: start; }
  .su-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 1rem; }
  .su-card { padding: 1rem; border: 1px solid var(--line); display: grid; gap: .6rem; align-content: start; }
  .su-who { display: flex; align-items: center; gap: .5rem; margin: 0; }
  .su-who img { border-radius: 50%; background: var(--line); }
  .su-big { margin: 0; color: var(--muted); } .su-big b { font-family: var(--font-display); font-size: 1.6rem; color: var(--ink); }
  .su-card dl { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem .8rem; margin: 0; }
  .su-card dl div { min-width: 0; }
  .su-card .su-wide { grid-column: 1 / -1; }
  .su-card dt { font-size: .7rem; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .su-card dd { margin: 0; font-weight: 700; font-size: .9rem; overflow-wrap: anywhere; }
  .su-card code { font-size: .72rem; font-weight: 400; display: block; margin-bottom: .3rem; }
  .su-copy { min-height: 30px; padding: 0 .6rem; border: 1.5px solid var(--line); background: none; color: var(--ink); font: 700 .75rem var(--font-body); cursor: pointer; }
  .su-card a { color: var(--red-text); }
  @media (max-width: 600px) { .su-edit .su-wide { grid-column: auto; } }
</style>
