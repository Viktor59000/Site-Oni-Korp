---
// Drafter League of Legends : ordre de draft de tournoi, mode fearless (séries), drafts sauvegardés pour le roster,
// préparation (rôle, note et variantes par pick, bans proposés, plan de jeu), lecture des compos (données Riot) et
// suggestions tirées des parties classées de nos joueurs,
// op.gg multi de notre équipe et de l'adversaire. Champions et icônes : Data Dragon (Riot), à jour automatiquement.
import Qg from './Qg.astro';
import { rosterMembers, scope, teamUser } from './outils';
import { rows } from '../db';
import { links } from './stats';

export const prerender = false;
const t = await teamUser(Astro.cookies);
if (!t) return Astro.redirect('/equipe/');
const { me } = t;
const sc = scope(me.rosters, Astro.url);
const lolRosters = sc.list.filter((r) => r.game === 'lol' || (me.staff && !sc.active));
const rosterIds = me.rosters.filter((r) => r.game === 'lol').map((r) => r.role_id);
// Riot ID de nos joueurs LoL → op.gg multi
const ours = rosterIds.length ? await rows<{ ident: string; region: string }>(`SELECT a.ident, a.region FROM accounts a JOIN guild_members g ON g.id = a.user_id
  WHERE a.game = 'riot' AND (${rosterIds.map(() => 'g.roles LIKE ?').join(' OR ')})`, ...rosterIds.map((id) => `%"${id}"%`)) : [];
const oursMulti = ours.length ? links.opggMulti(ours.map((o) => o.ident), ours[0].region ?? 'euw') : null;
const games = [...new Set(me.rosters.map((r) => r.game))];
type PoolPlayer = { name: string; poste: string | null; champs: Record<string, { g: number; w: number; vs: Record<string, [number, number]> }> };
// Nos résultats quand tel champion est en face (toutes nos parties, tous joueurs)
const faced: Record<string, [number, number]> = {};
const pool: PoolPlayer[] = [];
for (const r of lolRosters) {
  const members = await rosterMembers(r.role_id);
  const postes = new Map<string, string>((await rows<{ user_id: string; poste: string }>('SELECT user_id, poste FROM roster_postes WHERE roster_id = ?', r.id).catch(() => [])).map((x) => [String(x.user_id), x.poste] as [string, string]));
  for (const m of members) {
    if (pool.some((p) => p.name === m.name)) continue;
    const perfs = await rows<{ data: string }>(`SELECT data FROM perf WHERE user_id = ? AND game = 'lol' AND at > ?`, m.id, Date.now() - 90 * 86400_000).catch(() => []);
    const champs: PoolPlayer['champs'] = {};
    for (const p of perfs) {
      try {
        const d = JSON.parse(p.data); if (!d.champ) continue;
        const c = (champs[d.champ] ??= { g: 0, w: 0, vs: {} }); c.g++; if (d.win) c.w++;
        if (d.vs) { const v = (c.vs[d.vs] ??= [0, 0]); v[0]++; if (d.win) v[1]++; }
        for (const e of d.enemies ?? []) { const f = (faced[e] ??= [0, 0]); f[0]++; if (d.win) f[1]++; }
      } catch {}
    }
    pool.push({ name: m.name, poste: postes.get(m.id) ?? null, champs });
  }
}
---
<Qg title="Drafter LoL · Inside" heading="Drafter LoL" lead="Prépare tes drafts dans l'ordre de tournoi, garde-les pour le roster, joue en fearless." current="lol" rosters={me.rosters} staff={me.staff || me.games.length > 0} contenu={me.staff || me.content.length > 0} active={sc.active} user={{ name: t.me.member?.name ?? t.user.name, avatar: t.me.member?.avatar ?? t.user.avatar }}>
  <section class="dr" data-drafter data-rosters={JSON.stringify(lolRosters.map((r) => ({ id: r.id, name: r.name })))} data-pool={JSON.stringify(pool)} data-faced={JSON.stringify(faced)}>
    <div>
      <div class="dr-top">
        <p class="dr-step" data-step aria-live="polite">Chargement des champions…</p>
        <div class="dr-actions">
          <div class="dr-seg" role="group" aria-label="Notre côté"><span>Notre côté</span><button type="button" data-ours="blue" aria-pressed="true">Bleu</button><button type="button" data-ours="red" aria-pressed="false">Rouge</button></div>
          <div class="dr-seg" role="group" aria-label="Un clic sur un champion"><span>Un clic</span><button type="button" data-mode="draft" aria-pressed="true">Draft</button><button type="button" data-mode="plan" aria-pressed="false">Ban proposé</button><button type="button" data-mode="variant" aria-pressed="false" disabled>Variante</button></div>
          <button type="button" class="dr-btn" data-undo>Annuler</button>
          <button type="button" class="dr-btn" data-next-game title="Les champions joués sont bloqués pour la partie suivante">Partie suivante (fearless)</button>
          <button type="button" class="dr-btn" data-reset>Tout effacer</button>
        </div>
      </div>

      <div class="dr-board">
        <div class="dr-side is-blue">
          <h2>Bleu</h2>
          <ol class="dr-bans" data-bans="blue"><li></li><li></li><li></li><li></li><li></li></ol>
          <ol class="dr-picks" data-picks="blue"><li><span class="dr-empty">B1</span></li><li><span class="dr-empty">B2</span></li><li><span class="dr-empty">B3</span></li><li><span class="dr-empty">B4</span></li><li><span class="dr-empty">B5</span></li></ol>
        </div>
        <div class="dr-pool">
          <div class="dr-filters">
            <input type="search" placeholder="Chercher un champion" aria-label="Chercher un champion" data-search />
            <!-- Écrits ici (et non par le script) pour que la grille ne bouge pas au chargement -->
            <div class="dr-tags" data-tags><button type="button" aria-pressed="true" data-tag="">Tous</button><button type="button" aria-pressed="false" data-tag="Fighter">Combattant</button><button type="button" aria-pressed="false" data-tag="Tank">Tank</button><button type="button" aria-pressed="false" data-tag="Mage">Mage</button><button type="button" aria-pressed="false" data-tag="Assassin">Assassin</button><button type="button" aria-pressed="false" data-tag="Marksman">Tireur</button><button type="button" aria-pressed="false" data-tag="Support">Support</button></div>
          </div>
          <p class="dr-locked" data-locked hidden></p>
          <ul class="dr-grid" data-grid></ul>
        </div>
        <div class="dr-side is-red">
          <h2>Rouge</h2>
          <ol class="dr-bans" data-bans="red"><li></li><li></li><li></li><li></li><li></li></ol>
          <ol class="dr-picks" data-picks="red"><li><span class="dr-empty">R1</span></li><li><span class="dr-empty">R2</span></li><li><span class="dr-empty">R3</span></li><li><span class="dr-empty">R4</span></li><li><span class="dr-empty">R5</span></li></ol>
        </div>
      </div>

      <div class="dr-prep">
        <section class="dr-slot" data-slot-panel>
          <h3>Préparation du pick</h3>
          <p class="eq-note" data-slot-empty>Clique sur un de nos picks (colonne de notre côté) pour lui donner un rôle, une note et des variantes selon la situation.</p>
          <div data-slot-body hidden>
            <p class="dr-slot__title" data-slot-title></p>
            <label>Rôle<select data-slot-role><option value="">—</option><option>Top</option><option>Jungle</option><option>Mid</option><option>ADC</option><option>Support</option></select></label>
            <div><p class="dr-label">Variantes <small>(si le champion est banni, pris ou mauvais dans le matchup ; passe en mode « Variante » puis clique dans la liste)</small></p><ul class="dr-chips" data-slot-variants></ul></div>
            <label>Note<textarea rows="3" maxlength="400" data-slot-note placeholder="Ex. : seulement si leur jungle est un engage ; sinon Sejuani"></textarea></label>
          </div>
        </section>
        <section class="dr-plan">
          <h3>Bans proposés <small>mode « Ban proposé »</small></h3>
          <ul class="dr-chips" data-plan-bans><li class="eq-note">Aucun pour l'instant.</li></ul>
          <label>Plan de jeu<textarea rows="4" maxlength="1500" data-plan-notes placeholder="Conditions de victoire, priorités, ce qu'on cherche à contester…"></textarea></label>
        </section>
      </div>

      <section class="dr-read" aria-labelledby="dr-read-title">
        <h3 id="dr-read-title">Lecture des compos</h3>
        <p class="eq-note">Calculée sur les données officielles des champions (Riot) et sur les parties classées de nos joueurs relevées par Oni Bot (90 jours) : qui maîtrise quoi, nos matchups directs, notre bilan face à chaque champion.</p>
        <div class="dr-read__grid"><div data-read="blue"></div><div data-read="red"></div></div>
        <div class="dr-ll" data-ll></div>
        <div class="dr-suggest" data-suggest></div>
      </section>

      <div class="dr-bottom">
        <form class="dr-save" method="post" action="/api/equipe/outils" data-save>
          <h3>Garder ce draft</h3>
          <input type="hidden" name="action" value="draft" /><input type="hidden" name="back" value={`/equipe/lol/${sc.active ? `?r=${sc.active}` : ''}`} /><input type="hidden" name="data" data-json />
          <label>Titre<input name="title" maxlength="80" placeholder="Ex. : vs Team X, game 2, compo engage" required /></label>
          <label>Roster<select name="roster" data-roster-select>{lolRosters.map((r) => <option value={r.id}>{r.name}</option>)}</select></label>
          <button class="btn" disabled={!lolRosters.length}>Enregistrer</button>
          {!lolRosters.length && <p class="eq-note">Aucun roster LoL pour l'instant : le draft reste utilisable, sans sauvegarde.</p>}
        </form>
        <div class="dr-scout">
          <h3>Scouting</h3>
          {oursMulti ? <a class="btn btn--ghost" href={oursMulti} rel="noopener">op.gg de notre roster</a> : <p class="eq-note">Les joueurs relient leur Riot ID dans <a href="/equipe/joueurs/">Joueurs</a> pour l'op.gg du roster.</p>}
          <label>Adversaires (Riot ID, un par ligne)<textarea rows="5" data-opp placeholder="Pseudo#EUW"></textarea></label>
          <button type="button" class="btn btn--ghost" data-opp-go>op.gg multi de l'adversaire</button>
        </div>
        <div class="dr-saved">
          <h3>Drafts du roster</h3>
          <ul data-saved><li class="eq-note">{lolRosters.length ? 'Chargement…' : 'Aucun.'}</li></ul>
        </div>
      </div>
    </div>
  </section>
</Qg>

<script src="./lol.client.ts"></script>

<style>
  .eq-mini { padding-block: 2.5rem 1.5rem; }
  .eq-mini h1 { font-size: clamp(2rem, 6vw, 3.5rem); }
  .eq-note { color: var(--muted); font-size: var(--step--1); }
  .dr { padding-top: 2rem; }
  .dr-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .dr-step { font-family: var(--font-display); font-size: var(--step-1); margin: 0; }
  .dr-actions { display: flex; flex-wrap: wrap; gap: .5rem; }
  .dr-btn { min-height: 40px; padding: 0 .9rem; border: 1.5px solid var(--line); background: none; color: var(--ink); font: 700 .85rem var(--font-body); cursor: pointer; }
  .dr-btn:hover { border-color: var(--ink); }
  .dr-board { display: grid; grid-template-columns: 12rem 1fr 12rem; gap: 1.25rem; align-items: start; }
  .dr-side h2 { font-family: var(--font-body); font-size: .9rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; padding: .4rem .6rem; color: #fff; }
  .is-blue h2 { background: #1f5fd1; } .is-red h2 { background: #c8282d; }
  .dr-bans { display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; margin: .5rem 0; }
  .dr-bans :global(li) { aspect-ratio: 1; background: var(--line); position: relative; overflow: hidden; }
  .dr-bans :global(img) { width: 100%; height: 100%; filter: grayscale(1); opacity: .75; }
  .dr-bans :global(li::after) { content: ''; position: absolute; inset: 0; background: linear-gradient(to top right, transparent 47%, var(--lacquer) 48%, var(--lacquer) 52%, transparent 53%); opacity: 0; }
  .dr-bans :global(li:has(img)::after) { opacity: .8; }
  .dr-picks { display: grid; gap: 4px; }
  .dr-picks :global(li) { display: flex; align-items: center; gap: .6rem; min-height: 60px; padding: 2px; border: 1.5px solid var(--line); font-weight: 700; font-size: .9rem; }
  .dr-picks :global(img) { width: 56px; height: 56px; }
  .dr-picks :global(.dr-empty) { padding-left: .6rem; color: var(--muted); }
  .dr :global(.is-active) { outline: 3px solid var(--lacquer); outline-offset: -3px; }
  @media (prefers-reduced-motion: no-preference) { .dr :global(.is-active) { animation: dr-pulse 1.2s ease-in-out infinite; } @keyframes dr-pulse { 50% { outline-color: transparent; } } }
  .dr-filters { display: grid; gap: .5rem; margin-bottom: .6rem; }
  .dr-filters input { min-height: 44px; padding: 0 .75rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: inherit; }
  .dr-tags { display: flex; flex-wrap: wrap; gap: .3rem; }
  .dr-tags :global(button) { padding: .35rem .7rem; border: 1.5px solid var(--line); background: none; color: var(--ink); font: 700 .78rem var(--font-body); cursor: pointer; }
  .dr-tags :global(button[aria-pressed="true"]) { background: var(--ink); color: var(--surface); border-color: var(--ink); }
  .dr-locked { font-size: var(--step--1); color: var(--red-text); font-weight: 700; margin: 0 0 .5rem; }
  .dr-locked[hidden] { display: none; }
  .dr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 6px; height: 32rem; align-content: start; overflow-y: auto; padding-right: 4px; }
  .dr-grid :global(button) { display: grid; justify-items: center; gap: 2px; width: 100%; padding: 0; border: 0; background: none; color: var(--ink); cursor: pointer; font: 400 .75rem var(--font-body); }
  .dr-grid :global(img) { width: 48px; height: 48px; border: 2px solid transparent; }
  .dr-grid :global(button:hover img) { border-color: var(--lacquer); }
  .dr-grid :global(button:disabled) { opacity: .25; cursor: default; }
  .dr-grid :global(span) { max-width: 64px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dr-seg { display: inline-flex; align-items: center; border: 1.5px solid var(--line); }
  .dr-seg span { padding: 0 .55rem; font-size: .75rem; color: var(--muted); }
  .dr-seg button { min-height: 36px; padding: 0 .7rem; border: 0; border-left: 1px solid var(--line); background: none; color: var(--ink); font: 700 .8rem var(--font-body); cursor: pointer; }
  .dr-seg button[aria-pressed="true"] { background: var(--ink); color: var(--surface, #111); }
  .dr-seg button:disabled { opacity: .35; cursor: default; }
  .dr-picks :global(li.is-mine > button) { display: flex; align-items: center; gap: .6rem; width: 100%; min-height: 56px; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .dr-picks :global(li.is-mine:hover) { border-color: var(--ink); }
  .dr-picks :global(li.is-slot) { border-color: var(--lacquer); box-shadow: inset 4px 0 0 var(--lacquer); }
  .dr-picks :global(span em) { display: block; font-style: normal; font-weight: 400; font-size: .75rem; color: var(--muted); }
  .dr-picks :global(span small) { display: block; font-weight: 400; font-size: .72rem; color: var(--red-text); }
  .dr-prep { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  .dr-prep h3, .dr-read h3 { font-family: var(--font-body); font-weight: 700; font-size: 1rem; margin-bottom: .6rem; }
  .dr-prep h3 small { font-weight: 400; font-size: .75rem; color: var(--muted); margin-left: .3rem; }
  .dr-prep label { display: grid; gap: .3rem; margin-top: .6rem; font-weight: 700; font-size: .85rem; }
  .dr-prep :is(select, textarea) { width: 100%; box-sizing: border-box; padding: .45rem .6rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: 400 .9rem var(--font-body); }
  .dr-slot, .dr-plan { padding: 1rem; border: 1px solid var(--line); }
  .dr-slot__title { font-weight: 700; margin: 0; }
  .dr-label { margin: .6rem 0 .3rem; font-weight: 700; font-size: .85rem; }
  .dr-label small { font-weight: 400; color: var(--muted); }
  .dr-chips { display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; padding: 0; list-style: none; }
  .dr-chips :global(li:not(.eq-note)) { display: inline-flex; align-items: center; gap: .35rem; padding: 2px .4rem 2px 2px; border: 1px solid var(--line); font-size: .8rem; }
  .dr-chips :global(button) { border: 0; background: none; color: var(--muted); cursor: pointer; font-size: 1rem; line-height: 1; }
  .dr-read { margin-top: 1.5rem; }
  .dr-read__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1.5rem; margin-top: .75rem; }
  .dr-read :global(h4) { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; padding: .3rem .5rem; color: #fff; margin: 0 0 .6rem; }
  .dr-read :global(h4.is-blue) { background: #1f5fd1; } .dr-read :global(h4.is-red) { background: #c8282d; }
  .dr-read :global(.dr-dmg) { display: flex; height: 22px; font-size: .7rem; font-weight: 700; color: #fff; overflow: hidden; }
  .dr-read :global(.dr-dmg span) { display: flex; align-items: center; padding: 0 .4rem; white-space: nowrap; overflow: hidden; }
  .dr-read :global(.dr-dmg span:first-child) { background: #b5651d; } .dr-read :global(.dr-dmg span:last-child) { background: #6b3fd1; }
  .dr-read :global(.dr-stats) { display: flex; flex-wrap: wrap; gap: .3rem 1rem; margin: .6rem 0; padding: 0; list-style: none; font-size: .82rem; color: var(--muted); }
  .dr-read :global(.dr-stats b) { color: var(--ink); font-size: 1rem; }
  .dr-read :global(.dr-warn) { display: grid; gap: .25rem; margin: 0; padding: 0; list-style: none; font-size: .85rem; }
  .dr-read :global(.dr-warn li) { padding-left: .6rem; border-left: 3px solid #f0a04b; }
  .dr-read :global(.dr-ok) { font-size: .85rem; color: #2fbf71; }
  .dr-read :global(.dr-who) { display: grid; gap: .25rem; margin: .6rem 0 0; padding: 0; list-style: none; font-size: .82rem; }
  .dr-read :global(.dr-who li) { display: flex; align-items: center; gap: .4rem; }
  .dr-read :global(.dr-who .is-warn) { color: #f0a04b; }
  .dr-read :global(.dr-sub) { margin: .8rem 0 .3rem; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .dr-ll :global(.dr-ll__list) { display: grid; gap: .3rem; margin: 0; padding: 0; list-style: none; font-size: .85rem; }
  .dr-ll :global(.dr-ll__list li) { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; padding: .3rem .5rem; border-left: 3px solid var(--line); }
  .dr-ll :global(.dr-ll__list li span) { color: var(--muted); }
  .dr-ll :global(.dr-ll__list li b) { margin-left: auto; font-variant-numeric: tabular-nums; }
  .dr-ll :global(.dr-ll__list li small) { width: 100%; padding-left: 1.9rem; color: var(--muted); font-size: .75rem; }
  .dr-ll :global(.dr-ll__list li.is-bad) { border-left-color: #e5251f; } .dr-ll :global(.dr-ll__list li.is-bad b) { color: #ff6a5c; }
  .dr-ll :global(.dr-ll__list li.is-good) { border-left-color: #2fbf71; } .dr-ll :global(.dr-ll__list li.is-good b) { color: #2fbf71; }
  .dr-ll :global(.ll-top) { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .dr-ll :global(.ll-top .dr-sub) { margin: 0; }
  .dr-ll :global(.ll-score) { display: flex; align-items: center; gap: .75rem; padding: .5rem .9rem; border: 1px solid var(--line); }
  .dr-ll :global(.ll-score b) { font: 700 1.6rem var(--font-display); font-variant-numeric: tabular-nums; }
  .dr-ll :global(.ll-score span) { display: grid; font-size: .85rem; }
  .dr-ll :global(.ll-score small) { color: var(--muted); font-size: .72rem; }
  .dr-ll :global(.ll-score.is-good) { border-color: #2fbf71; } .dr-ll :global(.ll-score.is-good b) { color: #2fbf71; }
  .dr-ll :global(.ll-score.is-bad) { border-color: #e5251f; } .dr-ll :global(.ll-score.is-bad b) { color: #ff6a5c; }
  .dr-ll :global(.ll-grid) { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 1.25rem 1.5rem; margin: 1rem 0; }
  .dr-ll :global(.ll-grid > section) { min-width: 0; }
  .dr-ll :global(.ll-grid > .ll-wide) { grid-column: 1 / -1; }
  .dr-ll :global(.ll-grid h4) { margin: 0 0 .5rem; font: 700 .95rem var(--font-body); background: none !important; color: var(--ink) !important; padding: 0 !important; }
  .dr-ll :global(.ll-posts) { display: grid; gap: .4rem; margin: 0; padding: 0; list-style: none; font-size: .85rem; }
  .dr-ll :global(.ll-posts li) { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .8rem; }
  .dr-ll :global(.ll-posts li > b) { min-width: 3rem; }
  .dr-ll :global(.ll-posts span) { display: inline-flex; align-items: center; gap: .3rem; }
  .dr-ll :global(.ll-posts em) { font-style: normal; color: var(--muted); }
  .dr-ll :global(.ll-posts small) { padding: 0 .3rem; border: 1px solid #f0a04b; color: #f0a04b; font-size: .7rem; }
  .dr-ll :global(.ll-tag) { padding: 0 .35rem; border: 1px solid var(--line); color: var(--ink) !important; font-size: .78rem; white-space: nowrap; }
  .dr-ll :global(.ll-risk li) { border-left-color: #f0a04b; }
  .dr-ll :global(.ll-picks) { display: grid; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  .dr-ll :global(.ll-picks li) { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .dr-ll :global(.ll-picks li > strong) { min-width: 4.5rem; }
  .dr-ll :global(.ll-picks li > small) { min-width: 5rem; color: var(--muted); font-size: .78rem; }
