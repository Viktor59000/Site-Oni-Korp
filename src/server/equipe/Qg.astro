---
// Cadre d'« Inside » (espace équipe) : un habillage d'outil, distinct de la vitrine.
// Barre du haut (Inside, sélecteur de roster, thème, compte), navigation par usage pour le roster choisi
// (Accueil · Semaine · Progresser · Préparer ; l'équipe en pied de menu), outils filtrés selon le jeu du roster,
// en-tête d'écran compact (titre + action principale), puis le contenu.
import Base from '../../layouts/Inside.astro';
import type { RosterRow } from './access';
import '../../styles/qg.css';
import { JEUX } from './jeux';

interface Props {
  title: string; heading?: string; lead?: string; current?: string;
  rosters?: RosterRow[]; staff?: boolean; contenu?: boolean; communaute?: boolean; active?: string | null;
  user?: { name: string; avatar: string | null } | null; bare?: boolean;
}
const { title, heading = title, lead, current = '', rosters = [], staff = false, contenu = false, communaute = false, active = null, user = null, bare = false } = Astro.props;
// Pôle contenu sans roster : seulement l'espace Contenu
const onlyContent = contenu && !rosters.length;
// Propriétés des jeux (couleur, nom, outil dédié, tableau blanc) : jeux.ts
const GAMES: Record<string, { label: string; color: string }> = JEUX;
// Roster de travail : celui de la page (chaque outil d'équipe en a toujours un, voir scope()). Sans roster : Mon espace, vue d'ensemble, profil…
const activeRoster = rosters.find((r) => r.slug === active) ?? null;
const game = activeRoster?.game ?? null;
const PATH: Record<string, string> = {
  accueil: '/equipe/', planning: '/equipe/planning/', calendrier: '/equipe/calendrier/', match: '/equipe/match/', stats: '/equipe/stats/', objectifs: '/equipe/objectifs/',
  notes: '/equipe/notes/', vod: '/equipe/vod/', tactique: '/equipe/tactique/', scouting: '/equipe/scouting/', lol: '/equipe/lol/',
  valo: '/equipe/valo/', osu: '/equipe/osu/', rl: '/equipe/rl/', joueurs: '/equipe/joueurs/', setup: '/equipe/setup/', docs: '/equipe/docs/', contenu: '/equipe/contenu/', tournois: '/equipe/tournois/',
};
const GAME_TOOL: Record<string, [string, string]> = Object.fromEntries(Object.entries(JEUX).map(([k, j]) => [k, [j.tool[0], j.tool[1]]]));
// Toutes les pages propres à un jeu (outil principal et outils en plus) : clé de page → jeu
const GAME_PAGES: Record<string, string> = Object.fromEntries(Object.entries(JEUX).flatMap(([k, j]) => [j.tool, ...(j.more ?? [])].map((t) => [t[0], k])));
for (const j of Object.values(JEUX)) for (const t of j.more ?? []) PATH[t[0]] = t[2];
const q = activeRoster && active ? `?r=${activeRoster.slug}` : '';
// Outil propre au jeu : seulement celui du roster choisi (un roster osu! ne voit pas le drafter LoL)
const gameTools: [string, string][] = game && GAME_TOOL[game] ? [GAME_TOOL[game], ...(JEUX[game as keyof typeof JEUX].more ?? []).map((t) => [t[0], t[1]] as [string, string])] : [];
// Tableau blanc : pas pour osu! (retour des joueurs, 06/10) ; affiché si le roster choisi, ou l'un des rosters, joue à un autre jeu
const hasBoard = (g: string) => !!JEUX[g as keyof typeof JEUX]?.board;
const withBoard = game ? hasBoard(game) : staff || rosters.some((r) => hasBoard(r.game));
// Six rubriques au plus dans le menu ; les pages d'une rubrique deviennent des onglets en haut de l'écran.
// Profil et guide sont dans le menu du compte, la vue d'ensemble (staff) dans le sélecteur de roster.
const SECTIONS: { key: string; label: string; pages: [string, string][] }[] = onlyContent ? [{ key: 'contenu', label: 'Contenu', pages: [['contenu', 'Contenu']] }] : [
  { key: 'accueil', label: 'Accueil', pages: [['accueil', 'Accueil']] },
  { key: 'semaine', label: 'Semaine', pages: [['planning', 'Planning'], ['calendrier', 'Calendrier']] },
  { key: 'match', label: 'Match', pages: [['match', 'Avant-match'], ['tournois', 'Tournois'], ['notes', 'Notes de match'], ['vod', 'VOD'], ['scouting', 'Scouting']] },
  { key: 'progres', label: 'Progrès', pages: [['stats', 'Stats'], ['objectifs', 'Objectifs']] },
  { key: 'outils', label: 'Préparer', pages: [...(withBoard ? [['tactique', 'Tableau blanc']] : []), ...gameTools, ['docs', 'Docs']] as [string, string][] },
  { key: 'equipe', label: 'Équipe', pages: [['joueurs', 'Joueurs'], ['setup', 'Setups']] },
];
const section = SECTIONS.find((x) => x.pages.some(([k]) => k === current)) ?? (GAME_PAGES[current] ? SECTIONS.find((x) => x.key === 'outils') : undefined);
// Changer de roster en restant sur le même outil (sauf outil propre à un autre jeu)
const switchTo = (r: RosterRow) => {
  const tool = PATH[current] && !(GAME_PAGES[current] && GAME_PAGES[current] !== r.game) ? PATH[current] : '/equipe/';
  return `${tool}?r=${r.slug}`;
};
const accent = activeRoster ? GAMES[activeRoster.game]?.color ?? '#e5251f' : '#e5251f';
const currentLabel = section?.label ?? heading;
---
<Base title={title} qg>
  <div class="qg-app" style={`--game:${accent};--game-fg:${accent === '#ff66aa' ? '#1a0b13' : '#fff'}`}>
    <header class="qg-top">
      {!bare && <button class="qg-icon qg-fold" type="button" data-qg-fold aria-label="Replier le menu" title="Replier / déplier le menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>}
      <a class="qg-brand" href={`/equipe/${q}`} aria-label="Inside, accueil de l'espace équipe"><img src="/img/oni-logo.svg" alt="" width="28" height="28" /><span><b translate="no">Oni Korp</b> Inside</span></a>
      {!bare && (rosters.length > 0 || contenu || communaute) && (
        <details class="qg-switch">
          <summary><span class="qg-dot" aria-hidden="true"></span>{activeRoster ? activeRoster.name : current === 'vue' ? "Vue d'ensemble" : current === 'contenu' ? 'Contenu' : current === 'communaute' ? 'Communauté' : 'Mon espace'}<span class="qg-caret" aria-hidden="true"></span></summary>
          <div class="qg-menu">
            <a href="/equipe/" aria-current={current === 'espace' ? 'page' : undefined}>Mon espace</a>
            {staff && <a href="/equipe/vue/" aria-current={current === 'vue' ? 'page' : undefined}>Vue d'ensemble</a>}
            {contenu && <a href="/equipe/contenu/" aria-current={current === 'contenu' ? 'page' : undefined}>Contenu</a>}
            {communaute && <a href="/equipe/communaute/" aria-current={current === 'communaute' ? 'page' : undefined}>Communauté</a>}
            {rosters.some((r) => r.mine) && <p>Mes rosters</p>}
            {rosters.filter((r) => r.mine).map((r) => <a href={switchTo(r)} style={`--g:${GAMES[r.game]?.color}`} class="qg-menu__team" aria-current={r.slug === activeRoster?.slug ? 'page' : undefined}>{r.name}<small>{GAMES[r.game]?.label}</small></a>)}
            {rosters.some((r) => !r.mine) && <p>Suivis en encadrement</p>}
            {rosters.filter((r) => !r.mine).map((r) => <a href={switchTo(r)} style={`--g:${GAMES[r.game]?.color}`} class="qg-menu__team is-other" aria-current={r.slug === activeRoster?.slug ? 'page' : undefined}>{r.name}<small>{GAMES[r.game]?.label}</small></a>)}
          </div>
        </details>
      )}
      <span class="qg-spacer"></span>
      <button class="qg-icon" type="button" data-qg-theme aria-label="Changer de thème" title="Thème clair / sombre"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 019.5 3.5a8.5 8.5 0 1011 11z" /></svg></button>
      {user ? (
        <details class="qg-account">
          <summary>{user.avatar ? <img src={user.avatar} alt="" width="30" height="30" crossorigin="anonymous" referrerpolicy="no-referrer" /> : <span class="qg-avatar">{user.name.slice(0, 1)}</span>}<span class="qg-name">{user.name}</span></summary>
          <div class="qg-menu qg-menu--right">
            <a href="/equipe/profil/">Mon profil</a>
            <a href="/equipe/guide/">Guide</a>
            <a href="/">Retour au site</a>
            <a href="/api/auth/logout">Se déconnecter</a>
            <form method="post" action="/api/equipe/outils"><input type="hidden" name="action" value="deconnexion-partout" /><button type="submit" class="qg-menu__btn" title="Coupe aussi les sessions ouvertes sur tes autres appareils">Me déconnecter partout</button></form>
          </div>
        </details>
      ) : <a class="qg-back" href="/">Retour au site</a>}
    </header>

    <div class:list={['qg-body', { 'is-bare': bare }]}>
      {!bare && (
        <details class="qg-nav" data-qg-nav open>
          <summary>{currentLabel}<span class="qg-caret" aria-hidden="true"></span></summary>
          <nav aria-label="Rubriques d'Inside">
            {!onlyContent && <a class="qg-nav__home" href="/equipe/" aria-current={current === 'espace' ? 'page' : undefined}>Mon espace</a>}
            {activeRoster ? (
              <>
                <p class="qg-nav__roster" style={`--g:${GAMES[activeRoster.game]?.color ?? accent}`}><span aria-hidden="true"></span>{activeRoster.name}</p>
                {SECTIONS.map((x) => (
                  <a href={`${PATH[x.pages[0][0]]}${q}`} aria-current={x === section ? 'page' : undefined}>{x.label}</a>
                ))}
              </>
            ) : onlyContent ? SECTIONS.map((x) => <a href={PATH[x.pages[0][0]]} aria-current={x === section ? 'page' : undefined}>{x.label}</a>) : (
              <>
                {rosters.some((r) => r.mine) && <p class="qg-nav__roster">Mes rosters</p>}
                {rosters.filter((r) => r.mine).map((r) => <a href={`/equipe/?r=${r.slug}`} style={`--g:${GAMES[r.game]?.color}`} class="qg-nav__team">{r.name}</a>)}
                {rosters.some((r) => !r.mine) && <p class="qg-nav__roster">Suivis en encadrement</p>}
                {rosters.filter((r) => !r.mine).map((r) => <a href={`/equipe/?r=${r.slug}`} style={`--g:${GAMES[r.game]?.color}`} class="qg-nav__team is-other">{r.name}</a>)}
                {(staff || contenu || communaute) && <p class="qg-nav__roster">Encadrement</p>}
                {staff && <a href="/equipe/vue/" aria-current={current === 'vue' ? 'page' : undefined}>Vue d'ensemble</a>}
                {contenu && <a href="/equipe/contenu/" aria-current={current === 'contenu' ? 'page' : undefined}>Contenu</a>}
                {communaute && <a href="/equipe/communaute/" aria-current={current === 'communaute' ? 'page' : undefined}>Communauté</a>}
              </>
            )}
          </nav>
        </details>
      )}
      {!bare && <script is:inline>if (matchMedia('(max-width: 900px)').matches) document.querySelector('[data-qg-nav]')?.removeAttribute('open');</script>}
      {!bare && !onlyContent && (
        <nav class="qg-tabs" aria-label="Accès rapide">
          <a href="/equipe/" aria-current={current === 'espace' ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 100-8 4 4 0 000 8zM4 21a8 8 0 0116 0" /></svg>Moi</a>
          {activeRoster && ([['accueil', 'Roster', 'M4 11l8-7 8 7v9H4z'], ['planning', 'Semaine', 'M4 6h16M4 12h16M4 18h10'], ['match', 'Match', 'M4 19l5-5 4 4 7-9M4 5h16'], ['stats', 'Progrès', 'M5 20V11M12 20V5M19 20v-7']] as [string, string, string][]).map(([k, l, d]) => (
            <a href={`${PATH[k]}${q}`} aria-current={k === current ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={d} /></svg>{l}</a>
          ))}
          <button type="button" data-qg-more><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h.01M12 12h.01M19 12h.01" /></svg>Menu</button>
        </nav>
      )}
      <main id="contenu" class="qg-main">
        {section && section.pages.length > 1 && (
          <nav class="qg-sub" aria-label={section.label}>
            {section.pages.map(([k, l]) => <a href={`${PATH[k]}${q}`} aria-current={k === current ? 'page' : undefined}>{l}</a>)}
          </nav>
        )}
        <header class="qg-head">
          <div>
            {activeRoster && <p class="qg-kicker"><span aria-hidden="true"></span>{activeRoster.name} · {GAMES[activeRoster.game]?.label}{!activeRoster.mine && <em class="qg-kicker__other">tu le suis en encadrement, tu n’es pas dans ce roster</em>}</p>}
            <h1>{heading}</h1>
            {lead && <p class="qg-lead">{lead}</p>}
          </div>
          <div class="qg-actions"><slot name="actions" /></div>
        </header>
        <slot />
      </main>
    </div>
  </div>
</Base>

<script>
  // Menu de gauche repliable (mémorisé) : plus de place pour le tableau blanc, le drafter…
  const fold = (on: boolean) => { document.body.classList.toggle('qg-folded', on); document.querySelector('[data-qg-fold]')?.setAttribute('aria-expanded', String(!on)); };
  try { fold(localStorage.getItem('qg-folded') === '1'); } catch {}
  document.querySelector('[data-qg-fold]')?.addEventListener('click', () => { const on = !document.body.classList.contains('qg-folded'); fold(on); try { localStorage.setItem('qg-folded', on ? '1' : '0'); } catch {} });
  // Thème (même choix mémorisé que la vitrine)
  document.querySelector('[data-qg-theme]')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
  // Navigation repliée sur mobile ; menus fermés au clic à l'extérieur
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.qg-switch[open], .qg-account[open]').forEach((d) => { if (!d.contains(e.target as Node)) d.open = false; });
  });
  // Onglet « Menu » (mobile) : ouvre la navigation complète
  document.querySelector('[data-qg-more]')?.addEventListener('click', () => {
    const n = document.querySelector<HTMLDetailsElement>('[data-qg-nav]');
    if (n) { const on = !n.hasAttribute('data-shown'); n.toggleAttribute('data-shown', on); n.open = on; if (on) n.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
  });
  // Panneaux (formulaires) : ils repartent par où ils sont venus (vers la droite) au lieu de disparaître d'un coup.
  // Fermeture par Échap, par le voile (le résumé) ou par la croix ; un nouvel appui pendant la sortie ne bloque rien.
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  const closeDrawer = (d: HTMLDetailsElement) => {
    const panel = d.querySelector<HTMLElement>('.qg-drawer__panel');
    if (calm.matches || !panel || d.dataset.closing) { d.open = false; return; }
    d.dataset.closing = '1';
    const opts = { duration: 140, easing: 'cubic-bezier(.4, 0, 1, 1)', fill: 'forwards' as const };
    const out = panel.animate([{ transform: 'none', opacity: 1 }, { transform: 'translateX(24px)', opacity: 0 }], opts);
    try { d.querySelector('summary')?.animate([{ opacity: 1 }, { opacity: 0 }], { ...opts, pseudoElement: '::before' }); } catch {}
    const end = () => { d.open = false; delete d.dataset.closing; panel.getAnimations().forEach((a) => a.cancel()); d.querySelector('summary')?.getAnimations({ subtree: true }).forEach((a) => a.cancel()); };
    Promise.race([out.finished, new Promise((r) => setTimeout(r, 220))]).then(end, end);
  };
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    const d = t.closest<HTMLDetailsElement>('.qg-drawer[open]');
    if (!d) return;
    if (t.closest('.qg-close') || t.closest('summary')?.parentElement === d) { e.preventDefault(); e.stopPropagation(); closeDrawer(d); }
  }, true);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll<HTMLDetailsElement>('.qg-drawer[open]').forEach(closeDrawer);
  });
</script>
