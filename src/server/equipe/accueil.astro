  .me-next__sub { font-size: var(--text-sm); color: var(--qg-muted); display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; }
  .me-next .is-first .me-next__sub { color: rgb(255 255 255 / .85); }
  .me-tag { padding: .1rem .45rem; background: var(--g); color: #fff; font-weight: 700; font-size: .75rem; }
  .me-answer { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .5rem; }
  .me-answer button { min-height: 40px; padding: 0 .9rem; border: 1.5px solid currentColor; background: transparent; color: inherit; font: 700 .85rem var(--font-body); cursor: pointer; }
  .me-answer button.is-on { background: var(--qg-ink); color: var(--qg-paper); border-color: var(--qg-ink); }
  .me-next .is-first .me-answer button.is-on { background: #fff; color: #0b0c0f; border-color: #fff; }
  .me-empty { margin: 0; padding: 1.25rem; border: 1px dashed var(--qg-rule-strong, var(--qg-rule)); color: var(--qg-muted); }
