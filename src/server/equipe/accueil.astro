---
// Accueil d'Inside, deux pages en une :
// - sans ?r= : « Mon espace », la page perso (décision du 07/10) : ma prochaine échéance tous rosters confondus, ce que j'ai à faire,
//   mes rosters pour entrer dedans, mes objectifs rangés par roster ; l'encadrement y trouve ses raccourcis ;
// - avec ?r= : l'accueil du roster (prochaine échéance, réponses en attente, forme, objectifs, ce qui a bougé).
// Sans accès (non connecté, pas membre d'un roster) : la page Planning gère la connexion et les messages.
import Qg from './Qg.astro';
import { canLead, rosterMembers, scope, teamUser } from './outils';
import { rows, weekKey } from '../db';
import { JEUX } from './jeux';

export const prerender = false;
const t = await teamUser(Astro.cookies);
if (!t) return Astro.redirect('/equipe/planning/');
const { me, user } = t;
const asked = me.rosters.find((r) => r.slug === Astro.url.searchParams.get('r'));
if (asked) scope(me.rosters, Astro.url, Astro.cookies); // retient le roster ouvert pour les outils
// Pôle contenu sans roster : son espace, c'est Contenu
if (!me.rosters.length && me.content.length) return Astro.redirect('/equipe/contenu/');
const roster = asked ?? null;

// Pas d'illustration dans Inside : chaque pôle se reconnaît à sa couleur et à son sigle
const GAME: Record<string, { label: string; code: string; color: string; tool?: [string, string] }> = Object.fromEntries(Object.entries(JEUX).map(([k, j]) => [k, { label: j.label, code: j.code, color: j.color, tool: [j.tool[2], j.tool[1]] as [string, string] }]));
const tz = { timeZone: 'Europe/Paris' } as const;
const fWhen = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', ...tz });
const fShort = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', ...tz });
const ago = (ms: number) => { const m = Math.round((Date.now() - ms) / 60_000); return m < 60 ? `il y a ${Math.max(1, m)} min` : m < 2880 ? `il y a ${Math.round(m / 60)} h` : `il y a ${Math.round(m / 1440)} j`; };
const inDays = (ms: number) => { const d = Math.round((ms - Date.now()) / 86400_000); return d <= 0 ? "aujourd'hui" : d === 1 ? 'demain' : `dans ${d} jours`; };
const DAY = 86400_000;
const now = Date.now();

type Mb = { id: string; name: string; avatar: string };
type Ev = { type: 'seance' | 'match'; id: number; at: number; title: string; sub: string; mine?: string | null };
let data: null | {
  members: Mb[]; events: Ev[]; pending: number; dispos: boolean; last: { opponent: string; us: number; them: number; at: number } | null;
  goals: { title: string; progress: number; due: number | null; who: string | null }[];
  form: { m: Mb; n: number; wins: number | null }[]; activity: { kind: string; title: string; at: number; href: string }[];
} = null;

if (roster) {
  const rid = roster.id;
  const [members, trainings, matches, lastMatch, goals, boards, docs, vods, dispo] = await Promise.all([
    rosterMembers(roster.role_id) as Promise<Mb[]>,
    rows<{ id: number; at: number; kind: string; duration: number }>('SELECT id, at, kind, duration FROM trainings WHERE roster_id = ? AND cancelled = 0 AND at > ? ORDER BY at LIMIT 6', rid, now - 2 * 3600_000),
    rows<{ id: number; at: number; opponent: string; format: string; kind: string | null }>('SELECT id, at, opponent, format, kind FROM matches WHERE roster_id = ? AND cancelled = 0 AND score_us IS NULL AND at > ? ORDER BY at LIMIT 3', rid, now - 3 * 3600_000),
    rows<{ opponent: string; score_us: number; score_them: number; at: number }>('SELECT opponent, score_us, score_them, at FROM matches WHERE roster_id = ? AND cancelled = 0 AND score_us IS NOT NULL ORDER BY at DESC LIMIT 1', rid),
    rows<{ title: string; progress: number; due: number | null; user_id: string | null }>(`SELECT title, progress, due, user_id FROM goals WHERE roster_id = ? AND status = 'en-cours' AND (COALESCE(private, 0) = 0 OR user_id = ? OR ? = 1) ORDER BY (user_id = ?) DESC, due IS NULL, due LIMIT 4`, rid, user.id, canLead(me, rid) ? 1 : 0, user.id).catch(() => []),
    rows<{ id: number; title: string; updated_at: number }>('SELECT id, title, updated_at FROM boards WHERE roster_id = ? ORDER BY updated_at DESC LIMIT 3', rid).catch(() => []),
    rows<{ id: number; title: string; updated_at: number }>('SELECT id, title, updated_at FROM docs WHERE roster_id = ? ORDER BY updated_at DESC LIMIT 3', rid).catch(() => []),
    rows<{ id: number; title: string; at: number }>('SELECT id, title, at FROM vods WHERE roster_id = ? ORDER BY at DESC LIMIT 3', rid).catch(() => []),
    // Disponibilités v2 (dispo_days) : au moins un jour coché pour la semaine prochaine
    rows<{ user_id: string }>('SELECT user_id FROM dispo_days WHERE roster_id = ? AND week = ? AND user_id = ? LIMIT 1', rid, weekKey(true), user.id).catch(() => []),
  ]);
  const ids = members.map((m) => m.id);
  const [answers, perfs] = await Promise.all([
    trainings.length ? rows<{ training_id: number; status: string }>(`SELECT training_id, status FROM attendance WHERE user_id = ? AND training_id IN (${trainings.map(() => '?').join(',')})`, user.id, ...trainings.map((x) => x.id)) : [],
    ids.length ? rows<{ user_id: string; data: string }>(`SELECT user_id, data FROM perf WHERE game = ? AND at > ? AND user_id IN (${ids.map(() => '?').join(',')})`, roster.game, now - 7 * DAY, ...ids).catch(() => []) : [],
  ]);
  const mine = new Map<number, string>(answers.map((a) => [Number(a.training_id), a.status] as [number, string]));
  const events: Ev[] = [
    ...trainings.map((x) => ({ type: 'seance' as const, id: Number(x.id), at: Number(x.at), title: x.kind, sub: `${x.duration} min`, mine: mine.get(Number(x.id)) ?? null })),
    ...matches.map((x) => ({ type: 'match' as const, id: Number(x.id), at: Number(x.at), title: `vs ${x.opponent}`, sub: `${x.format}${x.kind === 'scrim' ? ' · scrim' : ''}` })),
  ].sort((a, b) => a.at - b.at).slice(0, 4);
  const names = new Map(members.map((m) => [m.id, m.name]));
  data = {
    members, events,
    pending: trainings.filter((x) => !mine.has(Number(x.id))).length,
    dispos: dispo.length > 0,
    last: lastMatch[0] ? { opponent: lastMatch[0].opponent, us: Number(lastMatch[0].score_us), them: Number(lastMatch[0].score_them), at: Number(lastMatch[0].at) } : null,
    goals: goals.map((g) => ({ title: g.title, progress: Number(g.progress) || 0, due: g.due ? Number(g.due) : null, who: g.user_id ? names.get(g.user_id) ?? null : null })),
    form: members.map((m) => {
      const games = perfs.filter((p) => p.user_id === m.id).map((p) => { try { return JSON.parse(p.data); } catch { return {}; } });
      const withWin = games.filter((g) => typeof g.win === 'boolean');
      return { m, n: games.length, wins: withWin.length ? withWin.filter((g) => g.win).length : null };
    }).sort((a, b) => b.n - a.n),
    activity: [
      ...boards.map((b) => ({ kind: 'Tableau', title: b.title, at: Number(b.updated_at), href: `/equipe/tactique/?b=${b.id}&r=${roster.slug}` })),
      ...docs.map((d) => ({ kind: 'Doc', title: d.title, at: Number(d.updated_at), href: `/equipe/docs/?r=${roster.slug}&d=${d.id}` })),
      ...vods.map((v) => ({ kind: 'VOD', title: v.title, at: Number(v.at), href: `/equipe/vod/?r=${roster.slug}&v=${v.id}` })),
    ].sort((a, b) => b.at - a.at).slice(0, 4),
  };
}
// À gérer (capitaine, responsable du jeu, encadrement) : ce qui demande une action sur ce roster
const manageList = roster && data && canLead(me, roster.id) ? await (async () => {
  const rid = roster.id, out: { label: string; why: string; href: string; relance?: number }[] = [];
  const st = await rows<{ user_id: string; statut: string; essai_fin: number | null; retour: string | null }>('SELECT user_id, statut, essai_fin, retour FROM roster_status WHERE roster_id = ?', rid).catch(() => []);
  const name = new Map(data!.members.map((m) => [m.id, m.name]));
  for (const e of st.filter((x) => x.statut === 'essai' && !x.retour && x.essai_fin && Number(x.essai_fin) < now + 7 * DAY))
    out.push({ label: `Essai de ${name.get(e.user_id) ?? 'une recrue'} : ${Number(e.essai_fin) < now ? 'terminé, retour à écrire' : `fin ${inDays(Number(e.essai_fin))}`}`, why: 'le retour écrit part en message privé à la recrue', href: `/equipe/joueurs/?r=${roster.slug}` });
  if (!st.some((x) => x.statut === 'remplacant')) out.push({ label: 'Aucun remplaçant désigné', why: 'un absent le jour du match, et le match est perdu', href: `/equipe/joueurs/?r=${roster.slug}` });
  const next = data!.events.find((e) => e.type === 'seance');
  if (!next || next.at > now + 7 * DAY) out.push({ label: 'Aucune séance dans les 7 jours', why: 'à planifier sur Discord avec /entrainement', href: `/equipe/planning/?r=${roster.slug}` });
  else {
    const answered = new Set((await rows<{ user_id: string }>('SELECT user_id FROM attendance WHERE training_id = ?', next.id)).map((a) => a.user_id));
    const silent = data!.members.filter((m) => !answered.has(m.id));
    if (silent.length) out.push({ label: `${silent.length} sans réponse à la prochaine séance`, why: silent.slice(0, 4).map((m) => m.name).join(', ') + (silent.length > 4 ? '…' : ''), href: `/equipe/planning/?r=${roster.slug}`, relance: next.id });
  }
  return out;
})() : null;
const g = roster ? GAME[roster.game] ?? { label: roster.game, code: roster.game.toUpperCase(), color: '#e5251f' } : null;
// Bien démarrer : ce qu'un nouveau joueur doit faire une fois (disparaît quand tout est fait)
const ACC: Record<string, [string, string]> = Object.fromEntries(Object.entries(JEUX).map(([k, j]) => [k, j.account]));
const onboarding = roster && data ? await (async () => {
  const acc = ACC[roster.game];
  const [linked, guideSeen, setup] = await Promise.all([
    acc ? rows('SELECT 1 FROM accounts WHERE user_id = ? AND game = ?', user.id, acc[0]) : Promise.resolve([1]),
    rows(`SELECT 1 FROM meta WHERE key = ?`, `guide:${user.id}`).catch(() => []),
    rows('SELECT 1 FROM setups WHERE user_id = ?', user.id).catch(() => []),
  ]);
  const steps = [
    { done: linked.length > 0, label: `Relie ${acc?.[1] ?? 'ton compte de jeu'}`, why: roster.game === 'lol' ? 'tes rangs, tes parties et tes débriefs arrivent tout seuls' : 'tes rangs et tes parties arrivent tout seuls', href: '/equipe/joueurs/' },
    { done: data.dispos, label: 'Coche tes dispos de la semaine', why: 'le staff planifie les séances avec', href: `/equipe/planning/?r=${roster.slug}#dispos-${roster.id}` },
    { done: setup.length > 0, label: 'Renseigne ton setup', why: 'sensibilité, DPI, matériel : utile au coach', href: '/equipe/setup/' },
    { done: guideSeen.length > 0, label: 'Lis le guide d’Inside', why: '2 minutes pour tout comprendre', href: '/equipe/guide/' },
  ];
  return steps.every((x) => x.done) ? null : steps;
})() : null;
const q = roster ? `?r=${roster.slug}` : '';
const next = data?.events[0] ?? null;
const maxForm = Math.max(1, ...(data?.form.map((f) => f.n) ?? [1]));
// ---------- Mon espace (sans roster choisi) ----------
type Rr = (typeof me.rosters)[number];
type Mine = { roster: Rr; at: number; type: 'seance' | 'match'; id: number; title: string; sub: string; answer: string | null };
let espace: null | {
  next: Mine[]; todo: { label: string; why: string; href: string; color?: string }[];
  goals: { roster: Rr; items: { title: string; progress: number; due: number | null }[] }[];
  cards: { r: Rr; next: Mine | null; members: number; team: number }[];
  trial: { roster: string; until: number | null; retour: string | null } | null;
  accounts: { game: string; ident: string }[]; elo: { mode: string; rating: number; wins: number; losses: number }[];
  sync: { seen_at: number | null; seen_state: string | null; last_at: number | null } | null; image: boolean;
} = null;
if (!roster) {
  // Seulement MES rosters (ceux dont j'ai le rôle) : ceux que l'encadrement suit sans y jouer sont listés à part, sans tâches ni échéances
  const R = me.rosters.filter((r) => r.mine), ids = R.map((r) => Number(r.id)), inR = ids.map(() => '?').join(',');
  const byId = new Map(R.map((r) => [Number(r.id), r]));
  const [tr, mt, goals, accs, setup, guideSeen, dispo, status, members] = await Promise.all([
    ids.length ? rows<{ id: number; roster_id: number; at: number; kind: string; duration: number }>(`SELECT id, roster_id, at, kind, duration FROM trainings WHERE roster_id IN (${inR}) AND cancelled = 0 AND at > ? ORDER BY at LIMIT 12`, ...ids, now - 2 * 3600_000) : [],
    ids.length ? rows<{ id: number; roster_id: number; at: number; opponent: string; format: string; kind: string | null }>(`SELECT id, roster_id, at, opponent, format, kind FROM matches WHERE roster_id IN (${inR}) AND cancelled = 0 AND score_us IS NULL AND at > ? ORDER BY at LIMIT 8`, ...ids, now - 3 * 3600_000) : [],
    ids.length ? rows<{ roster_id: number; user_id: string | null; title: string; progress: number; due: number | null }>(`SELECT roster_id, user_id, title, progress, due FROM goals WHERE roster_id IN (${inR}) AND status = 'en-cours' AND (user_id = ? OR user_id IS NULL) ORDER BY due IS NULL, due`, ...ids, user.id).catch(() => []) : [],
    rows<{ game: string }>('SELECT game FROM accounts WHERE user_id = ?', user.id).catch(() => []),
    rows('SELECT 1 FROM setups WHERE user_id = ? LIMIT 1', user.id).catch(() => []),
    rows('SELECT 1 FROM meta WHERE key = ?', `guide:${user.id}`).catch(() => []),
    ids.length ? rows<{ roster_id: number }>(`SELECT DISTINCT roster_id FROM dispo_days WHERE user_id = ? AND week = ? AND roster_id IN (${inR})`, user.id, weekKey(true), ...ids).catch(() => []) : [],
    rows<{ roster_id: number; status: string; trial_end: number | null; retour: string | null }>('SELECT roster_id, statut AS status, essai_fin AS trial_end, retour FROM roster_status WHERE user_id = ?', user.id).catch(() => []),
    Promise.all(R.map((r) => rosterMembers(r.role_id).then((m) => m.length).catch(() => 0))),
  ]);
  const answers = tr.length ? await rows<{ training_id: number; status: string }>(`SELECT training_id, status FROM attendance WHERE user_id = ? AND training_id IN (${tr.map(() => '?').join(',')})`, user.id, ...tr.map((x) => x.id)) : [];
  const ans = new Map(answers.map((a) => [Number(a.training_id), a.status]));
  const all: Mine[] = [
    ...tr.map((x) => ({ roster: byId.get(Number(x.roster_id))!, at: Number(x.at), type: 'seance' as const, id: Number(x.id), title: x.kind, sub: `${x.duration} min`, answer: ans.get(Number(x.id)) ?? null })),
    ...mt.map((x) => ({ roster: byId.get(Number(x.roster_id))!, at: Number(x.at), type: 'match' as const, id: Number(x.id), title: `vs ${x.opponent}`, sub: `${x.format}${x.kind === 'scrim' ? ' · scrim' : ''}`, answer: null })),
  ].filter((x) => x.roster).sort((a, b) => a.at - b.at);
  const linked = new Set(accs.map((a) => a.game));
  const dispoDone = new Set(dispo.map((d) => Number(d.roster_id)));
  const todo: { label: string; why: string; href: string; color?: string }[] = [];
  for (const r of R) {
    const c = GAME[r.game]?.color;
    const pend = all.filter((x) => x.roster === r && x.type === 'seance' && !x.answer).length;
    if (pend) todo.push({ label: `${pend} séance${pend > 1 ? 's' : ''} sans ta réponse`, why: r.name, href: `/equipe/planning/?r=${r.slug}`, color: c });
    if (!dispoDone.has(Number(r.id))) todo.push({ label: 'Coche tes dispos de la semaine prochaine', why: r.name, href: `/equipe/planning/?r=${r.slug}#dispos-${r.id}`, color: c });
  }
  const needAcc = [...new Set(R.map((r) => ACC[r.game]).filter((a): a is [string, string] => !!a && !linked.has(a[0])).map(([, l]) => l))];
  for (const l of needAcc) todo.push({ label: `Relie ${l}`, why: 'tes rangs et tes parties arrivent tout seuls', href: '/equipe/joueurs/' });
  if (R.length && !setup.length) todo.push({ label: 'Renseigne ton setup', why: 'sensibilité, DPI, matériel : utile au coach', href: '/equipe/setup/' });
  if (!guideSeen.length) todo.push({ label: 'Lis le guide d’Inside', why: '2 minutes pour tout comprendre', href: '/equipe/guide/' });
  const trial = status.find((x) => x.status === 'essai');
  // Mes comptes, l'état d'Oni Sync (si joueur RL), mon Elo d'inhouse de la saison
  const [accList, sync, elo, consent] = await Promise.all([
    rows<{ game: string; ident: string }>('SELECT game, ident FROM accounts WHERE user_id = ? ORDER BY game', user.id).catch(() => []),
    rows<{ seen_at: number | null; seen_state: string | null; last_at: number | null }>('SELECT seen_at, seen_state, last_at FROM rl_sync WHERE user_id = ?', user.id).catch(() => []),
    rows<{ mode: string; rating: number; wins: number; losses: number }>(`SELECT mode, rating, wins, losses FROM inhouse_elo WHERE user_id = ? AND season = (SELECT COALESCE(CAST(value AS INTEGER), 1) FROM meta WHERE key = 'inhouse_season' UNION ALL SELECT 1 LIMIT 1) AND wins + losses > 0 ORDER BY rating DESC`, user.id).catch(() => []),
    rows<{ image: number }>('SELECT image FROM consents WHERE user_id = ?', user.id).catch(() => []),
  ]);
  espace = {
    next: all.slice(0, 5),
    todo,
    goals: R.map((r) => ({ roster: r, items: goals.filter((x) => Number(x.roster_id) === Number(r.id) && x.user_id === user.id).map((x) => ({ title: x.title, progress: Number(x.progress) || 0, due: x.due ? Number(x.due) : null })) })).filter((x) => x.items.length),
    cards: R.map((r, i) => ({ r, next: all.find((x) => x.roster === r) ?? null, members: members[i], team: goals.filter((x) => Number(x.roster_id) === Number(r.id) && !x.user_id).length })),
    accounts: accList, elo, sync: sync[0] ?? null, image: Number(consent[0]?.image) === 1,
    trial: trial ? { roster: byId.get(Number(trial.roster_id))?.name ?? '', until: trial.trial_end ? Number(trial.trial_end) : null, retour: trial.retour } : null,
  };
}
---
<Qg title={roster ? `${roster.name} · Inside` : 'Mon espace · Inside'} heading={roster ? roster.name : `Salut ${me.member?.name ?? user.name}`}
  lead={roster ? undefined : 'Ce qui t’attend dans tes rosters et ce que tu as à faire. Entre dans un roster pour ses outils.'}
  current={roster ? 'accueil' : 'espace'} rosters={me.rosters} staff={me.staff || me.games.length > 0} contenu={me.staff || me.content.length > 0} communaute={me.community} active={roster?.slug ?? null} user={{ name: me.member?.name ?? user.name, avatar: me.member?.avatar ?? user.avatar }}>

  {!roster && espace && (
    <div class="me">
      <section aria-labelledby="me-next-h">
        <h2 id="me-next-h" class="sr-only">Prochaines échéances</h2>
        {espace.next.length ? (
          <ol class="me-next">
            {espace.next.map((e, i) => (
              <li class:list={{ 'is-first': i === 0 }} style={`--g:${GAME[e.roster.game]?.color ?? '#e5251f'}`}>
                <p class="me-next__when">{i === 0 ? `${e.type === 'match' ? 'Prochain match' : 'Prochaine séance'} · ${inDays(e.at)}` : fShort.format(new Date(e.at))}</p>
                <p class="me-next__title"><a href={e.type === 'match' ? `/equipe/match/?r=${e.roster.slug}` : `/equipe/planning/?r=${e.roster.slug}`}>{e.title}</a></p>
                <p class="me-next__sub"><span class="me-tag">{e.roster.name}</span>{i === 0 ? `${fWhen.format(new Date(e.at))} · ` : ''}{e.sub}</p>
                {e.type === 'seance' && (
                  <form method="post" action="/api/equipe/presence" class="me-answer">
                    <input type="hidden" name="training" value={e.id} />
                    <button name="status" value="present" class:list={{ 'is-on': e.answer === 'present' }} aria-pressed={e.answer === 'present'}>Présent</button>
                    <button name="status" value="peut-etre" class:list={{ 'is-on': e.answer === 'peut-etre' }} aria-pressed={e.answer === 'peut-etre'}>Peut-être</button>
                    <button name="status" value="absent" class:list={{ 'is-on': e.answer === 'absent' }} aria-pressed={e.answer === 'absent'}>Absent</button>
                  </form>
                )}
              </li>
            ))}
          </ol>
        ) : <p class="me-empty">{me.rosters.length ? 'Rien de prévu dans tes rosters pour l’instant.' : 'Tu n’es dans aucun roster pour l’instant.'}</p>}
      </section>

      {espace.trial && (
        <section class="qg-card me-trial">
          <h2>Ton essai · {espace.trial.roster}</h2>
          <p>{espace.trial.until ? `Jusqu’au ${fShort.format(new Date(espace.trial.until))}.` : 'Date de fin à fixer avec le staff.'} {espace.trial.retour ? 'Ton retour est écrit : lis-le sur ton profil.' : 'Le staff t’écrira un retour à la fin.'}</p>
          <a class="ac-more" href="/equipe/profil/">Voir mon profil</a>
        </section>
      )}

      <div class="me-grid">
        <section class="qg-card ac-card">
          <h2>À faire</h2>
          {espace.todo.length ? (
            <ul class="me-todo">
              {espace.todo.map((x) => <li style={x.color ? `--g:${x.color}` : undefined}><a href={x.href}><strong>{x.label}</strong><span>{x.why}</span></a></li>)}
            </ul>
          ) : <p class="ac-empty">Rien en attente : tout est à jour.</p>}
        </section>

        <section class="qg-card ac-card">
          <h2>Mes objectifs</h2>
          {espace.goals.length ? espace.goals.map((gr) => (
            <div class="me-goals" style={`--g:${GAME[gr.roster.game]?.color ?? '#e5251f'}`}>
              <p class="me-goals__h"><span aria-hidden="true"></span>{gr.roster.name}</p>
              <ul class="ac-goals">
                {gr.items.map((x) => (
                  <li>
                    <p><strong>{x.title}</strong>{x.due && <small>avant le {fShort.format(new Date(x.due))}</small>}</p>
                    <span class="ac-goals__bar" role="progressbar" aria-label={x.title} aria-valuemin="0" aria-valuemax="100" aria-valuenow={x.progress}><span style={`width:${x.progress}%`}></span></span>
                  </li>
                ))}
              </ul>
            </div>
          )) : <p class="ac-empty">Aucun objectif perso en cours. Ils se fixent dans chaque roster, rubrique Progrès.</p>}
        </section>
      </div>

      <section aria-labelledby="me-rosters-h">
        <h2 id="me-rosters-h" class="me-h">Mes espaces</h2>
        <ul class="ac-pick">
          {espace.cards.map(({ r, next: n, members, team }) => {
            const gg = GAME[r.game] ?? { label: r.game, code: r.game.toUpperCase(), color: '#e5251f' };
            return (
              <li>
                <a class="ac-pick__card" href={`/equipe/?r=${r.slug}`} style={`--g:${gg.color}`}>
                  <b class="ac-pick__code" aria-hidden="true" translate="no">{gg.code}</b>
                  <span>{r.name}</span>
                  <small>{gg.label} · {members} joueur{members > 1 ? 's' : ''}{team ? ` · ${team} objectif${team > 1 ? 's' : ''} d’équipe` : ''}</small>
                  <small class="ac-pick__next">{n ? `${n.type === 'match' ? 'Match' : 'Séance'} ${inDays(n.at)}` : 'Rien de prévu'}</small>
                </a>
              </li>
            );
          })}
          {me.staff && (
            <li><a class="ac-pick__card ac-pick__card--vue" href="/equipe/vue/"><span>Vue d’ensemble</span><small>Santé des rosters, alertes, candidatures</small></a></li>
          )}
          {me.community && (
            <li><a class="ac-pick__card" href="/equipe/communaute/" style="--g:#c9a227"><b class="ac-pick__code" aria-hidden="true">COM</b><span>Communauté</span><small>Arrivées, soirées, modération</small></a></li>
          )}
          {me.content.length > 0 && !me.staff && (
            <li><a class="ac-pick__card" href="/equipe/contenu/" style="--g:#8b5cf6"><b class="ac-pick__code" aria-hidden="true">CTN</b><span>Contenu</span><small>Tâches, calendrier éditorial, indicateurs</small></a></li>
          )}
          {!me.staff && me.games.map((g) => GAME[g] && (
            <li><a class="ac-pick__card" href={`/equipe/vue/?jeu=${g}`} style={`--g:${GAME[g].color}`}><b class="ac-pick__code" aria-hidden="true" translate="no">{GAME[g].code}</b><span>Espace {GAME[g].label}</span><small>Rosters, recrutement, essais du jeu</small></a></li>
          ))}
        </ul>
        {!espace.cards.length && <p class="ac-empty">Tu n’es dans aucun roster pour l’instant.</p>}
      </section>

      {me.rosters.some((r) => !r.mine) && (
        <section aria-labelledby="me-others-h">
          <h2 id="me-others-h" class="me-h">Suivis en encadrement</h2>
          <p class="me-note">Tu n’es pas dans ces rosters : tu les vois parce que tu fais partie de l’encadrement. Leurs séances et tâches ne s’ajoutent pas aux tiennes.</p>
          <ul class="me-others">
            {me.rosters.filter((r) => !r.mine).map((r) => <li style={`--g:${GAME[r.game]?.color ?? '#e5251f'}`}><a href={`/equipe/?r=${r.slug}`}><strong>{r.name}</strong><small>{GAME[r.game]?.label ?? r.game}</small></a></li>)}
          </ul>
        </section>
      )}

      <section class="qg-card ac-card me-acc" aria-labelledby="me-acc-h">
        <h2 id="me-acc-h">Mes comptes et inhouses</h2>
        <div class="me-acc__grid">
          <div>
            <p class="me-goals__h">Comptes de jeu</p>
            {espace.accounts.length ? <ul class="me-kv">{espace.accounts.map((a) => <li><span>{({ riot: 'Riot (LoL, Valorant)', rl: 'Rocket League', osu: 'osu!' } as Record<string, string>)[a.game] ?? a.game}</span><b>{a.ident}</b></li>)}</ul> : <p class="ac-empty">Aucun compte relié.</p>}
            <a class="ac-more" href="/equipe/joueurs/">Relier ou modifier</a>
          </div>
          {me.rosters.some((r) => r.mine && r.game === 'rl') && (
            <div>
              <p class="me-goals__h">Oni Sync</p>
              <p class="me-sync">{!espace.sync ? 'Pas encore installé.' : espace.sync.last_at ? `Dernière partie reçue ${ago(Number(espace.sync.last_at))}.` : espace.sync.seen_state === 'connecte' ? 'Connecté au jeu, en attente d’une partie terminée.' : 'Installé, pas encore de partie reçue.'}</p>
              <a class="ac-more" href={`/equipe/rl/?r=${me.rosters.find((r) => r.mine && r.game === 'rl')!.slug}`}>Tracker RL</a>
            </div>
          )}
          <div>
            <p class="me-goals__h">Inhouses · saison en cours</p>
            {espace.elo.length ? <ul class="me-kv">{espace.elo.map((e) => <li><span>{e.mode}</span><b>{e.rating}</b><small>{e.wins} V · {e.losses} D</small></li>)}</ul> : <p class="ac-empty">Pas encore de partie. Soirée inhouse le jeudi à 21 h sur Discord.</p>}
            <a class="ac-more" href="/inhouses/">Classement</a>
          </div>
          <div>
            <p class="me-goals__h">Ton image</p>
            <form method="post" action="/api/equipe/outils" class="me-consent">
              <input type="hidden" name="action" value="accord-image" /><input type="hidden" name="back" value="/equipe/" />
              <label><input type="checkbox" name="image" value="1" checked={espace.image} onchange="this.form.requestSubmit()" /> J’accepte que le club utilise ma vignette et les clips où j’apparais (site et réseaux du club)</label>
              <noscript><button class="btn btn--ghost">Enregistrer</button></noscript>
            </form>
            <p class="me-sync">{espace.image ? 'Accord donné. Tu peux le retirer à tout moment.' : 'Sans accord, aucun visuel ni clip centré sur toi ne sera publié.'}</p>
          </div>
        </div>
      </section>
    </div>
  )}

  {roster && data && g && (
    <div class="ac">
      <section class="ac-hero" style={`--g:${g.color}`}>
        <b class="ac-hero__code" aria-hidden="true" translate="no">{g.code}</b>
        <div class="ac-hero__body">
          {next ? (
            <>
              <p class="ac-hero__label">{next.type === 'match' ? 'Prochain match' : 'Prochaine séance'} · {inDays(next.at)}</p>
              <p class="ac-hero__title">{next.title}</p>
              <p class="ac-hero__when">{fWhen.format(new Date(next.at))} · {next.sub}</p>
              {next.type === 'seance' ? (
                <form method="post" action="/api/equipe/presence" class="ac-answer">
                  <input type="hidden" name="training" value={next.id} />
                  <button name="status" value="present" class:list={{ 'is-on': next.mine === 'present' }} aria-pressed={next.mine === 'present'}>Je suis là</button>
                  <button name="status" value="peut-etre" class:list={{ 'is-on': next.mine === 'peut-etre' }} aria-pressed={next.mine === 'peut-etre'}>Peut-être</button>
                  <button name="status" value="absent" class:list={{ 'is-on': next.mine === 'absent' }} aria-pressed={next.mine === 'absent'}>Absent</button>
                </form>
              ) : (
                <a class="btn" href={`/equipe/match/${q}`}>Préparer le match</a>
              )}
            </>
          ) : (
            <>
              <p class="ac-hero__label">Rien de prévu pour l’instant</p>
              <p class="ac-hero__title">À vous de jouer</p>
              <p class="ac-hero__when">Les séances et les matchs se créent sur Discord avec <code>/entrainement</code> et <code>/match</code>.</p>
            </>
          )}
          <ul class="ac-faces" aria-label="Joueurs du roster">
            {data.members.slice(0, 8).map((m) => <li title={m.name}>{m.avatar ? <img src={m.avatar} alt="" width="34" height="34" loading="lazy" crossorigin="anonymous" referrerpolicy="no-referrer" /> : <span>{m.name.slice(0, 1)}</span>}<span class="sr-only">{m.name}</span></li>)}
          </ul>
        </div>
      </section>

      {onboarding && (
        <section class="qg-card ac-start" aria-labelledby="ac-start">
          <h2 id="ac-start">Bien démarrer · {onboarding.filter((x) => x.done).length}/{onboarding.length}</h2>
          <ol>
            {onboarding.map((x) => (
              <li class:list={{ 'is-done': x.done }}><a href={x.href}><strong>{x.label}</strong><span>{x.why}</span></a></li>
            ))}
          </ol>
        </section>
      )}

      {manageList && manageList.length > 0 && (
        <section class="qg-card ac-card ac-manage" aria-labelledby="ac-manage">
          <h2 id="ac-manage">À gérer · {manageList.length}</h2>
          <ul class="me-todo">
            {manageList.map((x) => (
              <li class="ac-manage__row"><a href={x.href}><strong>{x.label}</strong><span>{x.why}</span></a>
                {x.relance && (
                  <form method="post" action="/api/equipe/outils"><input type="hidden" name="action" value="relance" /><input type="hidden" name="training" value={x.relance} /><input type="hidden" name="back" value={`/equipe/?r=${roster!.slug}`} />
                    <button class="btn btn--ghost" title="Oni Bot les mentionne dans le salon planning du roster (une fois toutes les 3 h au plus)">Relancer sur Discord</button></form>
                )}
              </li>
            ))}
          </ul>
          {Astro.url.searchParams.has('relance') && <p class="ac-empty">Relance envoyée : Oni Bot la poste dans le salon planning d’ici une minute.</p>}
        </section>
      )}

      <div class="ac-grid">
        <section class="qg-card ac-card">
          <h2>Ta semaine</h2>
          <ul class="ac-todo">
            <li class:list={{ 'is-done': data.pending === 0 }}><a href={`/equipe/planning/${q}`}>{data.pending === 0 ? 'Toutes tes séances ont une réponse' : `${data.pending} séance${data.pending > 1 ? 's' : ''} sans ta réponse`}</a></li>
            <li class:list={{ 'is-done': data.dispos }}><a href={`/equipe/planning/${q}#dispos-${roster.id}`}>{data.dispos ? 'Tes dispos de la semaine sont cochées' : 'Coche tes dispos de la semaine'}</a></li>
          </ul>
          {data.events.length > 1 && (
            <ol class="ac-next">
              {data.events.slice(1).map((e) => (
                <li><time datetime={new Date(e.at).toISOString()}>{fShort.format(new Date(e.at))}</time><span>{e.title}</span><small>{e.type === 'match' ? 'Match' : 'Séance'}</small></li>
              ))}
            </ol>
          )}
          <a class="ac-more" href={`/equipe/calendrier/${q}`}>Voir le calendrier</a>
        </section>

        <section class="qg-card ac-card">
          <h2>Forme de la semaine</h2>
          {data.form.some((f) => f.n > 0) ? (
            <ul class="ac-form">
              {data.form.map((f) => (
                <li>
                  <span class="ac-form__name">{f.m.name}</span>
                  <span class="ac-form__bar" aria-hidden="true"><span style={`width:${(f.n / maxForm) * 100}%`}></span></span>
                  <span class="ac-form__n">{f.n} partie{f.n > 1 ? 's' : ''}{f.wins !== null && f.n ? ` · ${Math.round((f.wins / f.n) * 100)} %` : ''}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="ac-empty">Pas encore de parties suivies cette semaine. Relie ton compte de jeu dans ton profil pour apparaître ici.</p>
          )}
          {data.last && <p class="ac-last">Dernier résultat : <strong class:list={{ 'is-win': data.last.us > data.last.them }}>{data.last.us}-{data.last.them}</strong> contre {data.last.opponent}, le {fShort.format(new Date(data.last.at))}</p>}
          <a class="ac-more" href={`/equipe/stats/${q}`}>Toutes les stats</a>
        </section>

        <section class="qg-card ac-card">
          <h2>Objectifs en cours</h2>
          {data.goals.length ? (
            <ul class="ac-goals">
              {data.goals.map((x) => (
                <li>
                  <p><strong>{x.title}</strong>{x.who && <small>{x.who}</small>}{x.due && <small>avant le {fShort.format(new Date(x.due))}</small>}</p>
                  <span class="ac-goals__bar" role="progressbar" aria-label={x.title} aria-valuemin="0" aria-valuemax="100" aria-valuenow={x.progress}><span style={`width:${x.progress}%`}></span></span>
                </li>
              ))}
            </ul>
          ) : <p class="ac-empty">Aucun objectif en cours. Fixez-en un pour la semaine.</p>}
          <a class="ac-more" href={`/equipe/objectifs/${q}`}>Gérer les objectifs</a>
        </section>

        <section class="qg-card ac-card">
          <h2>Ça a bougé</h2>
          {data.activity.length ? (
            <ul class="ac-activity">
              {data.activity.map((a) => <li><a href={a.href}><small>{a.kind}</small><span>{a.title}</span><time datetime={new Date(a.at).toISOString()}>{ago(a.at)}</time></a></li>)}
            </ul>
          ) : <p class="ac-empty">Rien de neuf. Lancez un tableau ou un doc pour le roster.</p>}
          <div class="ac-shortcuts">
            <a class="btn btn--ghost" href={`/equipe/tactique/${q}`}>Tableau blanc</a>
            {g.tool && <a class="btn btn--ghost" href={`${g.tool[0]}${q}`}>{g.tool[1]}</a>}
            <a class="btn btn--ghost" href={`/equipe/notes/${q}`}>Notes de match</a>
          </div>
        </section>
      </div>
    </div>
  )}
</Qg>

<script is:inline>
  // Anciens liens (Discord, agenda) vers l'ancienne page d'accueil : séance, dispos, roster → Planning
  if (/^#(seance|dispos|roster)-/.test(location.hash)) location.replace('/equipe/planning/' + location.search + location.hash);
</script>

