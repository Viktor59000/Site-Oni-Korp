  .me-trial h2 { margin: 0; font-family: var(--font-body); font-size: 1rem; }
  .me-trial p { margin: 0; }
  .me-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: var(--space-5, 1.5rem) var(--space-6, 2rem); align-items: start; }
