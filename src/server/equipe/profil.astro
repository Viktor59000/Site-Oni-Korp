---
// Profil d'un joueur : rosters, rangs, mesures en jeu par jeu, tendances, objectifs, présence, débriefs et setups.
// Visible par le joueur, ses coéquipiers et l'encadrement. Par défaut : mon profil.
import Qg from './Qg.astro';
import { canLead, teamUser } from './outils';
import { access } from './access';
import { rows } from '../db';
import { links, TIERS_FR, valoIcons, valoTierFr } from './stats';
import { avg, pct, r1, spark, SHARED_CSS } from './ui';

export const prerender = false;
const t = await teamUser(Astro.cookies);
if (!t) return Astro.redirect('/equipe/');
const { me, user } = t;
const uid = Astro.url.searchParams.get('u') ?? user.id;
const target = uid === user.id ? me : await access(uid);
// Accès : soi-même, l'encadrement, ou un coéquipier (au moins un roster en commun)
const shared = target.rosterIds.some((id) => me.rosterIds.includes(id));
if (!target.member || !(uid === user.id || me.staff || shared)) return Astro.redirect('/equipe/profil/');
const [m] = await rows<{ name: string; avatar: string }>('SELECT name, avatar FROM guild_members WHERE id = ?', uid);
// Poste dans chaque roster (Jungle, Mid…) : « Jungle · Lion Blanc »
const postes = new Map<number, string>((await rows<{ roster_id: number; poste: string }>('SELECT roster_id, poste FROM roster_postes WHERE user_id = ?', uid).catch(() => [])).map((x) => [Number(x.roster_id), x.poste] as [number, string]));
const DAY = 86400_000;
// Page Staff du site : la case n'apparaît que sur son propre profil, pour qui a une fonction (encadrement, contenu, communauté)
const hasFunction = uid === user.id && (me.staff || me.games.length > 0 || me.captain || me.analyst || me.content.length > 0);
const [pub] = hasFunction ? await rows<{ visible: number; bio: string | null }>('SELECT visible, bio FROM staff_public WHERE user_id = ?', uid).catch(() => []) : [];
// Essais en cours ou terminés (décision du 06/10) : le retour écrit est visible par la recrue, et par qui gère le roster
type Essai = { roster_id: number; name: string; statut: string; essai_fin: number | null; retour: string | null; at: number };
const essais = (await rows<Essai>(`SELECT s.roster_id, r.name, s.statut, s.essai_fin, s.retour, s.at FROM roster_status s JOIN rosters r ON r.id = s.roster_id
  WHERE s.user_id = ? AND (s.statut = 'essai' OR s.retour IS NOT NULL)`, uid).catch(() => [] as Essai[])).filter((e) => uid === user.id || canLead(me, e.roster_id));
const fDate = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', timeZone: 'Europe/Paris' });
const accounts = await rows<{ game: string; ident: string; region: string | null }>('SELECT game, ident, region FROM accounts WHERE user_id = ?', uid);
const acc = (g: string) => accounts.find((a) => a.game === g);
const cache = async (k: string) => JSON.parse((await rows<{ value: string }>('SELECT value FROM stats_cache WHERE key = ?', k))[0]?.value ?? 'null');
const hist = await rows<{ game: string; value: string }>('SELECT game, value FROM rank_history WHERE user_id = ? AND day >= ? ORDER BY day', uid, new Date(Date.now() - 120 * DAY).toISOString().slice(0, 10));
const perfs = await rows<{ game: string; data: string; at: number }>('SELECT game, data, at FROM perf WHERE user_id = ? AND at > ? ORDER BY at DESC', uid, Date.now() - 60 * DAY);
const games = (g: string) => perfs.filter((p) => p.game === g).slice(0, 20).map((p) => JSON.parse(p.data));
const riot = acc('riot');
const lolRank = riot ? await cache(`lol:${riot.region ?? 'euw'}:${riot.ident.toLowerCase()}`) : null;
const valoRank = riot ? await cache(`valo:${riot.ident.toLowerCase()}`) : null;
const osuSt = acc('osu') ? await cache(`osu:${acc('osu')!.ident.toLowerCase()}`) : null;
const lol = games('lol'), valo = games('valo'), rl = games('rl'), osu = games('osu');
const win = (g: any[]) => (g.length ? (g.filter((x) => x.win).length / g.length) * 100 : null);
const valoIcon = await valoIcons();
const lolTier = lolRank && lolRank.tier !== 'UNRANKED' ? lolRank.tier : null;
const cards = [
  lol.length || lolRank ? { key: 'lol', title: 'League of Legends',
    rank: lolTier ? `${TIERS_FR[lolTier] ?? lolTier} ${lolRank.rank ?? ''}`.trim() : lolRank ? 'Non classé' : null, sub: lolTier ? `${lolRank.lp} LP` : null,
    emblem: lolTier ? `/img/rangs/lol/${lolTier.toLowerCase()}.webp` : null,
    trend: spark(hist.filter((h) => h.game === 'lol').map((h) => JSON.parse(h.value).score), { w: 140, h: 36 }),
    groups: [
      ['Résultats', [['Parties', String(lol.length)], ['Victoires', pct(win(lol))]]],
      ['Combat', [['KDA', r1(lol.length ? lol.reduce((s, x) => s + x.k + x.a, 0) / Math.max(1, lol.reduce((s, x) => s + x.d, 0)) : null, 2)], ['Participation', pct(avg(lol.map((x) => x.kp)))]]],
      ['Farm et vision', [['CS / min', r1(avg(lol.map((x) => x.csMin)))], ['Vision / min', r1(avg(lol.map((x) => x.visionMin)), 2)]]],
    ] } : null,
  valo.length || valoRank ? { key: 'valo', title: 'Valorant',
    rank: valoRank?.tier ? valoTierFr(valoRank.tier) : null, sub: valoRank?.rr !== null && valoRank?.rr !== undefined ? `${valoRank.rr} RR` : null,
    emblem: valoRank?.tier ? valoIcon[String(valoRank.tier).toUpperCase()] ?? null : null,
    trend: spark(hist.filter((h) => h.game === 'valo').map((h) => JSON.parse(h.value).score), { w: 140, h: 36 }),
    groups: [
      ['Résultats', [['Parties', String(valo.length)], ['Victoires', pct(win(valo))]]],
      ['Impact', [['ACS', r1(avg(valo.map((x) => x.acs)), 0)], ['ADR', r1(avg(valo.map((x) => x.adr)), 0)], ['First bloods', r1(avg(valo.map((x) => x.fb)))]]],
      ['Visée', [['Headshots', pct(avg(valo.map((x) => x.hs).filter((v: number | null) => v !== null)))]]],
    ] } : null,
  rl.length ? { key: 'rl', title: 'Rocket League', rank: null, sub: null, emblem: null,
    trend: spark(rl.slice().reverse().map((x) => x.score), { w: 140, h: 36 }),
    groups: [
      ['Résultats', [['Parties', String(rl.length)], ['Victoires', pct(win(rl))], ['Score moyen', r1(avg(rl.map((x) => x.score)), 0)]]],
      ['Placement', [['Derrière la balle', pct(avg(rl.map((x) => x.derriere)))], ['Supersonique', pct(avg(rl.map((x) => x.supersonique)))]]],
      ['Boost', [['Boost / min', r1(avg(rl.map((x) => x.bpm)), 0)]]],
    ] } : null,
  osu.length || osuSt ? { key: 'osu', title: 'osu!',
    rank: osuSt?.rank ? `#${osuSt.rank.toLocaleString('fr-FR')}` : osuSt ? 'Pas encore classé' : null, sub: osuSt?.pp ? `${osuSt.pp.toLocaleString('fr-FR')} pp` : null, emblem: null,
    trend: spark(hist.filter((h) => h.game === 'osu').map((h) => JSON.parse(h.value).rank), { w: 140, h: 36, invert: true }),
    groups: [
      ['Précision', [['Globale', osuSt ? `${String(osuSt.acc).replace('.', ',')} %` : '—'], ['Récente', osu.length ? `${r1(avg(osu.map((x) => x.acc)), 2)} %` : '—']]],
      ['Activité', [['Parties (60 j)', String(osu.length)], ['Heures de jeu', osuSt?.hours ? String(osuSt.hours) : '—']]],
    ] } : null,
].filter(Boolean) as { key: string; title: string; rank: string | null; sub: string | null; emblem: string | null; trend: string; groups: [string, [string, string][]][] }[];

// Présence (90 jours) sur les séances de ses rosters
const rIds = target.rosterIds;
const done = rIds.length ? await rows<{ id: number }>(`SELECT id FROM trainings WHERE cancelled = 0 AND roster_id IN (${rIds.map(() => '?').join(',')}) AND at BETWEEN ? AND ?`, ...rIds, Date.now() - 90 * DAY, Date.now()) : [];
const att = done.length ? await rows<{ status: string }>(`SELECT status FROM attendance WHERE user_id = ? AND training_id IN (${done.map(() => '?').join(',')})`, uid, ...done.map((d) => d.id)) : [];
const presence = done.length ? Math.round((att.filter((a) => a.status === 'present').length / done.length) * 100) : null;
const goals = await rows<{ title: string; status: string; progress: number; due: number | null }>(`SELECT title, status, progress, due FROM goals WHERE user_id = ? ORDER BY status = 'en-cours' DESC, updated_at DESC LIMIT 8`, uid).catch(() => []);
const [deb] = await rows<{ n: number; avg: number }>('SELECT COUNT(*) AS n, AVG(rating) AS avg FROM match_notes WHERE user_id = ?', uid);
const setups = await rows<{ game: string; data: string }>('SELECT game, data FROM setups WHERE user_id = ?', uid);
// Inhouses de la saison en cours : Elo et bilan par mode
const IH_LABEL: Record<string, string> = { 'rl-1v1': 'RL 1v1', 'rl-2v2': 'RL 2v2', 'rl-3v3': 'RL 3v3', 'lol-5v5': 'LoL 5v5', 'valo-5v5': 'Valorant 5v5', 'osu-1v1': 'osu! 1v1', 'osu-2v2': 'osu! 2v2' };
const [ihSeason] = await rows<{ value: string }>(`SELECT value FROM meta WHERE key = 'inhouse_season'`);
const inhouses = await rows<{ mode: string; rating: number; wins: number; losses: number; best: number }>(
  'SELECT mode, rating, wins, losses, best FROM inhouse_elo WHERE user_id = ? AND season = ? AND wins + losses > 0 ORDER BY rating DESC', uid, Number(ihSeason?.value) || 1);
// Débriefs automatiques LoL du joueur : note par match, du plus récent au plus ancien
const debriefs = (await rows<{ data: string; opponent: string; at: number }>(`SELECT s.data, m.opponent, m.at FROM match_stats s JOIN matches m ON m.id = s.match_id
  WHERE s.user_id = ? AND s.data LIKE '%lol-debrief%' ORDER BY m.at DESC LIMIT 10`, uid).catch(() => [])).map((d) => {
  const g = (JSON.parse(d.data).games ?? []) as { note: number; champ: string; k: number; d: number; a: number }[];
  return { opponent: d.opponent, at: Number(d.at), note: g.length ? Math.round(g.reduce((s2, x) => s2 + x.note, 0) / g.length) : null, champs: g.map((x) => `${x.champ} ${x.k}/${x.d}/${x.a}`).join(' · ') };
}).filter((d) => d.note !== null);
const GAME_LABEL: Record<string, string> = { rl: 'Rocket League', lol: 'League of Legends', valo: 'Valorant', osu: 'osu!' };
const fmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', timeZone: 'Europe/Paris' });
---
<Qg title={`${m?.name ?? 'Profil'} · Inside`} heading={m?.name ?? 'Profil'} lead={target.rosters.filter((r) => target.rosterIds.includes(Number(r.id))).map((r) => (postes.get(Number(r.id)) ? `${postes.get(Number(r.id))} · ${r.name}` : r.name)).join('  /  ') || (target.staff ? 'Encadrement' : 'Membre')} current="profil" rosters={me.rosters} staff={me.staff || me.games.length > 0} contenu={me.staff || me.content.length > 0} user={{ name: t.me.member?.name ?? t.user.name, avatar: t.me.member?.avatar ?? t.user.avatar }}>
    {m?.avatar && <img class="pf-avatar" slot="actions" src={m.avatar} alt="" width="72" height="72" crossorigin="anonymous" referrerpolicy="no-referrer" />}
    <div class="pf">
      <ul class="pf-kpis">
        <li><b>{presence === null ? '—' : `${presence} %`}</b><span>Présence aux séances (90 j)</span></li>
        <li><b>{goals.filter((g) => g.status === 'en-cours').length}</b><span>Objectifs en cours</span></li>
        <li><b>{Number(deb?.n ?? 0)}</b><span>Débriefs écrits{Number(deb?.n ?? 0) ? ` · ${r1(Number(deb.avg))}/10 en moyenne` : ''}</span></li>
      </ul>

      <div class="pf-accounts">
        <p>Comptes</p>
        <div class="pf-links">
          {riot && <a href={links.opgg(riot.ident, riot.region ?? 'euw')!} rel="noopener" target="_blank">op.gg</a>}
          {riot && <a href={links.valo(riot.ident)!} rel="noopener" target="_blank">Tracker Valorant</a>}
          {acc('rl') && <a href={links.rl(acc('rl')!.ident)} rel="noopener" target="_blank">Tracker RL</a>}
          {acc('osu') && <a href={links.osu(acc('osu')!.ident)} rel="noopener" target="_blank">osu!</a>}
          {acc('osu') && <a href={links.osutrack(acc('osu')!.ident)} rel="noopener" target="_blank">osu!track</a>}
          {!accounts.length && <span>{uid === user.id ? <a href="/equipe/joueurs/">Relier mes comptes de jeu</a> : 'Aucun compte relié'}</span>}
        </div>
      </div>

      {essais.length > 0 && (
        <section class="pf-essai">
          <h2 class="pf-h">{uid === user.id ? 'Ton essai' : 'Essai'}</h2>
          {essais.map((e) => (
            <article>
              <p><b>{e.name}</b> · {e.statut === 'essai' ? (e.essai_fin ? `en essai jusqu’au ${fDate.format(new Date(Number(e.essai_fin)))}` : 'en essai') : e.statut === 'titulaire' ? 'titulaire' : 'remplaçant'}</p>
              {e.retour
                ? <blockquote>{e.retour}</blockquote>
                : <p class="pf-muted">{uid === user.id ? 'Le retour de l’encadrement s’affichera ici à la fin de l’essai. Tu recevras aussi un message privé d’Oni Bot.' : 'Retour pas encore écrit (Inside > Joueurs).'}</p>}
            </article>
          ))}
        </section>
      )}

      {cards.length ? (
        <div class="pf-games">
          {cards.map((c) => (
            <section class={`pf-game g-${c.key}`}>
              <header class="pf-game__head">
                <h2>{c.title}</h2>
                {c.rank ? (
                  <div class="pf-game__rank">
                    {c.emblem && <img src={c.emblem} alt="" width="88" height="88" loading="lazy" referrerpolicy="no-referrer" />}
                    <div><strong>{c.rank}</strong>{c.sub && <span>{c.sub}</span>}</div>
                  </div>
                ) : <p class="pf-game__norank">Rang pas encore relevé</p>}
                {c.trend && <div class="pf-game__trend"><span set:html={c.trend} /><small>Tendance du rang</small></div>}
              </header>
              {c.groups.map(([t, items]) => (
                <div class="pf-block">
                  <p>{t}</p>
                  <dl>{items.map(([l, v]) => <div class:list={{ 'is-empty': v === '—' }}><dd>{v}</dd><dt>{l}</dt></div>)}</dl>
                </div>
              ))}
            </section>
          ))}
        </div>
      ) : <p class="eq-note">Pas encore de mesures en jeu. {uid === user.id && <>Relie tes comptes dans <a href="/equipe/joueurs/">Joueurs</a> : rangs et parties arrivent dans les 30 minutes.</>}</p>}

      {debriefs.length > 0 && (
        <section class="pf-deb">
          <h2 class="pf-h">Débriefs LoL · moyenne {Math.round(debriefs.reduce((s2, d) => s2 + d.note!, 0) / debriefs.length)}/100</h2>
          <ol class="pf-deb__list">
            {debriefs.map((d) => (
              <li><span class="pf-deb__bar" style={`--n:${d.note}%`}></span><b>{d.note}</b><span>vs {d.opponent} · {fmt.format(new Date(d.at))}</span><small>{d.champs}</small></li>
            ))}
          </ol>
        </section>
      )}

      {inhouses.length > 0 && (
        <section class="pf-deb">
          <h2 class="pf-h">Inhouses · saison {Number(ihSeason?.value) || 1}</h2>
          <ul class="pf-ih">
            {inhouses.map((e) => (
              <li><span>{IH_LABEL[e.mode] ?? e.mode}</span><b>{Number(e.rating)}</b><small>{Number(e.wins)} V · {Number(e.losses)} D · record {Number(e.best)}</small></li>
            ))}
          </ul>
          <p class="eq-note"><a href="/inhouses/">Classement complet</a></p>
        </section>
      )}

      {hasFunction && (
        <section class="pf-pub">
          <h2 class="pf-h">Page Staff du site</h2>
          <form method="post" action="/api/equipe/outils">
            <input type="hidden" name="action" value="staff-public" /><input type="hidden" name="back" value="/equipe/profil/" />
            <label class="pf-chk"><input type="checkbox" name="visible" value="1" checked={!!Number(pub?.visible ?? 0)} /> Apparaître sur <a href="/staff/">la page Staff</a> (pseudo, avatar Discord, fonctions, ce que tu as fait pour le club)</label>
            <label>Une phrase sur toi <small>(140 caractères, facultatif)</small><input name="bio" maxlength="140" value={pub?.bio ?? ''} placeholder="Ex. : caste le RL depuis 2022, fan de rotations propres" /></label>
            <button class="btn btn--ghost">Enregistrer</button>
          </form>
        </section>
      )}

      <div class="pf-cols">
        <section>
          <h2 class="pf-h">Objectifs</h2>
          {goals.length ? <ul class="pf-goals">{goals.map((g) => (
            <li class={`is-${g.status}`}><strong>{g.title}</strong><span>{g.status === 'atteint' ? 'Atteint' : g.status === 'abandonne' ? 'Abandonné' : `${g.progress} %${g.due ? ` · avant le ${fmt.format(new Date(Number(g.due)))}` : ''}`}</span><i style={`--p:${g.status === 'atteint' ? 100 : g.progress}%`}></i></li>
          ))}</ul> : <p class="eq-note">Aucun objectif pour l'instant.</p>}
        </section>
        <section>
          <h2 class="pf-h">Setups</h2>
          {setups.length ? setups.map((s) => { const d = JSON.parse(s.data); return (
            <div class="pf-setup"><p><strong>{GAME_LABEL[s.game]}</strong>{s.game === 'valo' && Number(d.dpi) && Number(d.sens) ? ` · ${Math.round(Number(d.dpi) * Number(d.sens))} eDPI` : ''}</p>
              <p class="eq-note">{Object.entries(d).filter(([k]) => k !== 'viseur').slice(0, 6).map(([k, v]) => `${k} ${v}`).join(' · ')}</p></div>
          ); }) : <p class="eq-note">Pas encore rempli. <a href="/equipe/setup/">Setups</a></p>}
        </section>
      </div>
    </div>
</Qg>

<style set:html={SHARED_CSS}></style>
<style>
  .eq-mini { padding-block: 2.5rem 1.5rem; }
  .pf-head .wrap { display: flex; align-items: center; gap: 1.25rem; }
  .pf-head img { border-radius: 50%; background: var(--line); }
  .pf-head h1 { font-size: clamp(2rem, 6vw, 3.5rem); }
  .pf-head p { margin-top: .3rem; }
  .eq-note { color: var(--muted); font-size: var(--step--1); }
  .pf { display: grid; gap: 2rem; }
  .pf-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: .75rem; }
  .pf-kpis li { display: grid; gap: .2rem; padding: 1rem; border: 1px solid var(--line); border-top: 3px solid var(--ink); }
  .pf-kpis b { font-family: var(--font-display); font-size: 1.7rem; }
  .pf-kpis span { color: var(--muted); font-size: var(--step--1); }
  .g-rl { --g: #2f6bff; } .g-lol { --g: #0f8a9b; } .g-valo { --g: #ff4655; } .g-osu { --g: #ff66aa; }
  .pf-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 2rem; }
  .pf-deb { margin-bottom: 2rem; }
  .pf-essai { display: grid; gap: .75rem; }
  .pf-essai article { padding: .9rem 1rem; border: 1px solid var(--line); border-left: 4px solid var(--lacquer); display: grid; gap: .5rem; }
  .pf-essai blockquote { margin: 0; white-space: pre-line; line-height: 1.5; }
  .pf-essai .pf-muted { color: var(--muted); font-size: .9rem; }
  .pf-pub form { display: grid; gap: .6rem; max-width: 36rem; }
  .pf-pub label { display: grid; gap: .25rem; font-weight: 700; font-size: .9rem; }
  .pf-pub label.pf-chk { display: flex; align-items: flex-start; gap: .5rem; font-weight: 400; }
  .pf-pub small { font-weight: 400; color: var(--muted); }
  .pf-pub input[name=bio] { padding: .45rem .6rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: 400 .9rem var(--font-body); }
  .pf-pub .btn { width: fit-content; }
  .pf-ih { list-style: none; margin: 0 0 .5rem; padding: 0; display: flex; flex-wrap: wrap; gap: .75rem; }
  .pf-ih li { display: grid; gap: .15rem; min-width: 140px; padding: .7rem .9rem; border: 1px solid var(--line); border-radius: 0; }
  .pf-ih b { font-family: var(--font-display); font-weight: 400; font-size: 1.6rem; }
  .pf-ih span, .pf-ih small { color: var(--muted); font-size: .85rem; }
  .pf-deb__list { display: grid; gap: .35rem; margin: 0; padding: 0; list-style: none; }
  .pf-deb__list li { display: grid; grid-template-columns: 8rem 3rem 1fr; gap: .2rem .8rem; align-items: center; }
  .pf-deb__list small { grid-column: 3; color: var(--muted); }
  .pf-deb__bar { height: .55rem; border-radius: 0; background: linear-gradient(90deg, #0f8a9b var(--n), var(--line) var(--n)); }
  .pf-deb__list b { font-family: var(--font-display); font-weight: 400; }
  .pf-h { font-family: var(--font-body); font-size: 1rem; font-weight: 700; padding-bottom: .5rem; border-bottom: 2px solid var(--ink); margin-bottom: .7rem; }
  .pf-goals { display: grid; gap: .5rem; }
  .pf-goals li { display: grid; gap: .2rem; padding: .6rem .8rem; border: 1px solid var(--line); }
  .pf-goals span { color: var(--muted); font-size: var(--step--1); }
  .pf-goals i { display: block; height: .35rem; background: linear-gradient(90deg, var(--lacquer) var(--p), var(--line) var(--p)); }
  .pf-goals .is-atteint i { background: #1f8f55; }
  .pf-setup { padding: .6rem 0; border-bottom: 1px solid var(--line); }
  .pf-setup p { margin: 0; }
</style>
