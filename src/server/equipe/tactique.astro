---
// Tableau blanc du roster (tous les jeux) : un fond (carte du jeu, tableau blanc, quadrillage ou image),
// des éléments (repères, agents, champions, pings), des formes, des flèches, des post-it, le crayon par-dessus,
// des étapes pour dérouler une strat et des notes. Synchronisé en quasi direct pour tout le roster.
import Qg from './Qg.astro';
import { scope, teamUser } from './outils';
import { ensureBoards } from './tableau-api';
import { rows } from '../db';

export const prerender = false;
const t = await teamUser(Astro.cookies);
if (!t) return Astro.redirect('/equipe/');
const { me, user } = t;
await ensureBoards();
const sc = scope(me.rosters, Astro.url);
// Pas de tableau blanc pour osu! : un roster osu! est renvoyé vers son outil
if (sc.active && sc.list[0]?.game === 'osu') return Astro.redirect(`/equipe/osu/?r=${sc.active}`);
const usable = sc.list.filter((r) => r.game !== 'osu');
const boardId = Number(Astro.url.searchParams.get('b')) || null;
type B = { id: number; roster_id: number; game: string; map: string; title: string; updated_at: number; name: string | null };
const list = usable.length ? await rows<B>(`SELECT b.id, b.roster_id, b.game, b.map, b.title, b.updated_at, g.name FROM boards b LEFT JOIN guild_members g ON g.id = b.updated_by
  WHERE b.roster_id IN (${usable.map(() => '?').join(',')}) ORDER BY b.updated_at DESC`, ...usable.map((r) => r.id)) : [];
const current = boardId ? list.find((b) => Number(b.id) === boardId) : null;
// État du tableau envoyé avec la page : personne ne part d'un tableau vide (et ne l'écrase) avant la première synchro
const initial = current ? (await rows<{ state: string; updated_at: number }>('SELECT state, updated_at FROM boards WHERE id = ?', current.id))[0] : null;
const rosterName = new Map(me.rosters.map((r) => [Number(r.id), r.name]));
const rosterGame = new Map(me.rosters.map((r) => [Number(r.id), r.game]));
const q = sc.active ? `&r=${sc.active}` : '';
const listUrl = `/equipe/tactique/${sc.active ? `?r=${sc.active}` : ''}`;
const ago = (ms: number) => { const m = Math.round((Date.now() - ms) / 60_000); return m < 1 ? 'à l\'instant' : m < 60 ? `il y a ${m} min` : m < 2880 ? `il y a ${Math.round(m / 60)} h` : `il y a ${Math.round(m / 1440)} j`; };
const BG_LABEL = (m: string) => m === 'Faille' || m.startsWith('Faille:') ? 'Faille de l\'invocateur' : m === 'Terrain' ? 'Terrain Rocket League' : m === 'blanc' ? 'Tableau blanc' : m === 'grille' ? 'Quadrillage' : m.startsWith('http') ? 'Image' : m;
const COLORS = ['#ff4655', '#2f6bff', '#ffd23f', '#2fbf71', '#ffffff', '#111111'];
const TOOLS: [string, string, string][] = [
  ['select', 'Sélection', 'M4 3l14 8-6 2-2 6z'], ['pen', 'Crayon', 'M4 20l4-1 11-11-3-3L5 16z'], ['arrow', 'Flèche', 'M4 20L19 5M19 5h-7M19 5v7'],
  ['line', 'Ligne', 'M4 20L20 4'], ['rect', 'Rectangle', 'M4 6h16v12H4z'], ['circle', 'Cercle', 'M12 4a8 8 0 100 16 8 8 0 000-16z'],
  ['zone', 'Zone (fumée, contrôle…)', 'M12 3a9 9 0 100 18 9 9 0 000-18zM8 12h8'], ['note', 'Post-it', 'M5 4h14v11l-5 5H5z'], ['text', 'Texte', 'M5 5h14M12 5v14'],
  ['erase', 'Gomme', 'M16 4l4 4-10 10H6l-2-2z'],
];
// Sur la Faille, deux vraies balises avec leur portée (900 unités, à l'échelle de la carte) ; ailleurs un repère de vision générique
const VISION: [string, string, string][] = current?.game === 'lol' ? [['ward', '◉', 'Balise (portée)'], ['controle', '◉', 'Balise de contrôle (portée)']] : [['vision', '◉', 'Vision']];
const PINGS: [string, string, string][] = [['danger', '!', 'Danger'], ['objectif', '★', 'Objectif'], ['question', '?', 'À vérifier'], ...VISION, ...(current?.game === 'lol' ? [] : [['balle', '●', current?.game === 'valo' ? 'Spike' : 'Balle'] as [string, string, string]])];
---
<Qg title="Tableau blanc · Inside" heading="Tableau blanc" lead="Carte, éléments, crayon, post-it et étapes : la strat se construit à plusieurs, en direct." current="tactique" rosters={me.rosters} staff={me.staff || me.games.length > 0} contenu={me.staff || me.content.length > 0} active={sc.active} user={{ name: t.me.member?.name ?? t.user.name, avatar: t.me.member?.avatar ?? t.user.avatar }}>
  {!current && usable.length > 0 && (
    <details class="qg-drawer" slot="actions">
      <summary class="btn">+ Nouveau tableau</summary>
      <div class="qg-drawer__panel" role="dialog" aria-label="Nouveau tableau">
        <div class="qg-drawer__head"><h2>Nouveau tableau</h2><button type="button" class="qg-close" aria-label="Fermer" onclick="this.closest('details').open = false">×</button></div>
          <form method="post" action="/api/equipe/outils" class="tb-new" data-new>
            
            <input type="hidden" name="action" value="tableau" /><input type="hidden" name="back" value={listUrl} />
            <input type="hidden" name="game" data-game />
            <label>Titre<input name="title" required maxlength="60" placeholder="Ex. : Ascent · retake B, kickoff, plan de jeu" /></label>
            <label>Roster<select name="roster" data-roster>{usable.map((r) => <option value={r.id} data-g={r.game}>{r.name}</option>)}</select></label>
            <label>Fond<select name="map" data-bg>
              <optgroup label="Neutre"><option value="blanc">Tableau blanc</option><option value="grille">Quadrillage</option></optgroup>
              <optgroup label="Rocket League" data-for="rl"><option value="Terrain">Terrain</option></optgroup>
              <optgroup label="League of Legends" data-for="lol"><option value="Faille">Faille de l'invocateur</option></optgroup>
              <optgroup data-for="valo" label="Valorant" data-valo></optgroup>
              <optgroup label="Autre"><option value="url">Image (lien)…</option></optgroup>
            </select></label>
            <label data-url hidden>Lien de l'image<input name="url" type="url" placeholder="https://…" /></label>
            <button class="btn">Créer et ouvrir</button>
          </form>
      </div>
    </details>
  )}
    {!current ? (
      <div class="tb-home">
        {!usable.length && <p class="eq-note">Aucun roster pour l'instant : le tableau blanc s'ouvrira dès la création d'un roster sur Discord.</p>}
        {list.length > 0 && (
          <section class="tb-list">
            <h2>Tableaux du roster</h2>
            <ul>
              {list.map((b) => (
                <li><a href={`/equipe/tactique/?b=${b.id}${q}`}><strong>{b.title}</strong><span>{BG_LABEL(b.map)} · {rosterName.get(Number(b.roster_id))} · modifié {ago(Number(b.updated_at))}{b.name ? ` par ${b.name}` : ''}</span></a></li>
              ))}
            </ul>
          </section>
        )}
      </div>
    ) : (
      <div class="wb" data-board={current.id} data-game={rosterGame.get(Number(current.roster_id)) ?? current.game} data-map={current.map} data-me={user.id} data-state={initial?.state ?? '{}'} data-at={initial?.updated_at ?? 0}>
        <div class="wb-bar">
          <a class="wb-back" href={listUrl}>← Tableaux</a>
          <h2>{current.title}</h2>
          <p class="wb-live" data-live><span aria-hidden="true"></span><em>En direct</em></p>
          <div class="wb-export">
            <button type="button" class="btn" data-present>Présenter</button>
            <button type="button" class="btn btn--ghost" data-copy-img title="Copie l'étape en image : colle-la directement dans Discord">Copier l'image</button>
            <button type="button" class="btn btn--ghost" data-download>Télécharger</button>
          </div>
        </div>
        <div class="wb-present-bar" data-present-bar hidden>
          <button type="button" data-prev aria-label="Étape précédente">←</button>
          <strong data-present-title></strong>
          <button type="button" data-next aria-label="Étape suivante">→</button>
          <button type="button" data-exit>Quitter (Échap)</button>
        </div>
        <aside class="wb-present-notes" data-present-notes hidden></aside>

        <div class="wb-frames" data-frames></div>

        <div class="wb-tools" role="toolbar" aria-label="Outils">
          <div class="wb-group">
            {TOOLS.map(([k, label, d], i) => <button type="button" data-tool={k} aria-pressed={i === 0 ? 'true' : 'false'} title={label} aria-label={label}><svg viewBox="0 0 24 24"><path d={d} /></svg></button>)}
          </div>
          <div class="wb-group wb-colors">{COLORS.map((c, i) => <button type="button" data-color={c} aria-pressed={i === 0 ? 'true' : 'false'} style={`--c:${c}`} aria-label={`Couleur ${c}`}></button>)}</div>
          <div class="wb-group">{[[3, 'Fin'], [6, 'Moyen'], [12, 'Épais']].map(([w, l], i) => <button type="button" data-width={w} aria-pressed={i === 1 ? 'true' : 'false'} title={String(l)} aria-label={`Trait ${l}`}><span style={`height:${Number(w) / 2 + 1}px`}></span></button>)}</div>
          <div class="wb-group">
            <button type="button" data-undo title="Annuler (Ctrl+Z)" aria-label="Annuler"><svg viewBox="0 0 24 24"><path d="M9 7L4 12l5 5M4 12h11a5 5 0 010 10h-3" /></svg></button>
            <button type="button" data-redo title="Rétablir (Ctrl+Y)" aria-label="Rétablir"><svg viewBox="0 0 24 24"><path d="M15 7l5 5-5 5M20 12H9a5 5 0 000 10h3" /></svg></button>
            <button type="button" data-clear-ink>Effacer le crayon</button>
            <button type="button" data-clear>Vider l'étape</button>
          </div>
        </div>

        <div class="wb-main">
          <div class="wb-left">
          <div class="wb-zoom" role="group" aria-label="Zoom">
            <button type="button" data-zoom="out" aria-label="Dézoomer">−</button><output data-zoom-level>100 %</output><button type="button" data-zoom="in" aria-label="Zoomer">+</button><button type="button" data-zoom="fit">Ajuster</button>
            <small>Ctrl + molette pour zoomer, glisser avec le clic du milieu pour se déplacer</small>
          </div>
          <div class="wb-viewport" data-viewport>
          <div class="wb-stage" data-stage data-game={current?.game ?? ''}>
            <div class="wb-bg" data-bg></div>
            <img class="wb-bush" data-bush alt="" hidden />
            <svg class="wb-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" data-svg>
              <defs>{COLORS.map((c) => <marker id={`ah${c.slice(1)}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill={c} /></marker>)}</defs>
              <g data-layer></g>
            </svg>
            <div class="wb-items" data-items></div>
            <p class="wb-hint" data-hint hidden></p>
          </div>
          </div>
          </div>

          <aside class="wb-side">
            <details open><summary>Éléments</summary>
              <div class="wb-markers" style={`--n:${({ rl: 3, osu: 2 } as Record<string, number>)[current.game] ?? 5}`}>
                {/* Autant de pions que de joueurs : 3 en Rocket League, 2 en osu! (tag), 5 en LoL et Valorant */}
                {(current.game === 'lol' ? ['T', 'J', 'M', 'B', 'S'] : Array.from({ length: ({ rl: 3, osu: 2 } as Record<string, number>)[current.game] ?? 5 }, (_, k) => String(k + 1))).map((n) => <button type="button" data-add="ally" data-label={n} class="is-ally" aria-label={`Allié ${n}`}>{n}</button>)}
                {(current.game === 'lol' ? ['T', 'J', 'M', 'B', 'S'] : Array.from({ length: ({ rl: 3, osu: 2 } as Record<string, number>)[current.game] ?? 5 }, (_, k) => String(k + 1))).map((n) => <button type="button" data-add="enemy" data-label={n} class="is-enemy" aria-label={`Adversaire ${n}`}>{n}</button>)}
              </div>
              <div class="wb-pings">
                {PINGS.map(([k, s, l]) => <button type="button" data-add="ping" data-ref={k} data-label={s}><span class={`is-${k}`}>{s}</span>{l}</button>)}
              </div>
              <p class="wb-pal-h" data-pal-title hidden></p>
              <input type="search" placeholder="Chercher" data-pal-search aria-label="Chercher" hidden />
              <div class="wb-pal" data-pal></div>
            </details>
            <details open><summary>Notes de la strat</summary>
              <textarea data-notes rows="8" maxlength="5000" placeholder="Le plan, les appels, qui fait quoi… Visible par tout le roster."></textarea>
            </details>
            <details class="wb-towers" data-towers-panel hidden><summary>Structures</summary>
              <p class="eq-note">Clique une tour ou un inhibiteur sur la carte pour le marquer détruit (outil Sélection). Propre à chaque étape.</p>
              <label class="wb-check"><input type="checkbox" data-towers-show checked /> Afficher les structures</label>
              <div class="wb-tower-btns"><button type="button" data-towers="up">Tout debout</button><button type="button" data-towers="100">Côté bleu tombé</button><button type="button" data-towers="200">Côté rouge tombé</button></div>
            </details>
            <details><summary>Fond</summary>
              <select data-bg-select aria-label="Fond"></select>
              <label class="wb-check" data-look-wrap hidden><input type="checkbox" data-look /> Carte réaliste</label>
              <label class="wb-check" data-bush-wrap hidden><input type="checkbox" data-bush-show checked /> Buissons</label>
              <label class="wb-baron" data-baron-wrap hidden>Fosse du Nashor<select data-baron><option value="1">Chasse</option><option value="2">Observation</option><option value="3">Territoire</option></select></label>
              <p class="eq-note">Change le fond pour tout le monde. « Image » : colle le lien d'une capture ou d'un schéma.</p>
            </details>
            <p class="eq-note wb-help">Sélection : glisser pour déplacer, double-clic sur un post-it ou un texte pour le modifier, Suppr pour retirer. Ctrl+Z / Ctrl+Y.{current?.game === 'lol' && <> Carte vectorielle et buissons : <a href="https://map.riftkit.net/" rel="noopener" target="_blank">RiftKit</a> (Coach Kirei), merci à lui.</>}</p>
          </aside>
        </div>

        <form method="post" action="/api/equipe/outils" class="wb-del" onsubmit="return confirm('Supprimer ce tableau pour tout le roster ?')">
          <input type="hidden" name="action" value="suppr" /><input type="hidden" name="table" value="boards" /><input type="hidden" name="id" value={current.id} /><input type="hidden" name="back" value={listUrl} />
          <button class="wb-link">Supprimer ce tableau</button>
        </form>
      </div>
    )}
</Qg>

<script src="./tactique.client.ts"></script>

<style>
  .eq-mini { padding-block: 2.5rem 1.5rem; }
  .eq-mini h1 { font-size: clamp(2rem, 6vw, 3.5rem); }
  .eq-note { color: var(--muted); font-size: var(--step--1); }
  .tb-home { display: grid; gap: 2.5rem; }
  .tb-new { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 1rem; align-items: end; padding: 1.25rem; border: 1px solid var(--line); }
  .tb-new h2, .tb-list h2 { grid-column: 1 / -1; font-family: var(--font-body); font-size: 1rem; font-weight: 700; }
  .tb-new label { display: grid; gap: .3rem; font-weight: 700; font-size: .85rem; }
  .tb-new label[hidden] { display: none; }
  .tb-new :is(input, select) { width: 100%; box-sizing: border-box; min-height: 42px; padding: .4rem .6rem; border: 1px solid var(--line); background: var(--paper); color: var(--ink); font: 400 .95rem var(--font-body); }
  .tb-new .btn { justify-self: start; }
  .tb-list ul { display: grid; gap: .5rem; margin-top: .75rem; }
  .tb-list a { display: grid; gap: .2rem; padding: .8rem 1rem; border: 1px solid var(--line); color: inherit; text-decoration: none; }
  .tb-list a:hover { border-color: var(--ink); }
  .tb-list span { color: var(--muted); font-size: var(--step--1); }

  .wb-bar { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: .6rem; }
  .wb-bar h2 { font-size: var(--step-1); }
  .wb-back { color: var(--muted); font-weight: 700; }
  .wb-live { margin: 0 0 0 auto; display: flex; align-items: center; gap: .4rem; font-size: .82rem; font-weight: 700; color: #1f8f55; }
  .wb-live em { font-style: normal; }
  .wb-live span { width: .55rem; height: .55rem; border-radius: 50%; background: currentColor; }
  .wb-live.is-off { color: var(--muted); }
  .wb-frames { display: flex; flex-wrap: wrap; gap: .3rem; margin-bottom: .6rem; }
  .wb-frames :global(button) { min-height: 34px; padding: 0 .8rem; border: 1.5px solid var(--line); background: none; color: var(--ink); font: 700 .8rem var(--font-body); cursor: pointer; }
  .wb-frames :global(button[aria-pressed="true"]) { background: var(--ink); color: var(--surface); border-color: var(--ink); }
  .wb-frames :global([data-frame-add]), .wb-frames :global([data-frame-del]), .wb-frames :global([data-frame-rename]) { border-style: dashed; color: var(--muted); }
  .wb-tools { display: flex; flex-wrap: wrap; gap: .5rem .9rem; align-items: center; padding: .5rem; border: 1px solid var(--line); margin-bottom: .75rem; background: var(--qg-bg, var(--surface)); position: sticky; top: 56px; z-index: 20; box-shadow: 0 6px 12px -8px rgb(0 0 0 / .5); }
  .wb-group { display: flex; flex-wrap: wrap; gap: .25rem; align-items: center; }
  .wb-group + .wb-group { padding-left: .9rem; border-left: 1px solid var(--line); }
  .wb-tools button { min-width: 38px; min-height: 38px; padding: 0 .5rem; border: 1.5px solid transparent; background: none; color: var(--ink); font: 700 .78rem var(--font-body); cursor: pointer; display: grid; place-items: center; }
  .wb-tools button:hover { border-color: var(--line); }
  .wb-tools button[aria-pressed="true"] { background: var(--ink); color: var(--surface); }
  .wb-tools svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .wb-colors button { min-width: 26px; min-height: 26px; width: 26px; height: 26px; padding: 0; border-radius: 50%; background: var(--c); border: 2px solid var(--line); }
  .wb-colors button[aria-pressed="true"] { background: var(--c); outline: 3px solid var(--ink); outline-offset: 1px; }
  .wb-group [data-width] span { display: block; width: 18px; background: currentColor; border-radius: 0; }
  .wb-main { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: 1rem; align-items: start; }
  /* La carte tient entière dans l'écran : sa taille suit la hauteur disponible, pas seulement la largeur */
  .wb-stage { position: relative; aspect-ratio: 1; max-width: 100%; margin-inline: auto; width: min(100%, calc((100vh - 15rem) * var(--ratio, 1))); min-width: min(100%, 18rem); border: 1px solid var(--line); touch-action: none; user-select: none; overflow: hidden; background: #0f1923; }
  .wb-stage[data-tool="pen"], .wb-stage[data-tool="arrow"], .wb-stage[data-tool="line"], .wb-stage[data-tool="rect"], .wb-stage[data-tool="circle"], .wb-stage[data-tool="zone"] { cursor: crosshair; }
  .wb-stage[data-tool="note"], .wb-stage[data-tool="text"] { cursor: text; }
  .wb-stage[data-tool="erase"] { cursor: not-allowed; }
  /* Glisser-déposer depuis la palette */
  .wb :global([data-add]) { cursor: grab; -webkit-touch-callout: none; user-select: none; -webkit-user-select: none; }
  .wb :global([data-add] img) { -webkit-user-drag: none; pointer-events: none; }
  .wb-stage:global(.is-drop) { outline: 3px solid var(--qg-focus, #156b85); outline-offset: -3px; }
  :global(.wb-ghost) { position: fixed; left: 0; top: 0; z-index: 100; margin: -20px 0 0 -20px; pointer-events: none; opacity: .85; cursor: grabbing; }
  :global(.wb-ghost img) { display: block; width: 40px; height: 40px; border-radius: 50%; }
  .wb-bg { position: absolute; inset: 0; background: #0f1923 center / contain no-repeat; }
  .wb-bg.is-blank { background-color: #fbfaf7; }
  .wb-bg.is-grid { background-color: #fbfaf7; background-image: linear-gradient(#e3e0d8 1px, transparent 1px), linear-gradient(90deg, #e3e0d8 1px, transparent 1px); background-size: 5% 5%; }
  .wb-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .wb-left { min-width: 0; }
  .wb-zoom { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin-bottom: .5rem; font-size: .8rem; }
  .wb-zoom button { min-width: 32px; height: 32px; padding: 0 .5rem; border: 1px solid var(--line); background: none; color: var(--ink); font: 700 .9rem var(--font-body); cursor: pointer; }
  .wb-zoom button:hover { border-color: var(--ink); }
  .wb-zoom output { min-width: 3.5rem; text-align: center; font-variant-numeric: tabular-nums; }
  .wb-zoom small { color: var(--muted); }
  /* Fenêtre de la carte : défile quand on zoome */
  .wb-viewport { overflow: hidden; max-height: calc(100vh - 12rem); }
  .wb-viewport.is-zoomed { overflow: auto; border: 1px solid var(--line); }
  .wb-viewport.is-zoomed .wb-stage { max-width: none; margin-inline: 0; }
  .wb-bush { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .wb-svg :global(polyline) { fill: none; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .wb-svg :global(.wb-shape) { vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .wb-svg :global(.wb-shape.is-sel) { filter: drop-shadow(0 0 3px #fff) drop-shadow(0 0 3px #000); }
  .wb-items { position: absolute; inset: 0; pointer-events: none; }
  .wb-items :global(> *) { position: absolute; transform: translate(-50%, -50%); pointer-events: auto; }
  .wb-stage:is([data-tool="pen"], [data-tool="arrow"], [data-tool="line"], [data-tool="rect"], [data-tool="circle"], [data-tool="zone"]) .wb-items :global(> *) { pointer-events: none; }
  .wb-items :global(.is-sel) { outline: 3px solid #ffd23f; outline-offset: 2px; }
  .wb-items :global(.wb-tok) { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font: 700 .85rem var(--font-body); color: #fff; border: 2px solid #fff; box-shadow: 0 2px 6px rgb(0 0 0 / .5); cursor: grab; background: #0f1923; overflow: hidden; }
  .wb-items :global(.wb-tok img) { width: 100%; height: 100%; object-fit: cover; }
  .wb-items :global(.wb-tok.is-ally) { background: #2f6bff; } .wb-items :global(.wb-tok.is-enemy) { background: #e5251f; }
  .wb-items :global(.wb-ping), .wb-pings span { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font: 700 .9rem var(--font-body); color: #111; background: #ffd23f; border: 2px solid #111; }
  .wb-items :global(.wb-ping) { cursor: grab; }
