---
// Vue d'ensemble (encadrement) : état du club en un écran. Santé de chaque roster, alertes à traiter,
// candidatures et messages en attente, état d'Oni Bot. Chaque carte mène à l'environnement du roster.
import Qg from './Qg.astro';
import { rosterMembers, teamUser } from './outils';
import { rows } from '../db';
import { JEUX } from './jeux';
import { CAMPAIGN, QUESTIONS } from '../sondage-questions';

export const prerender = false;
const t = await teamUser(Astro.cookies);
if (!t) return Astro.redirect('/equipe/');
const { me } = t;
if (!(me.staff || me.games.length || me.mod)) return Astro.redirect('/equipe/');
// Responsable d'un jeu : seulement son jeu (rosters, candidatures, recrues, matchs) ; le reste du club est pour l'encadrement
// Espace jeu (07/10) : ?jeu=<rl|lol|valo|osu> filtre tout l'écran sur un jeu ; un responsable d'un seul jeu y arrive directement
const asked = Astro.url.searchParams.get('jeu');
const focus = asked && asked in JEUX && (me.staff || me.mod || me.games.includes(asked)) ? asked : !me.staff && !me.mod && me.games.length === 1 ? me.games[0] : null;
const mineGame = (g: string | null | undefined) => (focus ? g === focus : me.staff || me.mod || (!!g && me.games.includes(g)));
const tabs = (me.staff || me.mod ? Object.keys(JEUX) : me.games).filter((g) => g in JEUX);
const shown = me.rosters.filter((r) => !focus || r.game === focus);

const now = Date.now(), DAY = 86400_000;
const ago = (ms: number) => { const m = Math.round((now - ms) / 60_000); return m < 60 ? `${m} min` : m < 2880 ? `${Math.round(m / 60)} h` : `${Math.round(m / 1440)} j`; };
const fmt = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris' });
const GAMES: Record<string, { label: string; color: string }> = {
  rl: { label: 'Rocket League', color: '#2f6bff' }, lol: { label: 'League of Legends', color: '#0f8a9b' },
  valo: { label: 'Valorant', color: '#ff4655' }, osu: { label: 'osu!', color: '#ff66aa' },
};

// Club
const meta = Object.fromEntries((await rows<{ key: string; value: string }>(`SELECT key, value FROM meta WHERE key IN ('bot:heartbeat', 'bot:version', 'club:stats')`)).map((r) => [r.key, r.value]));
const beat = Number(meta['bot:heartbeat'] ?? 0);
const botOnline = now - beat < 3 * 60_000;
const stats = meta['club:stats'] ? JSON.parse(meta['club:stats']) : null;
const guildId = process.env.DISCORD_GUILD_ID ?? '';
const tickets = (await rows<{ thread_id: string; kind: string; game: string; opened_at: number; name: string | null }>(
  `SELECT t.thread_id, t.kind, t.game, t.opened_at, g.name FROM tickets t LEFT JOIN guild_members g ON g.id = t.user_id WHERE t.closed_at IS NULL AND t.kind IN ('joueur', 'staff') ORDER BY t.opened_at`)).filter((x) => mineGame(x.game));
// Recrues en parcours d'arrivée (Oni Bot) : comptes, guide, dispos, setup, premier message
const recruits = (await rows<{ user_id: string; game: string | null; started_at: number; name: string | null; acc: number; guide: number; dispo: number; setup: number; msg: number }>(
  `SELECT r.user_id, r.game, r.started_at, g.name,
     EXISTS(SELECT 1 FROM accounts a WHERE a.user_id = r.user_id) AS acc,
     EXISTS(SELECT 1 FROM meta m WHERE m.key = 'guide:' || r.user_id) AS guide,
     EXISTS(SELECT 1 FROM availability v WHERE v.user_id = r.user_id) AS dispo,
     EXISTS(SELECT 1 FROM setups s WHERE s.user_id = r.user_id) AS setup,
     COALESCE((SELECT messages FROM levels l WHERE l.user_id = r.user_id), 0) > 0 AS msg
   FROM recruits r LEFT JOIN guild_members g ON g.id = r.user_id WHERE r.done_at IS NULL ORDER BY r.started_at`).catch(() => [])).filter((x) => mineGame(x.game));
const support = !me.staff ? [] : await rows<{ thread_id: string; game: string; opened_at: number; name: string | null }>(
  `SELECT t.thread_id, t.game, t.opened_at, g.name FROM tickets t LEFT JOIN guild_members g ON g.id = t.user_id WHERE t.closed_at IS NULL AND t.kind = 'support' ORDER BY t.opened_at`);
const MOTIF: Record<string, string> = { question: 'Question', probleme: 'Problème avec un membre', partenariat: 'Partenariat', bot: 'Bot ou site', autre: 'Autre', reexamen: 'Réexamen d’une sanction' };
const [contacts] = me.staff ? await rows<{ n: number }>(`SELECT COUNT(*) AS n FROM contacts WHERE status = 'nouveau'`) : [{ n: 0 }];
const upcoming = (await rows<{ id: number; opponent: string; at: number; kind: string | null; caster: string | null; signup_by: number | null; roster: string | null; game: string | null }>(
  `SELECT m.id, m.opponent, m.at, m.kind, m.caster, m.signup_by, r.name AS roster, r.game FROM matches m LEFT JOIN rosters r ON r.id = m.roster_id
   WHERE m.cancelled = 0 AND m.score_us IS NULL AND m.at > ? AND m.at < ? ORDER BY m.at`, now, now + 21 * DAY)).filter((x) => mineGame(x.game));

// Rosters
const cards = await Promise.all(shown.map(async (r) => {
  const members = await rosterMembers(r.role_id);
  const [next] = await rows<{ id: number; at: number; kind: string }>('SELECT id, at, kind FROM trainings WHERE roster_id = ? AND cancelled = 0 AND at > ? ORDER BY at LIMIT 1', r.id, now);
  const nextAnswers = next ? (await rows<{ n: number }>('SELECT COUNT(*) AS n FROM attendance WHERE training_id = ?', next.id))[0] : null;
  const [week] = await rows<{ n: number }>('SELECT COUNT(*) AS n FROM trainings WHERE roster_id = ? AND cancelled = 0 AND at BETWEEN ? AND ?', r.id, now, now + 7 * DAY);
  const done = await rows<{ id: number }>('SELECT id FROM trainings WHERE roster_id = ? AND cancelled = 0 AND at BETWEEN ? AND ?', r.id, now - 30 * DAY, now);
  const [pres] = done.length ? await rows<{ p: number }>(`SELECT COUNT(*) AS p FROM attendance WHERE status = 'present' AND training_id IN (${done.map(() => '?').join(',')})`, ...done.map((d) => d.id)) : [{ p: 0 }];
  const rate = done.length && members.length ? Math.round((Number(pres.p) / (done.length * members.length)) * 100) : null;
  const [last] = await rows<{ id: number; opponent: string; us: number; them: number; kind: string | null }>('SELECT id, opponent, score_us AS us, score_them AS them, kind FROM matches WHERE roster_id = ? AND cancelled = 0 AND score_us IS NOT NULL ORDER BY at DESC LIMIT 1', r.id);
  const [debrief] = last ? await rows<{ n: number; avg: number }>('SELECT COUNT(*) AS n, AVG(rating) AS avg FROM match_notes WHERE match_id = ?', last.id) : [null];
  const [linked] = members.length ? await rows<{ n: number }>(`SELECT COUNT(DISTINCT user_id) AS n FROM accounts WHERE user_id IN (${members.map(() => '?').join(',')})`, ...members.map((m) => m.id)) : [{ n: 0 }];

  // Alertes : ce qui mérite une action de l'encadrement
  const alerts: string[] = [];
  // Roster en construction (moins de joueurs qu'une équipe) : seule alerte utile, recruter ; pas de séance ni de remplaçant à réclamer
  const TEAM: Record<string, number> = { rl: 3, lol: 5, valo: 5, osu: 2 };
  const size = TEAM[r.game] ?? 5;
  if (!members.length) alerts.push('Aucun joueur : ajoute-les avec /roster ajouter');
  else if (members.length < size) alerts.push(`En construction : ${members.length}/${size} joueurs. Priorité au recrutement (annonces, talents des inhouses)`);
  else {
    if (!Number(week.n)) alerts.push('Aucune séance prévue dans les 7 jours');
    if (next && Number(next.at) - now < 36 * 3600_000 && Number(nextAnswers?.n ?? 0) < members.length / 2) alerts.push(`Prochaine séance : seulement ${nextAnswers?.n ?? 0}/${members.length} réponses`);
    if (rate !== null && rate < 60) alerts.push(`Présence faible sur 30 jours (${rate} %)`);
    if (last && !Number(debrief?.n ?? 0)) alerts.push(`Pas de débrief du dernier match (vs ${last.opponent})`);
    if (Number(linked.n) < members.length) alerts.push(`${members.length - Number(linked.n)} joueur(s) sans compte de jeu relié`);
    // Remplaçant : aucun membre au statut « remplaçant » (SWOT-ROLES, partie 8)
    const [subs] = await rows<{ n: number }>("SELECT COUNT(*) AS n FROM roster_status WHERE roster_id = ? AND statut = 'remplacant'", r.id).catch(() => [{ n: 0 }]);
    if (!Number(subs?.n ?? 0)) alerts.push('Pas de remplaçant désigné (statut dans Joueurs)');
    // Joueur qui décroche : moins de 50 % de présence sur au moins 3 séances en 30 jours
    if (done.length >= 3) {
      const per = await rows<{ user_id: string; p: number }>(`SELECT user_id, COUNT(*) AS p FROM attendance WHERE status = 'present' AND training_id IN (${done.map(() => '?').join(',')}) GROUP BY user_id`, ...done.map((d) => d.id));
      const low = members.filter((m) => Number(per.find((x) => x.user_id === m.id)?.p ?? 0) / done.length < .5);
      if (low.length) alerts.push(`Présence sous 50 % sur 30 jours : ${low.map((m) => m.name).join(', ')} (le capitaine en parle d'abord)`);
    }
  }
  return { r, g: GAMES[r.game] ?? { label: r.game, color: '#e5251f' }, members, next, nextAnswers: Number(nextAnswers?.n ?? 0), week: Number(week.n), rate, last, debrief, alerts };
}));

// Alertes club
// Deux niveaux : « urgent » (bloque le club ou une échéance proche), « à faire » (action sans urgence)
const clubAlerts: [string, 'urgent' | 'action'][] = [];
// Essais : fin dans les 3 jours, ou terminés sans retour écrit
const essais = await rows<{ user_id: string; essai_fin: number; retour: string | null; name: string | null; roster: string; game: string }>(
  `SELECT s.user_id, s.essai_fin, s.retour, g.name, r.name AS roster, r.game FROM roster_status s JOIN rosters r ON r.id = s.roster_id LEFT JOIN guild_members g ON g.id = s.user_id
   WHERE s.statut = 'essai' AND s.essai_fin IS NOT NULL AND r.archived = 0 AND s.essai_fin < ?`, now + 3 * DAY).catch(() => []);
// Talents des inhouses (chantier 8) : les meilleurs Elo de la saison (au moins 10 parties) qui ne sont dans aucun roster du jeu.
// Une piste pour proposer un essai ; la décision reste à l'encadrement du jeu.
const MODE_GAME: Record<string, string> = { 'rl-1v1': 'rl', 'rl-2v2': 'rl', 'rl-3v3': 'rl', 'lol-5v5': 'lol', 'valo-5v5': 'valo', 'osu-1v1': 'osu', 'osu-2v2': 'osu' };
const MODE_LABEL: Record<string, string> = { 'rl-1v1': 'RL 1v1', 'rl-2v2': 'RL 2v2', 'rl-3v3': 'RL 3v3', 'lol-5v5': 'LoL 5v5', 'valo-5v5': 'Valo 5v5', 'osu-1v1': 'osu! 1v1', 'osu-2v2': 'osu! 2v2' };
const [seasonRow] = await rows<{ value: string }>(`SELECT value FROM meta WHERE key = 'inhouse_season'`).catch(() => []);
const elo = await rows<{ user_id: string; mode: string; rating: number; wins: number; losses: number; name: string | null; roles: string | null }>(
  `SELECT e.user_id, e.mode, e.rating, e.wins, e.losses, g.name, g.roles FROM inhouse_elo e LEFT JOIN guild_members g ON g.id = e.user_id
   WHERE e.season = ? AND e.wins + e.losses >= 10 ORDER BY e.rating DESC`, Number(seasonRow?.value) || 1).catch(() => []);
const allRosters = await rows<{ game: string; role_id: string }>('SELECT game, role_id FROM rosters WHERE archived = 0').catch(() => []);
const talents = Object.keys(MODE_GAME).filter((mode) => mineGame(MODE_GAME[mode])).map((mode) => ({
  mode, label: MODE_LABEL[mode],
  list: elo.filter((e) => e.mode === mode && !allRosters.some((r) => r.game === MODE_GAME[mode] && (e.roles ?? '').includes(`"${r.role_id}"`))).slice(0, 3),
})).filter((x) => x.list.length);

// Sondage des membres (chantier 9) : synthèse pour la direction seulement
const survey = me.staff ? await rows<{ answers: string; name: string | null }>(
  'SELECT s.answers, g.name FROM survey_answers s LEFT JOIN guild_members g ON g.id = s.user_id WHERE s.campaign = ?', CAMPAIGN).catch(() => []) : [];
const sv = survey.map((x) => ({ a: JSON.parse(x.answers) as Record<string, any>, name: x.name }));
const svAvg = (id: string) => { const v = sv.map((x) => x.a[id]).filter((n) => typeof n === 'number'); return v.length ? v.reduce((s, n) => s + n, 0) / v.length : null; };
const nps = (() => { const v = sv.map((x) => x.a.recommande).filter((n) => typeof n === 'number'); return v.length ? Math.round(((v.filter((n) => n >= 9).length - v.filter((n) => n <= 6).length) / v.length) * 100) : null; })();
const svCounts = QUESTIONS.filter((q) => q.type === 'multi' || q.type === 'single').map((q) => ({
  label: q.label, rows: (q as { options: string[] }).options.map((o) => ({ o, n: sv.filter((x) => Array.isArray(x.a[q.id]) ? x.a[q.id].includes(o) : x.a[q.id] === o).length })).filter((r) => r.n).sort((x, y) => y.n - x.n),
}));
const volunteers = sv.filter((x) => Array.isArray(x.a.aider) && x.a.aider.some((v: string) => v !== 'Non merci')).map((x) => `${x.name ?? 'Membre'} (${x.a.aider.filter((v: string) => v !== 'Non merci').join(', ')})`);
const svTexts = sv.flatMap((x) => [x.a.plus, x.a.manque].filter(Boolean)) as string[];

// Tournois repérés dont l'inscription ferme dans moins de 3 jours (chantier 5)
const comps = await rows<{ name: string; signup_by: number; roster: string; game: string }>(
  `SELECT c.name, c.signup_by, r.name AS roster, r.game FROM competitions c JOIN rosters r ON r.id = c.roster_id
   WHERE c.status = 'repere' AND c.signup_by BETWEEN ? AND ?`, now, now + 3 * DAY).catch(() => []);
for (const c of comps.filter((x) => mineGame(x.game))) clubAlerts.push([`Inscription à ${c.name} (${c.roster}) avant ${fmt.format(new Date(Number(c.signup_by)))} (onglet Tournois)`, 'urgent']);
// Tâches de contenu que personne n'a prises, échéance dans moins de 24 h (ou dépassée)
if (me.staff) {
  const [orph] = await rows<{ n: number }>("SELECT COUNT(*) AS n FROM content_tasks WHERE assignee IS NULL AND status = 'a-faire' AND due < ?", now + DAY).catch(() => [{ n: 0 }]);
  if (Number(orph?.n ?? 0)) clubAlerts.push([`${orph.n} tâche(s) de contenu que personne n'a prise(s), échéance sous 24 h (onglet Contenu)`, 'action']);
}
for (const e of essais.filter((x) => mineGame(x.game))) {
  if (Number(e.essai_fin) < now && !e.retour) clubAlerts.push([`Essai de ${e.name ?? 'un joueur'} (${e.roster}) terminé : décide de la suite et écris le retour dans Joueurs`, 'urgent']);
  else if (Number(e.essai_fin) >= now) clubAlerts.push([`Essai de ${e.name ?? 'un joueur'} (${e.roster}) jusqu'au ${fmt.format(new Date(Number(e.essai_fin)))} : prépare le retour`, 'action']);
}
if (!botOnline && me.staff) clubAlerts.push([beat ? `Oni Bot hors ligne depuis ${ago(beat)} : rappels et annonces en pause` : 'Oni Bot pas encore relié à la base', 'urgent']);
for (const m of upcoming) {
  if ((m.kind ?? 'officiel') !== 'scrim' && !m.caster) clubAlerts.push([`Pas de casteur pour vs ${m.opponent} (${fmt.format(new Date(Number(m.at)))})`, 'action']);
  if (m.signup_by && Number(m.signup_by) > now && Number(m.signup_by) - now < 3 * DAY) clubAlerts.push([`Inscription à boucler pour vs ${m.opponent} avant ${fmt.format(new Date(Number(m.signup_by)))}`, 'urgent']);
}
const oldTickets = tickets.filter((x) => now - Number(x.opened_at) > 3 * DAY);
if (oldTickets.length) clubAlerts.push([`${oldTickets.length} candidature(s) ouverte(s) depuis plus de 3 jours`, 'action']);
if (Number(contacts?.n ?? 0)) clubAlerts.push([`${contacts.n} message(s) du formulaire de contact à traiter (salon staff sur Discord)`, 'action']);
---
<Qg title={focus ? `Espace ${JEUX[focus as keyof typeof JEUX].label} · Inside` : "Vue d'ensemble · Inside"} heading={focus ? `Espace ${JEUX[focus as keyof typeof JEUX].label}` : "Vue d'ensemble"}
  lead={focus ? 'Les rosters du jeu, le recrutement, les essais et les matchs : ce qui va, ce qui demande une action.' : 'Tout le club en un écran : ce qui va, ce qui demande une action.'} current="vue" rosters={me.rosters} staff={me.staff || me.games.length > 0} contenu={me.staff || me.content.length > 0} communaute={me.community} user={{ name: t.me.member?.name ?? t.user.name, avatar: t.me.member?.avatar ?? t.user.avatar }}>
    <div class="ov">
      {tabs.length > 0 && (
        <nav class="ov-tabs" aria-label="Espaces de jeu">
          {(me.staff || me.mod) && <a href="/equipe/vue/" aria-current={!focus ? 'page' : undefined}>Tout le club</a>}
          {tabs.map((g) => <a href={`/equipe/vue/?jeu=${g}`} style={`--g:${JEUX[g as keyof typeof JEUX].color}`} aria-current={focus === g ? 'page' : undefined}>{JEUX[g as keyof typeof JEUX].label}</a>)}
        </nav>
      )}
      {focus && shown[0] && <p class="ov-docs">Docs communs à tous les rosters {JEUX[focus as keyof typeof JEUX].label} : <a href={`/equipe/docs/?r=${shown[0].slug}`}>les lire ou en écrire</a> (rubrique Préparer, section « Docs {JEUX[focus as keyof typeof JEUX].label} »).</p>}
      <ul class="ov-kpis">
        <li class:list={{ 'is-ok': botOnline, 'is-ko': !botOnline }}><b>{botOnline ? 'En ligne' : 'Arrêté'}</b><span>Oni Bot {meta['bot:version'] ? `v${meta['bot:version']}` : ''}</span></li>
        <li><b>{stats?.membres ?? '—'}</b><span>membres Discord{stats?.enLigne ? ` · ${stats.enLigne} en ligne` : ''}</span></li>
        <li><b>{shown.length}</b><span>roster{shown.length > 1 ? 's' : ''} actif{shown.length > 1 ? 's' : ''}</span></li>
        <li><b>{tickets.length}</b><span>candidature{tickets.length > 1 ? 's' : ''} ouverte{tickets.length > 1 ? 's' : ''}</span></li>
        <li><b>{upcoming.length}</b><span>match{upcoming.length > 1 ? 's' : ''} sur 3 semaines</span></li>
      </ul>

      <section class="ov-block">
        <h2>À traiter</h2>
        {clubAlerts.length || cards.some((c) => c.alerts.length) ? (
          <ul class="ov-alerts">
            {clubAlerts.sort((x, y) => (x[1] === y[1] ? 0 : x[1] === 'urgent' ? -1 : 1)).map(([a, lvl]) => <li class={`is-${lvl}`}><span class="ov-lvl">{lvl === 'urgent' ? 'Urgent' : 'À faire'}</span>{a}</li>)}
            {cards.filter((c) => c.alerts.length).map((c) => (
              <li class="ov-group" style={`--g:${c.g.color}`}><a href={`/equipe/?r=${c.r.slug}`}>{c.r.name}</a>
                <ul>{c.alerts.map((a) => <li>{a}</li>)}</ul></li>
            ))}
          </ul>
        ) : <p class="ov-calm">Rien à signaler. Tout roule.</p>}
      </section>

      <section class="ov-block">
        <h2>Rosters</h2>
        {cards.length ? (
          <ul class="ov-rosters">
            {cards.map((c) => (
              <li style={`--g:${c.g.color}`}>
                <a class="ov-card" href={`/equipe/?r=${c.r.slug}`}>
                  <header><strong>{c.r.name}</strong><span>{c.g.label}</span>{c.alerts.length > 0 && <em>{c.alerts.length}</em>}</header>
                  <ul class="ov-faces">{c.members.slice(0, 8).map((m) => <li title={m.name}><img src={m.avatar} alt="" width="26" height="26" loading="lazy" crossorigin="anonymous" referrerpolicy="no-referrer" /></li>)}</ul>
                  <dl>
                    <div><dt>Joueurs</dt><dd>{c.members.length}</dd></div>
                    <div><dt>Séances 7 j</dt><dd>{c.week}</dd></div>
                    <div><dt>Présence 30 j</dt><dd>{c.rate === null ? '—' : `${c.rate} %`}</dd></div>
                    <div><dt>Prochaine</dt><dd>{c.next ? `${fmt.format(new Date(Number(c.next.at)))} · ${c.nextAnswers}/${c.members.length}` : '—'}</dd></div>
                    <div><dt>Dernier match</dt><dd>{c.last ? `vs ${c.last.opponent} ${c.last.us}–${c.last.them}${c.debrief && Number(c.debrief.n) ? ` · ${Math.round(Number(c.debrief.avg) * 10) / 10}/10` : ''}` : '—'}</dd></div>
                  </dl>
                </a>
              </li>
            ))}
          </ul>
        ) : <p class="ov-calm">Aucun roster pour l'instant. Crée le premier sur Discord avec <code>/roster creer</code> : il apparaîtra ici avec ses indicateurs.</p>}
      </section>

      <div class="ov-cols">
        <section class="ov-block">
          {me.staff && (<>
            <h2>Sondage des membres</h2>
            {sv.length ? (<>
              <p class="eq-note">{sv.length} réponse{sv.length > 1 ? 's' : ''} · bien-être {svAvg('satisfaction')?.toFixed(1).replace('.', ',') ?? '—'}/5 · recommandation (NPS) {nps ?? '—'}</p>
              <ul class="ov-survey">{svCounts.filter((c) => c.rows.length).map((c) => <li><b>{c.label}</b><span>{c.rows.slice(0, 4).map((r) => `${r.o} ${r.n}`).join(' · ')}</span></li>)}</ul>
              {volunteers.length > 0 && <p class="eq-note"><b>Volontaires pour aider :</b> {volunteers.join(' ; ')}</p>}
              {svTexts.length > 0 && <details><summary>{svTexts.length} commentaire{svTexts.length > 1 ? 's' : ''}</summary><ul class="ov-survey">{svTexts.map((t) => <li>{t}</li>)}</ul></details>}
            </>) : <p class="eq-note">Pas encore de réponse. Lien à partager une fois validé : <a href="/sondage/">/sondage/</a></p>}
          </>)}
          {talents.length > 0 && (<>
            <h2>Talents des inhouses</h2>
            <p class="eq-note">Meilleurs Elo de la saison (10 parties au moins) sans roster dans ce jeu : à inviter en essai ?</p>
            <ul class="ov-talents">
              {talents.map((t) => <li><b>{t.label}</b>{t.list.map((e) => <span>{e.name ?? 'Membre'} · {e.rating} ({e.wins}V {e.losses}D)</span>)}</li>)}
            </ul>
          </>)}
          {recruits.length > 0 && (<>
            <h2>Nouvelles recrues</h2>
            <ul class="ov-list">
              {recruits.map((r) => { const left = [!Number(r.guide) && 'guide', !Number(r.acc) && 'compte', !Number(r.dispo) && 'dispos', !Number(r.setup) && 'setup', !Number(r.msg) && 'premier message'].filter(Boolean); return (
                <li><a href={`/equipe/profil/?u=${r.user_id}`}>{r.name ?? 'Recrue'}</a>
                  <span>{left.length ? `reste : ${left.join(', ')}` : 'presque fini'} · {ago(Number(r.started_at))}</span></li>
              ); })}
            </ul>
          </>)}
          <h2>Candidatures ouvertes</h2>
          {tickets.length ? (
            <ul class="ov-list">
              {tickets.map((c) => (
                <li><a href={`https://discord.com/channels/${guildId}/${c.thread_id}`} rel="noopener">{c.name ?? 'Candidat'}</a>
                  <span>{c.kind === 'joueur' ? GAMES[c.game]?.label ?? c.game : c.game} · {ago(Number(c.opened_at))}</span></li>
              ))}
            </ul>
          ) : <p class="ov-calm">Aucune en attente.</p>}
          {support.length > 0 && (<>
            <h2>Tickets de support</h2>
            <ul class="ov-list">
              {support.map((c) => (
                <li><a href={`https://discord.com/channels/${guildId}/${c.thread_id}`} rel="noopener">{c.name ?? 'Membre'}</a>
                  <span>{MOTIF[c.game] ?? c.game} · {ago(Number(c.opened_at))}</span></li>
              ))}
            </ul>
          </>)}
        </section>
        <section class="ov-block">
          <h2>Prochains matchs</h2>
          {upcoming.length ? (
            <ul class="ov-list">
              {upcoming.map((m) => (
                <li><a href={`/equipe/match/?m=${m.id}`}><strong>vs {m.opponent}</strong></a>
                  <span>{fmt.format(new Date(Number(m.at)))} · {(m.kind ?? 'officiel') === 'scrim' ? 'scrim' : 'public'}{m.roster ? ` · ${m.roster}` : ''}{(m.kind ?? 'officiel') !== 'scrim' ? (m.caster ? ' · casté' : ' · sans casteur') : ''}</span></li>
              ))}
            </ul>
          ) : <p class="ov-calm">Rien de prévu sur 3 semaines.</p>}
        </section>
      </div>
    </div>
</Qg>

