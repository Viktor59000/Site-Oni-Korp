---
// Tracker Valorant : l'analyse complète des parties compétitives de chaque joueur, relevées par Oni Bot (API HenrikDev,
// manche par manche). Par joueur : ce qui ressort (forces et points à travailler, comparés au roster ou à ses 10 parties
// précédentes), duel, ouverture, jeu d'équipe, clutchs et spike, économie, attaque et défense, cartes, agents, dernières
// parties ; puis le roster côte à côte. Stats reste la vue d'ensemble du roster.
import Qg from './Qg.astro';
import { rosterMembers, scope, teamUser } from './outils';
import { rows } from '../db';
import { avg, pct, r1, spark } from './ui';
import { valoTierFr } from './stats';

export const prerender = false;
const t = await teamUser(Astro.cookies);
if (!t) return Astro.redirect('/equipe/');
const { me, user } = t;
const sc = scope(me.rosters, Astro.url, Astro.cookies, (r) => r.game === 'valo');
const valoRosters = sc.list.filter((r) => r.game === 'valo');

const byId = new Map<string, { id: string; name: string; avatar: string | null }>();
for (const r of valoRosters) for (const m of await rosterMembers(String(r.role_id))) byId.set(m.id, m);
if (!byId.has(user.id)) byId.set(user.id, { id: user.id, name: me.member?.name ?? user.name, avatar: me.member?.avatar ?? user.avatar });
const people = [...byId.values()];
const ids = people.map((p) => p.id);
const inIds = ids.map(() => '?').join(',');
const accounts = new Map((await rows<{ user_id: string; ident: string }>(`SELECT user_id, ident FROM accounts WHERE game = 'riot' AND user_id IN (${inIds})`, ...ids)).map((a) => [String(a.user_id), a]));
type G = Record<string, any> & { win: boolean; at: number };
const perf = await rows<{ user_id: string; data: string; at: number }>(`SELECT user_id, data, at FROM perf WHERE game = 'valo' AND user_id IN (${inIds}) ORDER BY at DESC LIMIT 3000`, ...ids);
const games = new Map<string, G[]>(ids.map((id) => [id, []]));
for (const p of perf) { try { games.get(String(p.user_id))?.push({ ...JSON.parse(p.data), at: Number(p.at) }); } catch {} }

const wanted = Astro.url.searchParams.get('j');
const focus = people.find((p) => p.id === wanted) ?? people.find((p) => p.id === user.id)!;
const all = games.get(focus.id) ?? [];
const g = all.slice(0, 20), prev = all.slice(10, 20), last10 = all.slice(0, 10);
const acc = accounts.get(focus.id);
const rankOf = async (ident?: string) => (ident ? JSON.parse((await rows<{ value: string }>('SELECT value FROM stats_cache WHERE key = ?', `valo:${ident.toLowerCase()}`))[0]?.value ?? 'null') : null);
const rank = await rankOf(acc?.ident);
const hist = await rows<{ value: string }>(`SELECT value FROM rank_history WHERE user_id = ? AND game = 'valo' ORDER BY day`, focus.id).catch(() => []);
const fmtD = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
const rankText = (r: any) => (r?.tier ? `${valoTierFr(r.tier)}${r.rr !== null && r.rr !== undefined ? ` · ${r.rr} RR` : ''}` : null);

// Mesures : clé, libellé, décimales, sens (1 haut = mieux, -1 bas = mieux, 0 neutre), unité, aide
type M = [string, string, number, 1 | -1 | 0, string, string];
const sum = (l: G[], k: string) => l.reduce((s, x) => s + (Number(x[k]) || 0), 0);
const has = (l: G[], k: string) => l.filter((x) => x[k] !== undefined && x[k] !== null);
const ratio = (a: number, b: number) => (b ? (a / b) * 100 : null);
// Pourcentages calculés sur l'ensemble des manches (pas la moyenne des pourcentages)
const val = (l: G[], k: string): number | null => {
  if (k === 'win') return l.length ? ratio(l.filter((x) => x.win).length, l.length) : null;
  if (k === 'kd') { const d = sum(l, 'd'); return l.length ? sum(l, 'k') / Math.max(1, d) : null; }
  if (k === 'clutch') { const h = has(l, 'clutchN'); return ratio(sum(h, 'clutchW'), sum(h, 'clutchN')); }
  if (k === 'entryWin') { const h = has(l, 'entries'); return ratio(sum(h, 'entriesWon'), sum(h, 'entries')); }
  if (k === 'pistol') { const h = has(l, 'pistolN'); return ratio(sum(h, 'pistolW'), sum(h, 'pistolN')); }
  if (k === 'atkWin' || k === 'defWin') { const n = k === 'atkWin' ? 'atkN' : 'defN'; const h = has(l, k); return ratio(h.reduce((s, x) => s + (x[k] * x[n]) / 100, 0), sum(h, n)); }
  if (k === 'fbr') { const h = has(l, 'rounds'); return sum(h, 'rounds') ? (sum(h, 'fb') / sum(h, 'rounds')) * 100 : null; }
  if (k === 'fdr') { const h = has(l, 'rounds'); return sum(h, 'rounds') ? (sum(h, 'fd') / sum(h, 'rounds')) * 100 : null; }
  return avg(l.map((x) => x[k]));
};
const GROUPS: { id: string; title: string; lead: string; keys: M[] }[] = [
  { id: 'duel', title: 'Duel', lead: 'Ce que tu fais quand tu prends un fight', keys: [
    ['acs', 'ACS', 0, 1, '', 'score de combat moyen par manche'], ['kd', 'K/D', 2, 1, '', 'kills / morts'], ['adr', 'ADR', 0, 1, '', 'dégâts par manche'],
    ['hs', 'Headshots', 0, 1, '%', 'part des balles à la tête'], ['multi', 'Manches à 3K+', 1, 1, '', 'par partie'], ['recu', 'Dégâts reçus', 0, -1, '', 'par manche'],
  ] },
  { id: 'open', title: 'Ouverture', lead: 'Le premier duel de la manche', keys: [
    ['fbr', 'First bloods', 1, 1, '%', 'manches où tu fais le premier kill'], ['fdr', 'First deaths', 1, -1, '%', 'manches où tu meurs le premier'],
    ['entries', 'Entrées en attaque', 1, 1, '', 'premier kill de la manche en attaque, par partie'], ['entryWin', 'Entrées converties', 0, 1, '%', 'manches gagnées après ton entrée'],
  ] },
  { id: 'team', title: 'Jeu d’équipe', lead: 'Être utile même sans kill', keys: [
    ['kast', 'KAST', 0, 1, '%', 'manches où tu tues, aides, survis ou es échangé'], ['tradedPct', 'Morts échangées', 0, 1, '%', 'ton tueur abattu dans les 5 s'],
    ['tradeKills', 'Kills d’échange', 1, 1, '', 'tu venges un coéquipier dans les 5 s, par partie'], ['a', 'Assists', 1, 1, '', 'par partie'],
    ['utilRound', 'Utilitaires', 1, 1, '', 'compétences lancées par manche'],
  ] },
  { id: 'clutch', title: 'Clutchs et spike', lead: 'Les manches qui se jouent à la fin', keys: [
    ['clutch', 'Clutchs gagnés', 0, 1, '%', 'dernier en vie de ton équipe'], ['clutchN', 'Situations de clutch', 1, 0, '', 'par partie'],
    ['plants', 'Spikes posés', 1, 0, '', 'par partie'], ['defuses', 'Désamorçages', 1, 0, '', 'par partie'],
  ] },
  { id: 'eco', title: 'Économie', lead: 'Ce que tes crédits rapportent', keys: [
    ['dmgPer1000', 'Dégâts pour 1 000 crédits', 0, 1, '', 'rendement de ton équipement'], ['spentRound', 'Dépense par manche', 0, 0, '', 'crédits'],
    ['loadout', 'Équipement moyen', 0, 0, '', 'valeur en début de manche'], ['pistol', 'Pistols gagnés', 0, 1, '%', 'manches 1 et 13'],
  ] },
  { id: 'side', title: 'Attaque et défense', lead: 'Où ton équipe gagne ses manches', keys: [
    ['atkWin', 'Manches gagnées en attaque', 0, 1, '%', ''], ['defWin', 'Manches gagnées en défense', 0, 1, '%', ''],
    ['kprAtk', 'Kills par manche en attaque', 2, 1, '', ''], ['kprDef', 'Kills par manche en défense', 2, 1, '', ''],
  ] },
];
const fmt = (m: M, x: number | null) => (x === null ? '—' : m[4] === '%' ? pct(x) : Math.abs(x) >= 1000 ? Math.round(x).toLocaleString('fr-FR') : r1(x, m[2]));
const others = people.filter((p) => p.id !== focus.id).map((p) => (games.get(p.id) ?? []).slice(0, 20)).filter((l) => l.length);
const rosterVal = (k: string) => avg(others.map((l) => val(l, k)).filter((x): x is number => x !== null));
const rel = (a: number | null, b: number | null) => (a === null || b === null || b === 0 ? null : (a - b) / Math.abs(b));

const scored = GROUPS.flatMap((gr) => gr.keys.filter((m) => m[3] !== 0).map((m) => ({ m, group: gr.title }))).map(({ m, group }) => {
  const mine = val(g, m[0]);
  const ref = others.length ? rosterVal(m[0]) : prev.length >= 5 ? val(prev, m[0]) : null;
  const d = rel(mine, ref);
  return { m, group, me: mine, ref, d: d === null ? null : d * m[3] };
}).filter((x) => x.d !== null && x.me !== null && Math.abs(x.d) >= 0.1);
const strengths = scored.filter((x) => x.d! > 0).sort((a, b) => b.d! - a.d!).slice(0, 3);
const weak = scored.filter((x) => x.d! < 0).sort((a, b) => a.d! - b.d!).slice(0, 3);
const refLabel = others.length ? 'vs roster' : 'vs tes 10 parties d’avant';

const byKey = (l: G[], key: (x: G) => string | null) => { const m = new Map<string, G[]>(); for (const x of l) { const k = key(x); if (k) m.set(k, [...(m.get(k) ?? []), x]); } return m; };
const maps = [...byKey(all.slice(0, 100), (x) => x.map ?? null)].map(([c, l]) => ({ c, n: l.length, win: val(l, 'win'), acs: val(l, 'acs'), atk: val(l, 'atkWin'), def: val(l, 'defWin') })).sort((a, b) => b.n - a.n);
const agents = [...byKey(all.slice(0, 100), (x) => x.agent ?? null)].map(([c, l]) => ({ c, n: l.length, win: val(l, 'win'), acs: val(l, 'acs'), kast: val(l, 'kast'), kd: val(l, 'kd') })).sort((a, b) => b.n - a.n).slice(0, 8);
const winRate = val(g, 'win');
let streak = 0; for (const x of all) { if (x.win === all[0]?.win) streak++; else break; }
const fresh = g.filter((x) => x.v === 3).length;
const roster = await Promise.all(people.map(async (p) => {
  const l = (games.get(p.id) ?? []).slice(0, 20);
  return { p, n: l.length, rk: await rankOf(accounts.get(p.id)?.ident), win: val(l, 'win'), acs: val(l, 'acs'), kd: val(l, 'kd'), adr: val(l, 'adr'), kast: val(l, 'kast'), fb: val(l, 'fbr') };
}));
// « En faire un objectif » : pour le joueur lui-même ou l'encadrement du roster ; cible = la moyenne de référence
const goalRoster = valoRosters.find((r) => r.mine) ?? valoRosters[0] ?? null;
const canGoal = !!goalRoster && (focus.id === user.id || me.staff || me.lead.includes(Number(goalRoster.id)));
const due = new Date(Date.now() + 28 * 86400_000).toISOString().slice(0, 10);
const here = `${Astro.url.pathname}${Astro.url.search.replace(/[?&]objectif=ok/, '')}`;
const objectifOk = Astro.url.searchParams.get('objectif') === 'ok';
const initial = (s: string) => s.slice(0, 1).toUpperCase();
const link = (j: string) => `/equipe/tracker-valo/?${sc.active ? `r=${sc.active}&` : ''}j=${j}`;
---
<Qg title="Tracker Valorant · Inside" heading="Tracker Valorant" lead="Tes parties compétitives analysées manche par manche : duel, ouverture, équipe, clutchs, économie, côtés. Relevé automatique toutes les 30 minutes." current="valo-tracker" rosters={me.rosters} staff={me.staff || me.games.length > 0} contenu={me.staff || me.content.length > 0} communaute={me.community} active={sc.active} user={{ name: me.member?.name ?? user.name, avatar: me.member?.avatar ?? user.avatar }}>
  <div class="rl">
    {people.length > 1 && (
      <nav class="rl-who" aria-label="Joueur">
        {people.map((p) => (
          <a href={link(p.id)} aria-current={p.id === focus.id ? 'true' : undefined}>
            {p.avatar ? <img src={p.avatar} alt="" width="28" height="28" loading="lazy" /> : <span>{initial(p.name)}</span>}
            {p.name}<small>{(games.get(p.id) ?? []).length || ''}</small>
          </a>
        ))}
      </nav>
    )}

    <section class="rl-head" aria-label="Résumé">
      <div class="rl-id">
        {focus.avatar ? <img src={focus.avatar} alt="" width="64" height="64" /> : <span>{initial(focus.name)}</span>}
        <div><h2>{focus.name}</h2><p>{acc ? acc.ident : 'Riot ID pas encore relié'} · {all.length} partie{all.length > 1 ? 's' : ''} compétitive{all.length > 1 ? 's' : ''}</p></div>
      </div>
      {rank?.tier && (
        <ul class="rl-ranks">
          <li><small>Compétitif</small><b>{rankText(rank)}</b>{rank.elo ? <span>{rank.elo} elo</span> : null}</li>
          {hist.length > 1 && <li><small>Évolution</small><Fragment set:html={spark(hist.map((h) => JSON.parse(h.value).score), { w: 140, h: 34 })} /></li>}
        </ul>
      )}
    </section>

    {!acc && <p class="rl-warn">{focus.id === user.id ? <>Relie ton Riot ID (avec le #TAG) dans <a href={`/equipe/joueurs/${sc.active ? `?r=${sc.active}` : ''}`}>Joueurs</a> : tes parties compétitives arrivent ensuite toutes seules.</> : `${focus.name} n’a pas encore relié son Riot ID.`}</p>}

    {!all.length ? (acc ? <p class="rl-empty">Aucune partie compétitive relevée pour l’instant : le relevé passe toutes les 30 minutes.</p> : null) : (
      <>
        <section class="rl-grid">
          <article class="rl-card">
            <p class="rl-tag">Forme · 20 dernières</p>
            <p class="rl-big">{pct(winRate)} <small>de victoires</small></p>
            <div class="rl-form" aria-label="Résultats, du plus récent au plus ancien">
              {g.map((x) => <span class:list={[x.win ? 'is-w' : 'is-l']} title={`${x.win ? 'Victoire' : 'Défaite'} ${x.us ?? ''}-${x.them ?? ''} · ${x.map ?? ''}`}>{x.win ? 'V' : 'D'}</span>)}
            </div>
            <p class="rl-note">{streak > 1 ? `Série en cours : ${streak} ${all[0].win ? 'victoires' : 'défaites'}` : 'Pas de série en cours'}</p>
          </article>
          <article class="rl-card">
            <p class="rl-tag">Attaque · défense</p>
            <p class="rl-big">{pct(val(g, 'atkWin'))} <small>· {pct(val(g, 'defWin'))}</small></p>
            <p class="rl-note">Manches gagnées par ton équipe en attaque, puis en défense</p>
          </article>
          <article class="rl-card">
            <p class="rl-tag">ACS, partie par partie</p>
            <Fragment set:html={spark(g.slice().reverse().map((x) => Number(x.acs ?? 0)), { w: 260, h: 60 })} />
            <p class="rl-note">Moyenne {r1(val(g, 'acs'), 0)} sur les 20 dernières</p>
          </article>
        </section>

        {objectifOk && <p class="rl-ok">Objectif ajouté : retrouve-le dans <a href={`/equipe/objectifs/${goalRoster ? `?r=${goalRoster.slug}` : ''}`}>Objectifs</a> (privé : toi et l’encadrement).</p>}
        {(strengths.length > 0 || weak.length > 0) && (
          <section class="lt-insight" aria-labelledby="vt-ins">
            <h3 id="vt-ins" class="rl-h">Ce qui ressort <small>20 dernières parties, {refLabel}</small></h3>
            <div class="lt-cols">
              <div>
                <p class="rl-tag">Points forts</p>
                {strengths.length ? <ul>{strengths.map((x) => <li><b>{x.m[1]}</b> : {fmt(x.m, x.me)} <span>({x.group.toLowerCase()}, {fmt(x.m, x.ref)} {refLabel})</span></li>)}</ul> : <p class="rl-note">Rien qui se détache pour l’instant.</p>}
              </div>
              <div>
                <p class="rl-tag">À travailler</p>
                {weak.length ? <ul>{weak.map((x) => <li><b>{x.m[1]}</b> : {fmt(x.m, x.me)} <span>({x.group.toLowerCase()}, {fmt(x.m, x.ref)} {refLabel})</span>{canGoal && (
                  <form method="post" action="/api/equipe/outils" class="lt-goal">
                    <input type="hidden" name="action" value="objectif" /><input type="hidden" name="roster" value={goalRoster!.id} /><input type="hidden" name="user" value={focus.id} />
                    <input type="hidden" name="title" value={`${x.m[1]} : passer de ${fmt(x.m, x.me)} à ${fmt(x.m, x.ref)}`} />
                    <input type="hidden" name="detail" value={`Repéré par le Tracker Valorant le ${new Date().toLocaleDateString('fr-FR', { timeZone: 'Europe/Paris' })} sur les 20 dernières parties (${x.group.toLowerCase()}, ${fmt(x.m, x.ref)} ${refLabel}).`} />
                    <input type="hidden" name="metric" value={JSON.stringify({ g: 'valo', k: x.m[0], s: x.me, t: x.ref, d: x.m[3], u: x.m[4] })} /><input type="hidden" name="due" value={due} /><input type="hidden" name="back" value={`${here}${here.includes('?') ? '&' : '?'}objectif=ok`} />
                    <button class="lt-goal__btn">En faire un objectif</button>
                  </form>
                )}</li>)}</ul> : <p class="rl-note">Rien en dessous du roster : bravo.</p>}
              </div>
            </div>
          </section>
        )}
        {fresh < g.length && <p class="rl-note">{g.length - fresh} partie{g.length - fresh > 1 ? 's' : ''} sans le détail par manche : le bot les complète au fil des relevés.</p>}

        {GROUPS.map((gr) => (
          <section aria-labelledby={`vt-${gr.id}`}>
            <h3 id={`vt-${gr.id}`} class="rl-h">{gr.title} <small>{gr.lead}</small></h3>
            <div class="rl-avgs">
              {gr.keys.map((m) => {
                const x = val(g, m[0]), team = rosterVal(m[0]), d = rel(x, team), before = prev.length >= 5 ? val(prev, m[0]) : null, now = val(last10, m[0]);
                const trend = now !== null && before !== null && before !== 0 ? (now - before) / Math.abs(before) : null;
                return (
                  <div class="rl-avg" title={m[5]}>
                    <small>{m[1]}</small>
                    <b>{fmt(m, x)}</b>
                    {d !== null && Math.abs(d) >= 0.05
                      ? <span class:list={[m[3] === 0 ? 'is-flat' : (d > 0) === (m[3] === 1) ? 'is-up' : 'is-down']}>{d > 0 ? '▲' : '▼'} {Math.round(Math.abs(d) * 100)} % vs roster</span>
                      : trend !== null && Math.abs(trend) >= 0.1 ? <span class:list={[m[3] === 0 ? 'is-flat' : (trend > 0) === (m[3] === 1) ? 'is-up' : 'is-down']}>{trend > 0 ? '▲' : '▼'} sur les 10 dernières</span>
                      : <span class="is-flat">{m[5] || ' '}</span>}
                  </div>
                );
              })}
            </div>
          </section>
        ))}

        <section aria-labelledby="vt-maps">
          <h3 id="vt-maps" class="rl-h">Cartes <small>100 dernières parties</small></h3>
          <div class="rl-scroll">
            <table class="rl-table">
              <thead><tr><th>Carte</th><th>Parties</th><th>Victoires</th><th>ACS</th><th>Attaque</th><th>Défense</th></tr></thead>
              <tbody>{maps.map((x) => <tr><td>{x.c}</td><td>{x.n}</td><td>{pct(x.win)}</td><td>{r1(x.acs, 0)}</td><td>{pct(x.atk)}</td><td>{pct(x.def)}</td></tr>)}</tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="vt-agents">
          <h3 id="vt-agents" class="rl-h">Agents</h3>
          <div class="rl-scroll">
            <table class="rl-table">
              <thead><tr><th>Agent</th><th>Parties</th><th>Victoires</th><th>ACS</th><th>K/D</th><th>KAST</th></tr></thead>
              <tbody>{agents.map((x) => <tr><td>{x.c}</td><td>{x.n}</td><td>{pct(x.win)}</td><td>{r1(x.acs, 0)}</td><td>{r1(x.kd, 2)}</td><td>{pct(x.kast)}</td></tr>)}</tbody>
            </table>
          </div>
        </section>

        <section aria-labelledby="vt-last">
          <h3 id="vt-last" class="rl-h">Dernières parties</h3>
          <div class="rl-scroll">
            <table class="rl-table">
              <thead><tr><th>Quand</th><th>Carte</th><th>Agent</th><th>Résultat</th><th>K/D/A</th><th>ACS</th><th>ADR</th><th>KAST</th><th>FB/FD</th><th>Clutchs</th></tr></thead>
              <tbody>
                {all.slice(0, 25).map((x) => (
                  <tr>
                    <td>{fmtD.format(new Date(x.at))}</td><td>{x.map ?? '—'}</td><td>{x.agent ?? '—'}</td>
                    <td><span class:list={['rl-res', x.win ? 'is-w' : 'is-l']}>{x.win ? 'V' : 'D'} {x.us ?? ''}-{x.them ?? ''}</span></td>
                    <td>{x.k}/{x.d}/{x.a}</td><td>{x.acs}</td><td>{x.adr}</td><td>{x.kast !== undefined ? `${x.kast} %` : '—'}</td><td>{x.fb ?? 0}/{x.fd ?? 0}</td><td>{x.clutchN !== undefined ? `${x.clutchW}/${x.clutchN}` : '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </>
    )}

    {people.length > 1 && (
      <section aria-labelledby="vt-roster">
        <h3 id="vt-roster" class="rl-h">Le roster <small>20 dernières parties de chacun</small></h3>
        <div class="rl-scroll">
          <table class="rl-table">
            <thead><tr><th>Joueur</th><th>Rang</th><th>Parties</th><th>Victoires</th><th>ACS</th><th>K/D</th><th>ADR</th><th>KAST</th><th>First bloods</th></tr></thead>
            <tbody>
              {roster.map((x) => (
                <tr><td><a href={link(x.p.id)}>{x.p.name}</a></td><td>{rankText(x.rk) ?? '—'}</td><td>{x.n}</td><td>{pct(x.win)}</td><td>{r1(x.acs, 0)}</td><td>{r1(x.kd, 2)}</td><td>{r1(x.adr, 0)}</td><td>{pct(x.kast)}</td><td>{pct(x.fb)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </div>
</Qg>

<style>
  .rl { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.25rem; }
  .rl-tag { margin: 0; font: 500 .72rem var(--qg-mono, monospace); letter-spacing: .1em; text-transform: uppercase; color: var(--qg-accent-text, #b3241e); }
  .rl h2 { margin: .25rem 0 .5rem; font: 600 1.4rem/1.2 var(--qg-title, sans-serif); }
