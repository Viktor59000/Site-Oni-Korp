---
// Onglets de l'espace équipe. Les outils propres à un jeu n'apparaissent que si on a un roster de ce jeu (l'encadrement voit tout).
interface Props { current: string; games: string[]; staff: boolean }
const { current, games, staff } = Astro.props;
const has = (g: string) => staff || games.includes(g);
const tabs = [
  ['planning', '/equipe/', 'Planning'],
  ['joueurs', '/equipe/joueurs/', 'Joueurs'],
  ['notes', '/equipe/notes/', 'Notes de match'],
  ...(has('lol') ? [['lol', '/equipe/lol/', 'Drafter LoL']] : []),
  ...(has('valo') ? [['valo', '/equipe/valo/', 'Lineups Valorant']] : []),
];
---
<nav class="eq-tabs" aria-label="Espace équipe">
  <div class="wrap">
    {tabs.map(([k, href, label]) => <a href={href} aria-current={k === current ? 'page' : undefined}>{label}</a>)}
  </div>
</nav>

<style>
  .eq-tabs { border-bottom: 1px solid var(--line); background: var(--surface); position: sticky; top: 69px; z-index: 4; }
  .eq-tabs .wrap { display: flex; gap: .25rem; overflow-x: auto; scrollbar-width: none; }
  .eq-tabs a { flex: none; padding: .9rem 1rem; font-weight: 700; font-size: .92rem; color: var(--muted); text-decoration: none; border-bottom: 3px solid transparent; }
  .eq-tabs a:hover { color: var(--ink); }
  .eq-tabs a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--lacquer); }
</style>
