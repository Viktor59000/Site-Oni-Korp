---
// Mise en page d'Inside : même <head>, mais seulement la base CSS (pas les styles ni les polices du site public :
// Inside n'utilise qu'IBM Plex, déclarée dans qg.css et préchargée par Head)
import '../styles/base.css';
import Head from '../components/Head.astro';
import Avis from '../components/Avis.astro';
---
<!doctype html>
<html lang="fr">
  <Head {...Astro.props} qg />
  <body class="qg">
    <a class="skip" href="#contenu">Aller au contenu</a>
    <slot />
    <Avis variant="inside" />
  </body>
</html>
