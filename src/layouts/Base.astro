---
import '../styles/fonts.css';
import delaLatin from '@fontsource/dela-gothic-one/files/dela-gothic-one-latin-400-normal.woff2?url';
import zen400 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-latin-400-normal.woff2?url';
import zen700 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-latin-700-normal.woff2?url';
import '@fontsource/zen-kaku-gothic-new/latin-400.css';
import '@fontsource/zen-kaku-gothic-new/latin-500.css';
import '@fontsource/zen-kaku-gothic-new/latin-700.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { existsSync } from 'node:fs';
import site from '../data/site.json';
const { qg = false, title, description = "Oni Korp, club esport français né sur Rocket League en 2021. Rosters Rocket League, League of Legends, Valorant et osu!. Recrutement joueurs et staff ouvert." } = Astro.props;
// Image d'aperçu propre à la page (public/og/<page>.jpg, générée par scripts/og.mjs), sinon celle du club
const section = Astro.url.pathname.split('/')[1];
const image = Astro.props.image ?? (section && existsSync(`public/og/${section}.jpg`) ? `/og/${section}.jpg` : '/og.jpg');
const fullTitle = title ? `${title} | Oni Korp` : "Oni Korp | Club esport, jamais à genoux";
const canonical = new URL(Astro.url.pathname, Astro.site);
// URL absolue d'un fichier de public/, base GitHub Pages comprise
const abs = (path) => new URL(path.replace(/^\//, ''), new URL(import.meta.env.BASE_URL, Astro.site)).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {qg && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f3f1ec" />
    <script is:inline>
      // Applique le thème avant l'affichage (pas de flash) : choix mémorisé, sinon réglage du système
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <link rel="preload" href={delaLatin} as="font" type="font/woff2" crossorigin />
    <!-- Police du texte et grain de papier : arrivent tout de suite, la page ne change plus d'aspect après l'affichage -->
    <link rel="preload" href={zen400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={zen700} as="font" type="font/woff2" crossorigin />
    {!qg && <link rel="preload" href="/img/papier-washi.webp" as="image" type="image/webp" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Oni Korp" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(image)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image:alt" content={`${fullTitle} : aperçu`} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'SportsOrganization', name: 'Oni Korp',
      sport: 'Esport', foundingDate: '2021-07-12', url: abs('/'), logo: abs('/apple-touch-icon.png'),
      sameAs: [site.discord, 'https://www.twitch.tv/oni_korp', 'https://x.com/Oni_Korp', 'https://www.tiktok.com/@onikorp_', 'https://www.instagram.com/oni_korp/', 'https://www.youtube.com/@OniKorp_Officiel'],
    })} />
  </head>
  <body class:list={{ qg }}>
    <a class="skip" href="#contenu">Aller au contenu</a>
    {qg ? <slot /> : (
      <>
        <Nav />
        <main id="contenu">
          <slot />
        </main>
        <Footer />
      </>
    )}
  </body>
</html>
