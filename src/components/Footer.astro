---
import site from '../data/site.json';
import Icon from './Icon.astro';
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div>
        <div class="footer__brand"><img src="/img/oni-logo.svg" alt="" width="52" height="52" /><span translate="no">Oni Korp</span></div>
        <p style="margin-top:1rem">Club esport français depuis 2021.<br />Rocket League, LoL, Valorant, osu!.</p>
        <div class="socials">
          {site.socials.map((s) => (
            <a href={s.url} rel="noopener" aria-label={`Oni Korp sur ${s.label}`}><Icon name={s.icon} /></a>
          ))}
        </div>
      </div>
      <div>
        <h2>Le club</h2>
        <ul>
          <li><a href="/club/">Histoire</a></li>
          <li><a href="/effectif/">Légendes</a></li>
          <li><a href="/agenda/">Agenda</a></li>
          <li><a href="/inhouses/">Inhouses</a></li>
          <li><a href="/createurs/">Créateurs</a></li>
        </ul>
      </div>
      <div>
        <h2>Collection</h2>
        <ul>
          <li><a href="/boosters/">Boosters</a></li>
          <li><a href="/vestiaire/">Vestiaire</a></li>
          <li><a href="/marque/">Kit de marque</a></li>
          <li><a href="/partenaires/">Partenaires</a></li>
        </ul>
      </div>
      <div>
        <h2>Rejoindre</h2>
        <ul>
          <li><a href="/recrutement/">Postuler</a></li>
          <li><a href={site.discord} rel="noopener">Discord</a></li>
          <li><a href="/equipe/">Inside</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© {new Date().getFullYear()} Oni Korp. #Oni'sNeverOnKnees</span>
      <a href="/mentions-legales/">Mentions légales</a>
      <button class="theme-toggle" type="button" aria-pressed="false">
        <span class="sr-only">Thème sombre</span>
        <span class="theme-toggle__opt" data-t="light" aria-hidden="true">明</span><span class="theme-toggle__opt" data-t="dark" aria-hidden="true">暗</span>
      </button>
    </div>
  </div>
</footer>
