---
// Visionneuse de vignette : la carte s'envole depuis l'album, se penche sous la souris,
// se retourne au clic ou en la faisant glisser, et l'on feuillette l'album avec les flèches.
const { total } = Astro.props;
---
<dialog class="cv" aria-label="Vignette en grand" data-total={total}>
  <div class="cv__stage">
    <div class="cv__fly">
      <div class="cv__card">
        <div class="cv__face cv__front"></div>
        <div class="cv__face cv__back">
          <div class="cvb">
            <img class="cvb__mark" src="/img/oni-logo.svg" alt="" width="200" height="200" loading="lazy" />
            <p class="cvb__head"><span translate="no">Oni Korp</span><span>Album officiel</span></p>
            <p class="cvb__num"><span class="cvb__n"></span><small>sur {total}</small></p>
            <div class="cvb__body">
              <p class="cvb__name" translate="no"></p>
              <dl class="cvb__meta">
                <div><dt>Rôle</dt><dd class="cvb__role"></dd></div>
                <div><dt>Pôle</dt><dd class="cvb__pole"></dd></div>
                <div class="cvb__team-row"><dt>Équipe</dt><dd class="cvb__team"></dd></div>
              </dl>
            </div>
            <p class="cvb__foot"><em>Oni's never on knees</em><img class="cvb__hanko" src="/img/hanko-oni.webp" alt="" width="320" height="308" loading="lazy" /></p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <p class="cv__hint" aria-hidden="true">Glisse pour tourner · clique pour retourner</p>
  <div class="cv__controls">
    <button class="cv__btn cv__prev" type="button" aria-label="Vignette précédente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
    <button class="cv__btn cv__flip" type="button">Retourner</button>
    <button class="cv__btn cv__next" type="button" aria-label="Vignette suivante"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
  </div>
  <button class="cv__btn cv__close" type="button" aria-label="Fermer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.cv')!;
  const fly = dlg.querySelector<HTMLElement>('.cv__fly')!;
  const card = dlg.querySelector<HTMLElement>('.cv__card')!;
  const front = dlg.querySelector<HTMLElement>('.cv__front')!;
  const back = dlg.querySelector<HTMLElement>('.cv__back')!;
  const $ = (sel: string) => dlg.querySelector<HTMLElement>(sel)!;
  const cards = [...document.querySelectorAll<HTMLElement>('.sticker[data-name]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const POLES: Record<string, string> = { rl: 'Rocket League', lol: 'League of Legends', valo: 'Valorant', osu: 'osu!', staff: 'Staff du club' };

  // Une animation qui ne se termine jamais (onglet en arrière-plan) ne doit pas bloquer la visionneuse
  const done = (a: Animation, ms: number) => Promise.race([a.finished, new Promise((r) => setTimeout(r, ms + 80))]);

  let index = -1;
  // Orientation libre de la carte : une matrice 3D à laquelle on applique chaque petite rotation
  let m = new DOMMatrix();
  let tilt = new DOMMatrix();          // inclinaison au survol, par-dessus
  let vx = 0, vy = 0, spinning = 0, idle = 0;

  const turnBy = (dx: number, dy: number) => {
    const angle = Math.hypot(dx, dy) * 0.5;
    if (angle < 0.01) return;
    m = new DOMMatrix().rotateAxisAngle(-dy, dx, 0, angle).multiply(m);
  };

  const render = () => {
    const t = tilt.multiply(m);
    card.style.transform = t.toString();
    // Normale de la face avant : d'où vient la lumière, et quel côté est visible
    const n = t.transformPoint(new DOMPoint(0, 0, 1, 0));
    const px = Math.min(1, Math.max(0, 0.5 - n.x * 0.6));
    const py = Math.min(1, Math.max(0, 0.5 - n.y * 0.6));
    card.style.setProperty('--px', px.toFixed(3));
    card.style.setProperty('--py', py.toFixed(3));
    card.style.setProperty('--gx', `${(px * 100).toFixed(1)}%`);
    card.style.setProperty('--gy', `${(py * 100).toFixed(1)}%`);
    $('.cv__flip').textContent = n.z < 0 ? 'Voir le recto' : 'Retourner';
  };

  const glow = (on: boolean) => {
    card.style.setProperty('--holo', on ? '1' : '0');
    clearTimeout(idle);
    if (on) idle = window.setTimeout(() => card.style.setProperty('--holo', '0'), 1600);
  };

  // Élan après le lâcher, puis la carte ralentit
  const coast = () => {
    cancelAnimationFrame(spinning);
    const step = () => {
      vx *= 0.94; vy *= 0.94;
      if (Math.hypot(vx, vy) < 0.05) return;
      turnBy(vx, vy); render(); glow(true);
      spinning = requestAnimationFrame(step);
    };
    spinning = requestAnimationFrame(step);
  };

  // Rotation animée (retourner la carte)
  const spin = (deg: number, ms = 600) => {
    cancelAnimationFrame(spinning);
    if (reduce) { m = new DOMMatrix().rotate(0, deg, 0).multiply(m); render(); return; }
    const start = performance.now(), base = m;
    const step = (now: number) => {
      const k = Math.min(1, (now - start) / ms);
      const e = 1 - Math.pow(1 - k, 3);
      m = new DOMMatrix().rotate(0, deg * e, 0).multiply(base);
      render(); glow(true);
      if (k < 1) spinning = requestAnimationFrame(step);
    };
    spinning = requestAnimationFrame(step);
  };

  const reset = () => { cancelAnimationFrame(spinning); vx = vy = 0; m = new DOMMatrix(); tilt = new DOMMatrix(); render(); glow(false); };

  // Remplit le recto (copie de la vignette) et le verso (fiche du joueur)
  const fill = (el: HTMLElement) => {
    const clone = el.cloneNode(true) as HTMLElement;
    clone.querySelector('.sticker__zoom')?.remove();
    // En grand : on demande la version haute définition de l'illustration
    clone.querySelectorAll('img').forEach((img) => { img.loading = 'eager'; if (img.srcset) img.sizes = '(max-width: 720px) 86vw, 440px'; });
    const holo = document.createElement('div');
    holo.className = 'cv__holo';
    const glitter = document.createElement('div');
    glitter.className = 'cv__glitter';
    front.replaceChildren(clone, holo, glitter);
    const d = el.dataset;
    const cs = getComputedStyle(el);
    for (const v of ['--c1', '--c2', '--accent']) back.style.setProperty(v, cs.getPropertyValue(v));
    $('.cvb__n').textContent = String(d.num).padStart(2, '0');
    $('.cvb__name').textContent = d.name ?? '';
    $('.cvb__role').textContent = d.role || (d.pole === 'staff' ? '' : 'Joueur');
    $('.cvb__pole').textContent = POLES[d.pole ?? ''] ?? '';
    const team = d.label && d.label.startsWith('Roster') ? d.label + (d.equipe ? `, équipe ${d.equipe}` : '') : '';
    $('.cvb__team').textContent = team;
    $('.cvb__team-row').hidden = !team;
    dlg.setAttribute('aria-label', `Vignette ${d.num} : ${d.name}`);
  };

  // Vol de la carte entre sa place dans l'album et le centre de l'écran
  const flight = (el: HTMLElement, reverse: boolean) => {
    const from = el.getBoundingClientRect();
    const to = fly.getBoundingClientRect();
    const dx = from.left + from.width / 2 - (to.left + to.width / 2);
    const dy = from.top + from.height / 2 - (to.top + to.height / 2);
    const k = from.width / to.width;
    const start = `translate(${dx}px, ${dy}px) scale(${k}) rotate(-2deg)`;
    const frames = [{ transform: start }, { transform: 'none' }];
    const ms = reverse ? 360 : 520;
    return done(fly.animate(reverse ? frames.reverse() : frames, { duration: ms, easing: 'cubic-bezier(.2,.8,.2,1)', fill: reverse ? 'forwards' : 'none' }), ms);
  };

  const open = async (i: number) => {
    index = i;
    fill(cards[i]);
    reset();
    dlg.showModal();
    if (reduce) return;
    cards[i].style.visibility = 'hidden';
    await flight(cards[i], false);
    cards[i].style.visibility = '';
  };

  const close = async () => {
    if (!dlg.open) return;
    reset();
    const src = cards[index];
    if (!reduce && src) {
      dlg.classList.add('is-closing');
      src.scrollIntoView({ block: 'nearest' });
      src.style.visibility = 'hidden';
      await flight(src, true);
      src.style.visibility = '';
      dlg.classList.remove('is-closing');
    }
    dlg.close();
    fly.getAnimations().forEach((a) => a.cancel());
  };

  const go = (step: number) => {
    index = (index + step + cards.length) % cards.length;
    fill(cards[index]);
    reset();
    if (!reduce) fly.animate([{ transform: `translateX(${step * 60}px) rotate(${step * 4}deg)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 280, easing: 'cubic-bezier(.2,.8,.2,1)' });
  };

  const flip = () => spin(180);

  cards.forEach((el, i) => el.querySelector('.sticker__zoom')?.addEventListener('click', () => open(i)));
  $('.cv__close').addEventListener('click', close);
  $('.cv__flip').addEventListener('click', flip);
  $('.cv__prev').addEventListener('click', () => go(-1));
  $('.cv__next').addEventListener('click', () => go(1));
  dlg.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
  dlg.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') go(-1);
    if (e.key === 'ArrowRight') go(1);
  });
  // Clic sur le fond : fermer
  dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target === $('.cv__stage')) close(); });

  // Glisser : rotation libre dans tous les sens, avec élan. Clic simple : retourner. Survol : légère inclinaison.
  let lastX = 0, lastY = 0, moved = 0, dragging = false;
  card.addEventListener('pointerdown', (e) => {
    cancelAnimationFrame(spinning);
    dragging = true; moved = 0; vx = vy = 0; lastX = e.clientX; lastY = e.clientY;
    tilt = new DOMMatrix();
    card.setPointerCapture(e.pointerId);
    card.classList.add('is-dragging');
  });
  card.addEventListener('pointermove', (e) => {
    if (dragging) {
      const dx = e.clientX - lastX, dy = e.clientY - lastY;
      lastX = e.clientX; lastY = e.clientY;
      moved += Math.hypot(dx, dy);
      vx = dx; vy = dy;
      turnBy(dx, dy); render(); glow(true);
    } else if (e.pointerType === 'mouse' && !reduce) {
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width - 0.5, py = (e.clientY - r.top) / r.height - 0.5;
      tilt = new DOMMatrix().rotate(-py * 18, px * 22, 0);
      render(); glow(true);
    }
  });
  const release = () => {
    if (!dragging) return;
    dragging = false;
    card.classList.remove('is-dragging');
    if (moved < 6) { flip(); return; }
    if (!reduce) coast();
  };
  card.addEventListener('pointerup', release);
  card.addEventListener('pointercancel', release);
  card.addEventListener('pointerleave', () => { if (!dragging) { tilt = new DOMMatrix(); render(); } });
</script>
