---
// Vignette des séries spéciales (moments, garage, partenaires, terrains, vestiaire, légendaires, recrue).
// Même structure que les vignettes joueurs : elles se retournent et brillent de la même façon.
import { existsSync } from 'node:fs';
const { title, sub, img, pos, overlay, logo, bg, wide, kind, num, serie, serieTitre, rarete, art, chest } = Astro.props;
// Illustration de l'album (public/img/cartes/sp-<série>-<n>.webp) dès qu'elle existe ; sinon visuel provisoire
const artSrc = art && existsSync(`public/img/cartes/${art}.webp`) ? `/img/cartes/${art}.webp` : null;
const nameSize = `min(10.5cqi, ${(80 / (title.length * 0.74)).toFixed(2)}cqi)`;
---
<article class="sticker sticker--special" data-pole="special" data-serie={serie} data-rarete={rarete}>
  <div class="sticker__frame">
    <div class="sticker__art">
      {artSrc ? (
        <img src={artSrc} alt="" loading="lazy" width="640" height="960" />
      ) : kind === 'blason' ? (
        <span class="sp-blason"><img src="/img/oni-logo.svg" alt="" width="200" height="200" loading="lazy" /></span>
      ) : kind === 'recrue' ? (
        <span class="sp-recrue" aria-hidden="true">+</span>
      ) : logo ? (
        <span class="sp-logo" style={`background:${bg}`}><img class={wide ? 'is-wide' : undefined} src={logo} alt="" loading="lazy" /></span>
      ) : (
        <img src={img} alt="" loading="lazy" style={pos ? `object-position:${pos}` : undefined} />
      )}
      {artSrc && kind === 'blason' && <span class="sp-blason sp-blason--over"><img src="/img/oni-logo.svg" alt="" width="200" height="200" loading="lazy" /></span>}
      {artSrc && chest && <img class="sp-chest" src="/img/oni-logo.svg" alt="" width="200" height="200" />}
      {kind === 'devise' && <span class="sp-devise" aria-hidden="true">Jamais<br />à genoux</span>}
      {overlay && <span class="sp-overlay" aria-hidden="true">{overlay}</span>}
    </div>
    <img class="sticker__crest" src="/img/oni-blason-blanc.png" alt="" width="218" height="228" />
    <span class="sticker__num" aria-label={`Vignette numéro ${num}`}>{String(num).padStart(2, '0')}</span>
    <div class="sticker__band">
      <p class="sticker__name" style={`font-size:${nameSize}`}>{title}</p>
      <span class="sticker__role">{sub}</span>
    </div>
  </div>
</article>
