---
import site from '../data/site.json';
import Icon from './Icon.astro';
const links = [
  { href: '/club/', label: 'Le club' },
  { href: '/effectif/', label: 'Effectif' },
  { href: '/recrutement/', label: 'Recrutement' },
  { href: '/vestiaire/', label: 'Vestiaire' },
];
// Chemin sans le préfixe de base (GitHub Pages), pour surligner la page courante
const path = '/' + Astro.url.pathname.slice(import.meta.env.BASE_URL.length).replace(/^\//, '');
---
<header class="nav" id="nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/">
      <img src="/img/oni-logo.svg" alt="" width="40" height="40" />
      <span translate="no">Oni Korp</span>
    </a>
    <nav aria-label="Navigation principale" style="display:contents">
      <ul class="nav__links" id="nav-links">
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li><a class="nav__mobile-cta" href={site.discord} rel="noopener">Rejoindre le Discord</a></li>
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-pressed="false">
      <span class="sr-only">Thème sombre</span>
      <span class="theme-toggle__opt" data-t="light" aria-hidden="true">明</span><span class="theme-toggle__opt" data-t="dark" aria-hidden="true">暗</span>
    </button>
    <a class="btn nav__cta" href={site.discord} rel="noopener"><Icon name="discord" />Rejoindre le Discord</a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links">
      <span class="sr-only">Ouvrir le menu</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
    </button>
  </div>
</header>
<script>
  const nav = document.getElementById('nav');
  const btn = nav?.querySelector('.nav__toggle');
  btn?.addEventListener('click', () => {
    const open = nav!.toggleAttribute('data-open');
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('.sr-only')!.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
  });

  // Thème clair / sombre : le choix est mémorisé, sinon on suit le système
  const themeBtn = document.querySelector('.theme-toggle');
  const syncTheme = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    themeBtn?.setAttribute('aria-pressed', String(dark));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0a0a0a' : '#f3f1ec');
  };
  syncTheme();
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    syncTheme();
  });
  // Sans choix mémorisé, on suit le système s'il change en cours de visite
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let saved = null;
    try { saved = localStorage.getItem('theme'); } catch {}
    if (saved) return;
    document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
    syncTheme();
  });
</script>
