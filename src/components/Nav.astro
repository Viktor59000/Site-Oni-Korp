---
import site from '../data/site.json';
import Icon from './Icon.astro';
// Règle : le logo, cinq liens au plus, un seul bouton. Le reste (partenaires, boosters, thème…) vit dans le pied de page.
const links = [
  { href: '/club/', label: 'Le club' },
  { href: '/effectif/', label: 'Légendes' },
  { href: '/agenda/', label: 'Agenda', live: true },
  { href: '/recrutement/', label: 'Recrutement' },
  { href: '/equipe/', label: 'Inside', lock: true },
];
// Chemin sans le préfixe de base (GitHub Pages), pour surligner la page courante
const path = '/' + Astro.url.pathname.slice(import.meta.env.BASE_URL.length).replace(/^\//, '');
---
<header class="nav" id="nav" data-page={path.split('/')[1] || 'accueil'}>
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/">
      <img src="/img/oni-logo.svg" alt="" width="40" height="40" />
      <span translate="no">Oni Korp</span>
    </a>
    <nav aria-label="Navigation principale" style="display:contents">
      <ul class="nav__links" id="nav-links">
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.lock && <svg class="nav__lock" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7a5 5 0 0110 0v3h1a1 1 0 011 1v9a1 1 0 01-1 1H6a1 1 0 01-1-1v-9a1 1 0 011-1h1zm2 0h6V7a3 3 0 00-6 0v3z" /></svg>}{l.label}{l.lock && <span class="sr-only"> : espace équipe</span>}{l.live && <span class="nav__live" hidden><span class="sr-only"> : live en cours</span></span>}</a></li>
        ))}
        <li><a class="nav__mobile-cta" href={site.discord} rel="noopener">Rejoindre le Discord</a></li>
      </ul>
    </nav>
    <a class="btn nav__cta" href={site.discord} rel="noopener"><Icon name="discord" />Rejoindre le Discord</a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-links">
      <span class="sr-only">Ouvrir le menu</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
    </button>
  </div>
</header>
<script>
  import { load, reward } from '../lib/collection';

  // Point rouge sur « Agenda » quand un live du club est en cours (fil tenu par Oni Bot)
  const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn) : setTimeout(fn, 1500));
  idle(() => fetch('/api/feed').then((r) => (r.ok ? r.json() : null)).then((d) => {
    if (d?.live?.length) document.querySelector<HTMLElement>('.nav__live')?.removeAttribute('hidden');
  }).catch(() => {}));
  const nav = document.getElementById('nav');
  const btn = nav?.querySelector('.nav__toggle');
  // Menu mobile : il se déroule depuis la barre et s'y replie (même chemin) ; un appui à côté ou Échap le ferme
  const calm = matchMedia('(prefers-reduced-motion: reduce)');
  let shutting = 0;
  const setMenu = (open: boolean) => {
    if (!nav || !btn) return;
    clearTimeout(shutting); nav.classList.remove('is-closing');
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('.sr-only')!.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
    if (open) { nav.setAttribute('data-open', ''); return; }
    if (!nav.hasAttribute('data-open')) return;
    if (calm.matches) { nav.removeAttribute('data-open'); return; }
    nav.classList.add('is-closing');
    shutting = window.setTimeout(() => { nav.removeAttribute('data-open'); nav.classList.remove('is-closing'); }, 140);
  };
  btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
  // Bord de défilement : la barre ne se détache du contenu que lorsqu'il passe dessous
  let ticking = false;
  const edge = () => { ticking = false; nav?.toggleAttribute('data-scrolled', window.scrollY > 4); };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(edge); } }, { passive: true });
  edge();
  document.addEventListener('click', (e) => { if (nav?.hasAttribute('data-open') && !nav.contains(e.target as Node)) setMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav?.hasAttribute('data-open')) { setMenu(false); (btn as HTMLElement | null)?.focus(); } });

  // Thème clair / sombre : le choix est mémorisé, sinon on suit le système
  const themeBtn = document.querySelector('.theme-toggle');
  const syncTheme = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    themeBtn?.setAttribute('aria-pressed', String(dark));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0a0a0a' : '#f3f1ec');
  };
  syncTheme();
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    // Fondu de 200 ms entre les deux thèmes (pas d'éblouissement), sauf si l'utilisateur limite les animations
    const apply = () => { document.documentElement.dataset.theme = next; syncTheme(); };
    if ('startViewTransition' in document && !calm.matches) (document as any).startViewTransition(apply); else apply();
    try { localStorage.setItem('theme', next); } catch {}
  });
  // Sans choix mémorisé, on suit le système s'il change en cours de visite
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let saved = null;
    try { saved = localStorage.getItem('theme'); } catch {}
    if (saved) return;
    document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
    syncTheme();
  });

  // Boosters : récompenses de visite, pastille dans le menu et petite notification
  const gained = reward(nav?.dataset.page ?? null);
  const credits = load().credits;
  document.querySelectorAll<HTMLElement>('.nav__badge').forEach((b) => {
    b.hidden = credits < 1;
    b.textContent = String(credits);
    b.setAttribute('aria-label', `${credits} booster${credits > 1 ? 's' : ''} à ouvrir`);
  });
  if (gained.length && ['accueil', 'effectif'].includes(nav?.dataset.page ?? '')) {
    const t = document.createElement('div');
    t.className = 'toast';
    t.setAttribute('role', 'status');
    t.innerHTML = `<a href="/boosters/"><strong>+${gained.length} booster${gained.length > 1 ? 's' : ''}</strong><span></span></a>`;
    t.querySelector('span')!.textContent = gained.join(' · ') + ' — ouvrir';
    document.body.append(t);
    setTimeout(() => t.classList.add('is-out'), 6000);
    setTimeout(() => t.remove(), 6600);
  }
</script>
