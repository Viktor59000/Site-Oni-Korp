---
// Carte joueur.
// 1. `photo` renseignée dans rosters.json → la photo du joueur.
// 2. Sinon, un portrait de rôle déposé dans public/img/cartes/<art>.webp
//    (ex. lol-mid, valo-duelliste, rl-2) → ce portrait.
// 3. Sinon, une carte sobre : halo rouge et pictogramme du rôle (ou initiale).
import { existsSync } from 'node:fs';
import RoleIcon from './RoleIcon.astro';

const { name, photo, role, label, art } = Astro.props;
const initial = (name.match(/[A-Za-z0-9]/)?.[0] ?? '?').toUpperCase();
const artSrc = art && existsSync(`public/img/cartes/${art}.webp`) ? `/img/cartes/${art}.webp` : null;
const knownRole = role && !role.includes('confirmer');
const nameSize = `min(11cqi, ${(84 / (name.length * 0.74)).toFixed(2)}cqi)`;
---
<article class={`pcard${photo || artSrc ? ' pcard--photo' : ' pcard--plain'}`}>
  {photo ? (
    <img class="pcard__photo" src={photo} alt={`Photo de ${name}`} loading="lazy" width="600" height="800" />
  ) : artSrc ? (
    <img class="pcard__photo" src={artSrc} alt="" loading="lazy" width="600" height="800" />
  ) : knownRole ? (
    <RoleIcon role={role} class="pcard__role-icon" />
  ) : (
    <span class="pcard__initial" aria-hidden="true">{initial}</span>
  )}
  <img class="pcard__logo" src="/img/oni-logo-dark.svg" alt="" />
  <div class="pcard__foot">
    {(role || label) && <span class="pcard__roster">{role ?? label}</span>}
    <h4 class="pcard__name" style={`font-size:${nameSize}`}>{name}</h4>
  </div>
</article>
