---
// Vignette joueur façon album Panini : bord blanc d'autocollant, numéro, écusson,
// bandeau du pseudo. Le cadre et les textes sont en code (toujours nets) ;
// l'illustration au centre vient, dans l'ordre :
// 1. `photo` renseignée dans rosters.json ;
// 2. un portrait déposé dans public/img/cartes/<art>.webp (ex. lol-mid, rl-2) ;
// 3. sinon un fond graphique (trame de points aux couleurs du pôle) + pictogramme du rôle.
import { existsSync } from 'node:fs';
import RoleIcon from './RoleIcon.astro';

const { name, photo, role, label, art, num, pole, flip, icon, lettre, equipe, zoom = false } = Astro.props;
const initial = (name.match(/[A-Za-z0-9]/)?.[0] ?? '?').toUpperCase();
const artSrc = photo ?? (art && existsSync(`public/img/cartes/${art}.webp`) ? `/img/cartes/${art}.webp` : null);
// Petite version pour les grilles, grande pour la vignette en grand
const artSet = artSrc && art && existsSync(`public/img/cartes/${art}-sm.webp`) ? `/img/cartes/${art}-sm.webp 300w, ${artSrc} 560w` : undefined;
// Pictogramme : rôle principal (`icon`) pour le staff, sinon le rôle du joueur
const iconRole = icon ?? (role && !role.includes('confirmer') ? role : null);
const nameSize = `min(10.5cqi, ${(80 / (name.length * 0.74)).toFixed(2)}cqi)`;
---
<article class="sticker" data-pole={pole} data-equipe={equipe} data-name={zoom ? name : undefined} data-role={zoom ? role : undefined} data-label={zoom ? label : undefined} data-num={zoom ? num : undefined}>
  <div class="sticker__frame">
    <div class="sticker__art">
      {artSrc ? (
        <img class={!photo && flip ? 'is-flipped' : undefined} src={artSrc} srcset={artSet} sizes="(max-width: 720px) 45vw, 200px" alt={photo ? `Photo de ${name}` : ''} loading="lazy" width="560" height="840" />
      ) : iconRole ? (
        <RoleIcon role={iconRole} class="sticker__icon" />
      ) : (
        <span class="sticker__initial" aria-hidden="true">{initial}</span>
      )}
    </div>
    <img class="sticker__crest" src="/img/oni-blason-blanc.png" alt="" width="218" height="228" />
    <span class="sticker__num" aria-label={`Vignette numéro ${num}`}>{String(num).padStart(2, '0')}</span>
    <div class="sticker__band">
      <p class="sticker__name" translate="no" style={`font-size:${nameSize}`}>{name}</p>
      <span class="sticker__role">{role ?? label}</span>
      {lettre && <span class="sticker__lettre" aria-hidden="true">{lettre}</span>}
    </div>
  </div>
  {zoom && <button class="sticker__zoom" type="button" aria-haspopup="dialog" aria-label={`Voir la vignette de ${name} en grand`}></button>}
</article>
