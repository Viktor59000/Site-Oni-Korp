---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable">
  <section class="page-head notfound">
    <span class="page-head__kanji" aria-hidden="true">鬼</span>
    <div class="wrap">
      <h1>404</h1>
      <p>Cette page n'existe pas ou a été déplacée. Retourne à l'accueil pour retrouver le club.</p>
      <p><a class="btn" href="/">Retour à l'accueil</a></p>
    </div>
  </section>
</Base>
