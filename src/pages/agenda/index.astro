---
// Agenda public : calendrier des rendez-vous officiels (tournois, ligues, showmatchs), live en cours et vidéos.
// Données en direct : /api/agenda?mois=… et /api/feed (Oni Bot). Les scrims n'apparaissent jamais ici.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';
import history from '../../data/matches.json';

const host = (Astro.site?.host ?? 'oni-korp.vercel.app');
const ics = `https://${host}/agenda.ics`;
const google = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(`webcal://${host}/agenda.ics`)}`;
const socials = site.socials.filter((s) => s.icon !== 'discord');
const JEUX = [['', 'Tous'], ['rl', 'Rocket League'], ['lol', 'LoL'], ['valo', 'Valorant'], ['osu', 'osu!']];
const DAYS = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];
---
<Base title="Agenda" description="Le calendrier d'Oni Korp : tournois, ligues et showmatchs, lives en cours et dernières vidéos. Ajoute-le à ton agenda.">
  <header class="page-head">
    <div class="wrap">
      <h1>Agenda</h1>
      <p>Tournois, ligues et showmatchs. Ajoute le calendrier à ton agenda : il se met à jour tout seul.</p>
      <div class="ag-sub">
        <a class="btn" href={google} rel="noopener">Ajouter à Google Agenda</a>
        <a class="btn btn--ghost" href={`webcal://${host}/agenda.ics`}>Apple · Outlook</a>
        <a class="ag-raw" href={ics}>Lien .ics</a>
      </div>
    </div>
  </header>

  <section class="ag-live" data-live hidden aria-label="En direct">
    <div class="wrap ag-live__inner" data-live-list></div>
  </section>

  <section class="section" aria-labelledby="cal-title">
    <div class="wrap">
      <div class="cal-bar">
        <div class="cal-nav">
          <button type="button" class="cal-btn" data-move="-1" aria-label="Mois précédent">‹</button>
          <h2 id="cal-title" class="cal-title" aria-live="polite" data-title>Calendrier</h2>
          <button type="button" class="cal-btn" data-move="1" aria-label="Mois suivant">›</button>
          <button type="button" class="cal-today" data-today>Aujourd'hui</button>
        </div>
        <div class="cal-filter" role="group" aria-label="Filtrer par jeu">
          {JEUX.map(([k, l]) => <button type="button" data-jeu={k} aria-pressed={k === '' ? 'true' : 'false'}>{l}</button>)}
        </div>
      </div>

      <div class="cal" aria-hidden="true">
        {DAYS.map((d) => <div class="cal-dow">{d}</div>)}
        <div class="cal-days" data-grid></div>
      </div>

      <h3 class="ag-h" data-list-title>Ce mois-ci</h3>
      <ol class="ag-list" data-list></ol>
      <p class="ag-empty" data-empty hidden>Aucun rendez-vous public ce mois-ci. Les prochains s'ajouteront ici et dans ton agenda si tu t'abonnes ; sur Discord, le rôle <b>Notif matchs</b> te prévient.</p>
    </div>
  </section>

  <section class="section section--bone" aria-labelledby="videos-title" data-videos-section hidden>
    <div class="wrap">
      <div class="section__head section__head--row">
        <h2 id="videos-title">Dernières vidéos.</h2>
        <ul class="ag-socials">
          {socials.map((s) => <li><a href={s.url} rel="noopener" aria-label={s.label}><Icon name={s.icon} /></a></li>)}
        </ul>
      </div>
      <ul class="ag-videos" data-videos></ul>
      <p class="ag-empty" data-videos-empty>Les vidéos de la chaîne <a href={site.socials[1].url} rel="noopener">YouTube</a> apparaissent ici dès leur sortie.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="hist-title">
    <div class="wrap">
      <h2 id="hist-title" class="ag-h">Les débuts du club</h2>
      <ol class="ag-hist">
        {history.filter((m) => m.event !== 'Scrim' && m.opponent).map((m) => (
          <li>
            <span><span translate="no">Oni Korp</span> <i>vs</i> {m.opponent}</span>
            <span class="ag-hist__meta">{[m.event, m.format, m.date].filter(Boolean).join(' · ')}{m.video && <> · <a href={m.video} rel="noopener">Revoir</a></>}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<script>
  type Item = { id: number; type: string; code: string; cast: string | null; compo: string[] | null; jeu: string; roster: string | null; adversaire: string; format: string; date: string; lien: string | null; score: [number, number] | null; tournoi?: boolean; statut?: string; vainqueur?: string | null };
  type F = { auteur: string; titre: string; lien: string; image: string | null; jeu: string | null; date: string };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const tz = { timeZone: 'Europe/Paris' } as const;
  const parts = (d: Date) => Object.fromEntries(new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', day: '2-digit', ...tz }).formatToParts(d).map((p) => [p.type, p.value]));
  const dayKey = (d: Date) => { const p = parts(d); return `${p.year}-${p.month}-${p.day}`; };
  const hour = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit', ...tz });
  const long = new Intl.DateTimeFormat('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', ...tz });
  const monthName = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  const http = (u: string | null): u is string => !!u && /^https?:\/\//.test(u);

  const q = new URLSearchParams(location.search);
  const today = parts(new Date());
  let y = Number(q.get('mois')?.slice(0, 4)) || Number(today.year);
  let m = Number(q.get('mois')?.slice(5, 7)) || Number(today.month);
  let jeu = q.get('jeu') ?? '';
  const cache = new Map<string, Item[]>();

  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const list = document.querySelector<HTMLElement>('[data-list]')!;

  const row = (it: Item) => {
    const d = new Date(it.date);
    const score = it.score ? `<b class="ag-score ${it.score[0] > it.score[1] ? 'is-win' : it.score[0] < it.score[1] ? 'is-loss' : ''}">${it.score[0]} – ${it.score[1]}</b>` : '';
    const watch = !it.score && http(it.lien) ? `<a class="ag-watch" href="${esc(it.lien)}" rel="noopener">Regarder</a>` : '';
    if (it.tournoi) {
      const act = it.statut === 'inscriptions' && http(it.lien) ? `<a class="ag-watch" href="${esc(it.lien)}" rel="noopener">S’inscrire</a>` : it.vainqueur ? `<b class="ag-score is-win">🏆 ${esc(it.vainqueur)}</b>` : '';
      return `<li class="ag-item g-${esc(it.code)}" id="m-${it.id}"><span class="ag-dot" aria-hidden="true"></span>
        <div><p class="ag-vs">🏆 ${esc(it.adversaire)}</p>
        <p class="ag-meta"><time datetime="${it.date}">${long.format(d)}</time></p>
        <p class="ag-meta">${[esc(it.type), it.jeu, esc(it.format), it.statut === 'en_cours' ? 'en cours' : ''].filter(Boolean).join(' · ')}</p></div>${act}</li>`;
    }
    return `<li class="ag-item g-${esc(it.code)}" id="m-${it.id}"><span class="ag-dot" aria-hidden="true"></span>
      <div><p class="ag-vs"><span translate="no">Oni Korp</span> <i>vs</i> ${esc(it.adversaire)}</p>
      <p class="ag-meta"><time datetime="${it.date}">${long.format(d)}</time></p>
      <p class="ag-meta">${[esc(it.type), it.jeu, it.roster ? `roster ${esc(it.roster)}` : '', esc(it.format), it.cast ? `cast ${esc(it.cast)}` : ''].filter(Boolean).join(' · ')}</p>
      ${it.compo?.length ? `<p class="ag-meta">Compo : ${it.compo.map(esc).join(', ')}</p>` : ''}</div>${score}${watch}</li>`;
  };

  async function render() {
    const key = `${y}-${String(m).padStart(2, '0')}`;
    document.querySelector('[data-title]')!.textContent = monthName.format(Date.UTC(y, m - 1, 1)).replace(/^./, (c) => c.toUpperCase());
    document.querySelectorAll<HTMLElement>('[data-jeu]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.jeu === jeu)));
    const ck = `${key}|${jeu}`;
    if (!cache.has(ck)) {
      paint(key, []);
      const d = await fetch(`/api/agenda?mois=${key}${jeu ? `&jeu=${jeu}` : ''}`).then((r) => (r.ok ? r.json() : null)).catch(() => null);
      cache.set(ck, (d?.matchs ?? []).filter((it: Item) => dayKey(new Date(it.date)).startsWith(key)));
    }
    paint(key, cache.get(ck)!);
    const url = new URL(location.href);
    url.searchParams.set('mois', key); jeu ? url.searchParams.set('jeu', jeu) : url.searchParams.delete('jeu');
    history.replaceState(null, '', url);
  }

  function paint(key: string, items: Item[]) {
    const byDay = new Map<string, Item[]>();
    for (const it of items) { const k = dayKey(new Date(it.date)); byDay.set(k, [...(byDay.get(k) ?? []), it]); }

    // Grille : lundi en premier, cases vides avant le 1er
    const first = (new Date(Date.UTC(y, m - 1, 1)).getUTCDay() + 6) % 7;
    const days = new Date(Date.UTC(y, m, 0)).getUTCDate();
    const todayKey = `${today.year}-${today.month}-${today.day}`;
    let html = '<span class="cal-pad"></span>'.repeat(first);
    for (let d = 1; d <= days; d++) {
      const k = `${key}-${String(d).padStart(2, '0')}`;
      const evs = byDay.get(k) ?? [];
      html += `<div class="cal-day${k === todayKey ? ' is-today' : ''}${evs.length ? ' has-ev' : ''}"><span class="cal-num">${d}</span>${evs.map((it) =>
        `<a class="cal-ev g-${esc(it.code)}${it.score ? ' is-done' : ''}" href="#m-${it.id}"><b>${hour.format(new Date(it.date))}</b> ${esc(it.adversaire)}${it.score ? ` <i>${it.score[0]}-${it.score[1]}</i>` : ''}</a>`).join('')}</div>`;
    }
    grid.innerHTML = html;
    list.innerHTML = items.map(row).join('');
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = items.length > 0;
  }

  document.querySelectorAll<HTMLElement>('[data-move]').forEach((b) => b.addEventListener('click', () => {
    m += Number(b.dataset.move); if (m < 1) { m = 12; y--; } if (m > 12) { m = 1; y++; } render();
  }));
  document.querySelector('[data-today]')!.addEventListener('click', () => { y = Number(today.year); m = Number(today.month); render(); });
  document.querySelectorAll<HTMLElement>('[data-jeu]').forEach((b) => b.addEventListener('click', () => { jeu = b.dataset.jeu ?? ''; render(); }));
  render();

  fetch('/api/feed').then((r) => (r.ok ? r.json() : null)).then((d: { live: F[]; videos: F[] } | null) => {
    if (!d) return;
    if (d.live.length) {
      document.querySelector<HTMLElement>('[data-live-list]')!.innerHTML = d.live.map((l) => `
        <a class="ag-live__card" href="${esc(l.lien)}" rel="noopener">
          ${l.image ? `<img src="${esc(l.image)}" alt="" width="320" height="180" loading="lazy" />` : ''}
          <span><span class="ag-live__tag"><span class="agenda__live" aria-hidden="true"></span>En direct</span>
          <strong>${esc(l.titre)}</strong>${l.jeu ? `<small>${esc(l.jeu)}</small>` : ''}</span>
        </a>`).join('');
      document.querySelector<HTMLElement>('[data-live]')!.hidden = false;
    }
    if (d.videos.length) {
      document.querySelector<HTMLElement>('[data-videos]')!.innerHTML = d.videos.map((v) => `
        <li><a href="${esc(v.lien)}" rel="noopener">${v.image ? `<img src="${esc(v.image)}" alt="" width="480" height="360" loading="lazy" />` : ''}
          <span>${esc(v.titre)}</span><small>${esc(v.auteur)} · ${new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(v.date))}</small></a></li>`).join('');
      document.querySelector<HTMLElement>('[data-videos-empty]')!.hidden = true;
      document.querySelector<HTMLElement>('[data-videos-section]')!.hidden = false;
    }
  }).catch(() => {});
</script>

<style>
  .ag-sub { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; margin-top: 1.75rem; }
  .ag-raw { font-size: var(--step--1); color: var(--muted); }

  /* Couleurs des jeux (repères du calendrier) */
  :global(.g-rl) { --g: #2f6bff; } :global(.g-lol) { --g: #0f8a9b; } :global(.g-valo) { --g: #ff4655; } :global(.g-osu) { --g: #ff66aa; }

  .cal-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
  .cal-nav { display: flex; align-items: center; gap: .5rem; }
  .cal-title { font-size: clamp(1.5rem, 4vw, 2.2rem); min-width: 13ch; white-space: nowrap; text-align: center; } /* place du mois le plus long : la barre ne bouge pas au chargement */
  .cal-btn { width: 44px; height: 44px; border: 1.5px solid var(--line); background: none; color: var(--ink); font-size: 1.5rem; line-height: 1; cursor: pointer; }
  .cal-today { min-height: 44px; padding: 0 .9rem; border: 0; background: none; color: var(--red-text); font: 700 .9rem var(--font-body); cursor: pointer; }
  .cal-btn:hover { border-color: var(--ink); }
  .cal-filter { display: flex; flex-wrap: wrap; gap: .4rem; }
  .cal-filter button { min-height: 40px; padding: 0 .9rem; border: 1.5px solid var(--line); background: none; color: var(--ink); font: 700 .85rem var(--font-body); cursor: pointer; }
  .cal-filter button[aria-pressed="true"] { background: var(--ink); color: var(--surface); border-color: var(--ink); }

  .cal { display: grid; grid-template-columns: repeat(7, 1fr); border-top: 2px solid var(--ink); margin-bottom: 2.5rem; }
  .cal-dow { padding: .5rem .4rem; font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .cal-days { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(7, 1fr); border-left: 1px solid var(--line); }
  .cal-days :global(.cal-pad), .cal-days :global(.cal-day) { min-height: 6.5rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .cal-days.is-quiet :global(.cal-pad), .cal-days.is-quiet :global(.cal-day) { min-height: 2.6rem; }
  .cal-days :global(.cal-day) { display: flex; flex-direction: column; gap: .25rem; padding: .35rem; min-width: 0; }
  .cal-days :global(.cal-num) { font-size: .8rem; font-weight: 700; color: var(--muted); }
  .cal-days :global(.is-today .cal-num) { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--lacquer); color: #fff; }
  .cal-days :global(.cal-ev) { display: block; padding: .2rem .35rem; border-left: 3px solid var(--g, var(--lacquer)); background: color-mix(in srgb, var(--g, var(--lacquer)) 14%, transparent);
    color: var(--ink); text-decoration: none; font-size: .75rem; line-height: 1.25; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cal-days :global(.cal-ev:hover) { background: color-mix(in srgb, var(--g, var(--lacquer)) 28%, transparent); }
  .cal-days :global(.cal-ev.is-done) { opacity: .7; }
  .cal-days :global(.cal-ev i) { font-style: normal; font-weight: 700; }
  @media (max-width: 720px) {
    .cal-days :global(.cal-pad), .cal-days :global(.cal-day) { min-height: 3.2rem; }
    .cal-days :global(.cal-day) { align-items: center; }
    .cal-days :global(.cal-ev) { width: .55rem; height: .55rem; padding: 0; border: 0; border-radius: 50%; background: var(--g, var(--lacquer)); font-size: 0; }
    .cal-dow { text-align: center; padding-inline: 0; }
  }

  .ag-h { display: flex; align-items: center; gap: .6rem; font-family: var(--font-body); font-weight: 700; font-size: 1rem; padding-bottom: .6rem; border-bottom: 2px solid var(--ink); }
  .ag-list :global(.ag-item) { display: grid; grid-template-columns: .9rem 1fr auto; gap: 1rem; align-items: center; padding: 1rem 0; border-bottom: 1px solid var(--line); scroll-margin-top: 90px; }
  .ag-list :global(.ag-item:target) { background: color-mix(in srgb, var(--g, var(--lacquer)) 10%, transparent); }
  .ag-list :global(.ag-dot) { width: .7rem; height: .7rem; border-radius: 50%; background: var(--g, var(--lacquer)); align-self: start; margin-top: .45rem; }
  .ag-list :global(.ag-vs) { font-family: var(--font-display); font-size: 1.2rem; line-height: 1.15; }
  .ag-list :global(.ag-vs i), .ag-hist i { font-family: var(--font-body); font-style: normal; font-size: .75em; color: var(--muted); }
  .ag-list :global(p) { margin: 0; }
  .ag-list :global(.ag-meta) { color: var(--muted); font-size: var(--step--1); margin-top: .25rem; }
  .ag-list :global(.ag-meta::first-letter), .ag-list :global(time) { text-transform: none; }
  .ag-list :global(.ag-score) { font-family: var(--font-display); font-size: 1.3rem; padding: .1em .45em; border: 2px solid var(--line); white-space: nowrap; }
  .ag-list :global(.ag-score.is-win) { border-color: #1f8f55; color: #1f8f55; }
  .ag-list :global(.ag-score.is-loss) { color: var(--muted); }
  .ag-list :global(.ag-watch) { font-weight: 700; color: var(--red-text); white-space: nowrap; }
  .ag-empty { color: var(--muted); padding: 1.25rem 0; max-width: 46ch; }
  .ag-empty[hidden], [data-videos-section][hidden] { display: none; }
  .ag-hist { margin-top: 1rem; }
  .ag-hist li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .2rem 1rem; padding: .6rem 0; border-bottom: 1px solid var(--line); font-size: .95rem; }
  .ag-hist__meta { color: var(--muted); font-size: var(--step--1); }
  .ag-hist__meta a { color: var(--red-text); font-weight: 700; }

  .ag-live { background: var(--black); color: var(--bone); border-bottom: 3px solid var(--lacquer); }
  .ag-live__inner { display: grid; gap: 1rem; padding-block: 1.25rem; }
  .ag-live :global(.ag-live__card) { display: flex; align-items: center; gap: 1.25rem; color: inherit; text-decoration: none; }
  .ag-live :global(.ag-live__card img) { width: min(40vw, 13rem); height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .ag-live :global(.ag-live__card > span) { display: grid; gap: .3rem; }
  .ag-live :global(.ag-live__tag) { display: inline-flex; align-items: center; gap: .5rem; font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #ff6b66; }
  .ag-live :global(strong) { font-family: var(--font-display); font-size: clamp(1.1rem, 2.5vw, 1.5rem); line-height: 1.15; }
  .ag-live :global(small) { color: rgb(255 255 255 / .7); }
  .ag-live :global(.ag-live__card:hover strong) { text-decoration: underline; }

  .ag-socials { display: flex; gap: .5rem; }
  .ag-socials a { display: grid; place-items: center; width: 44px; height: 44px; border: 1.5px solid var(--line); color: var(--ink); }
  .ag-socials a:hover { border-color: var(--ink); }
  .ag-socials :global(svg) { width: 20px; height: 20px; fill: currentColor; }
  .ag-videos { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: 1.5rem; }
  .ag-videos :global(a) { display: grid; gap: .5rem; color: inherit; text-decoration: none; }
  .ag-videos :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .ag-videos :global(span) { font-weight: 700; line-height: 1.3; }
  .ag-videos :global(small) { color: var(--muted); font-size: var(--step--1); }
  .ag-videos :global(a:hover span) { text-decoration: underline; }
</style>
