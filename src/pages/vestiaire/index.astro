---
import { srcset, small } from '../../lib/img.js';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';


const decals = [
  {
    id: 'octane',
    car: 'Octane',
    text: 'Le decal officiel Oni Korp × Carl sur la voiture la plus jouée du jeu. Deux variantes : domicile en noir et rouge, visiteur en blanc.',
    file: '/downloads/oni-korp-x-carl-octane-2023.zip',
    size: '12,6 Mo',
  },
  {
    id: 'fennec',
    car: 'Fennec',
    text: 'La même identité sur la Fennec, pour celles et ceux qui préfèrent sa hitbox.',
    file: '/downloads/oni-korp-x-carl-fennec-2023.zip',
    size: '9,1 Mo',
  },
];
---
<Base title="Vestiaire" description="Decals Rocket League Oni Korp × Carl à télécharger gratuitement (Octane, Fennec) et merch du club.">
  <header class="page-head">
    <img class="page-head__bg" src="/img/entete-vestiaire.webp" srcset={srcset("/img/entete-vestiaire.webp")} sizes="100vw" fetchpriority="high" alt="" width="1983" height="793" />
    <span class="page-head__kanji" aria-hidden="true">装</span>
    <div class="wrap">
      <h1>Vestiaire</h1>
      <p>Porte les couleurs du club, en jeu comme dans la vraie vie.</p>
    </div>
  </header>

  <div class="wrap">
    {decals.map((d) => (
      <section class="decal" aria-labelledby={`${d.id}-title`} data-decal>
        <div class="decal__stage">
          <img src={`/img/decal-${d.id}-domicile.webp`} srcset={srcset(`/img/decal-${d.id}-domicile.webp`)} sizes="(max-width: 860px) 100vw, 60vw" alt={`${d.car} Oni Korp × Carl, version domicile`} loading="lazy" width="1600" height="900" data-side="domicile" />
          <img src={`/img/decal-${d.id}-visiteur.webp`} srcset={srcset(`/img/decal-${d.id}-visiteur.webp`)} sizes="(max-width: 860px) 100vw, 60vw" alt={`${d.car} Oni Korp × Carl, version visiteur`} loading="lazy" width="1600" height="900" data-side="visiteur" hidden />
        </div>
        <div>
          <h2 id={`${d.id}-title`}>{d.car} Oni Korp × Carl</h2>
          <p>{d.text}</p>
          <div class="switch" role="group" aria-label="Variante affichée">
            <button type="button" aria-pressed="true" data-show="domicile">Domicile</button>
            <button type="button" aria-pressed="false" data-show="visiteur">Visiteur</button>
          </div>
          <div>
            <a class="btn" href={d.file} download>Télécharger les textures ({d.size})</a>
          </div>
          <p class="decal__note">Textures PNG et presets JSON, à utiliser avec BakkesMod (AlphaConsole).</p>
        </div>
      </section>
    ))}

    <section class="section" aria-labelledby="merch-title">
      <div class="merch">
        <figure class="merch__shot">
          <img src="/img/sweat-porte-face.webp" alt="Joueur portant le sweat Oni Korp noir et blanc, logo rouge sur la poitrine" loading="lazy" width="900" height="1131" />
          <figcaption>Face</figcaption>
        </figure>
        <figure class="merch__shot">
          <img src="/img/sweat-dos.webp" alt="Dos du sweat personnalisé avec le pseudo SHEEP et le numéro 777" loading="lazy" width="600" height="900" />
          <figcaption>Dos personnalisé</figcaption>
        </figure>
        <div class="merch__text">
          <h2 id="merch-title">Le sweat du club</h2>
          <p>Corps noir, capuche et manches blanches, logo rouge sur la poitrine et devise sur la manche. Au dos, ton pseudo et ton numéro.</p>
          <img class="merch__flat" src="/img/sweat-a-plat.webp" alt="Sweat Oni Korp plié à côté d'un casque et d'une manette" loading="lazy" width="1100" height="875" />
          <p>Un nouveau drop est en préparation. Les précommandes seront annoncées en premier sur le Discord.</p>
          <a class="btn btn--ghost" href={site.discord} rel="noopener">Être prévenu sur Discord</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  document.querySelectorAll('[data-decal]').forEach((block) => {
    const buttons = block.querySelectorAll('[data-show]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const side = btn.getAttribute('data-show');
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        block.querySelectorAll('img[data-side]').forEach((img) => {
          img.toggleAttribute('hidden', img.getAttribute('data-side') !== side);
        });
      });
    });
  });
</script>
