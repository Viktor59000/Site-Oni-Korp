---
import { srcset } from '../../lib/img.js';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';


const decals = [
  {
    id: 'octane',
    car: 'Octane',
    text: 'Le decal officiel Oni Korp × Carl & Barl sur la voiture la plus jouée du jeu. Deux variantes : domicile en noir et rouge, visiteur en blanc.',
    file: '/downloads/oni-korp-x-carl-octane-2023.zip',
    size: '12,6 Mo',
  },
  {
    id: 'fennec',
    car: 'Fennec',
    text: 'La même identité sur la Fennec, pour celles et ceux qui préfèrent sa hitbox.',
    file: '/downloads/oni-korp-x-carl-fennec-2023.zip',
    size: '9,1 Mo',
  },
];
// Générations précédentes (textures et presets dans les zip)
const archives = [
  { year: '2021', text: 'Le tout premier decal, l’année de la fondation : camo gris et noir, touches de rouge.', file: '/downloads/oni-korp-decals-2021.zip', size: '6,3 Mo' },
  { year: '2022', text: 'La deuxième génération : carrosserie noire, grand panneau rouge sur le flanc.', file: '/downloads/oni-korp-decals-2022.zip', size: '12,3 Mo' },
];
---
<Base title="Vestiaire" description="Decals Rocket League Oni Korp × Carl & Barl à télécharger gratuitement (Octane, Fennec) et merch du club.">
  <header class="page-head">
    <img class="page-head__bg" src="/img/entete-vestiaire.webp" srcset={srcset("/img/entete-vestiaire.webp")} sizes="100vw" fetchpriority="high" alt="" width="2000" height="667" />
    <div class="wrap">
      <h1>Vestiaire</h1>
      <p>Porte les couleurs du club, en jeu comme dans la vraie vie.</p>
    </div>
  </header>

  <div class="wrap">
    <section class="partner-intro" aria-labelledby="partner-title">
      <h2 id="partner-title"><span translate="no">Oni Korp</span> × <span translate="no">Carl & Barl</span></h2>
      <p>Notre partenaire Carl & Barl by LNDR signe avec nous les decals Octane et Fennec 2023, en version domicile et visiteur. Les textures sont gratuites : télécharge-les et roule aux couleurs du club.</p>
    </section>
    {decals.map((d) => (
      <section class="decal" aria-labelledby={`${d.id}-title`} data-decal>
        <div class="decal__stage">
          <img src={`/img/decal-${d.id}-domicile.webp`} srcset={srcset(`/img/decal-${d.id}-domicile.webp`)} sizes="(max-width: 860px) 100vw, 60vw" alt={`${d.car} Oni Korp × Carl & Barl, version domicile`} loading="lazy" width="1600" height="900" data-side="domicile" />
          <img src={`/img/decal-${d.id}-visiteur.webp`} srcset={srcset(`/img/decal-${d.id}-visiteur.webp`)} sizes="(max-width: 860px) 100vw, 60vw" alt={`${d.car} Oni Korp × Carl & Barl, version visiteur`} loading="lazy" width="1600" height="900" data-side="visiteur" hidden />
        </div>
        <div>
          <h2 id={`${d.id}-title`}>{d.car}</h2>
          <p>{d.text}</p>
          <div class="switch" role="group" aria-label="Variante affichée">
            <button type="button" aria-pressed="true" data-show="domicile">Domicile</button>
            <button type="button" aria-pressed="false" data-show="visiteur">Visiteur</button>
          </div>
          <div>
            <a class="btn" href={d.file} download>Télécharger les textures ({d.size})</a>
          </div>
          <p class="decal__note">Textures PNG et presets JSON des decals du club.</p>
        </div>
      </section>
    ))}

    <section class="section archive" aria-labelledby="archive-title">
      <div class="section__head">
        <h2 id="archive-title">Les anciens decals.</h2>
        <p>Les deux premières générations du club, avant Carl & Barl. Toujours jouables, toujours gratuites.</p>
      </div>
      {archives.map((y) => (
        <div class="archive__year">
          <div class="archive__head">
            <h3>{y.year}</h3>
            <p>{y.text}</p>
            <a class="btn btn--ghost" href={y.file} download>Télécharger {y.year} ({y.size})</a>
          </div>
          <ul class="archive__cars">
            {['octane', 'fennec'].map((car) => (
              <li data-decal>
                <div class="archive__stage">
                  {['domicile', 'visiteur'].map((side, i) => (
                    <picture data-side={side} hidden={i > 0}>
                      <source type="image/avif" srcset={`/img/decals/${y.year}-${car}-${side}.avif`} />
                      <img src={`/img/decals/${y.year}-${car}-${side}.webp`} alt={`${car === 'octane' ? 'Octane' : 'Fennec'} Oni Korp ${y.year}, version ${side}`} width="800" height="450" loading="lazy" />
                    </picture>
                  ))}
                </div>
                <div class="archive__meta">
                  <strong>{car === 'octane' ? 'Octane' : 'Fennec'}</strong>
                  <div class="switch" role="group" aria-label="Variante affichée">
                    <button type="button" aria-pressed="true" data-show="domicile">Domicile</button>
                    <button type="button" aria-pressed="false" data-show="visiteur">Visiteur</button>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
    <section class="section" aria-labelledby="merch-title">
      <div class="merch">
        <figure class="merch__shot">
          <img src="/img/sweat-porte-face.webp" srcset={srcset("/img/sweat-porte-face.webp")} sizes="(max-width: 860px) 50vw, 30vw" alt="Joueur portant le sweat Oni Korp noir et blanc, logo rouge sur la poitrine" loading="lazy" width="900" height="1131" />
          <figcaption>Face</figcaption>
        </figure>
        <figure class="merch__shot">
          <img src="/img/sweat-dos.webp" srcset={srcset("/img/sweat-dos.webp")} sizes="(max-width: 860px) 50vw, 30vw" alt="Dos du sweat personnalisé avec le pseudo SHEEP et le numéro 777" loading="lazy" width="600" height="900" />
          <figcaption>Dos personnalisé</figcaption>
        </figure>
        <div class="merch__text">
          <h2 id="merch-title">Le sweat du club</h2>
          <p>Corps noir, capuche et manches blanches, blason rouge sur la poitrine. Au dos, le blason, ton pseudo et ton numéro.</p>
          <img class="merch__flat" src="/img/sweat-a-plat.webp" srcset={srcset("/img/sweat-a-plat.webp")} sizes="(max-width: 860px) 100vw, 35vw" alt="Sweat Oni Korp plié à côté d'un casque et d'une manette" loading="lazy" width="1100" height="875" />
          <p>Un nouveau drop est en préparation. Les précommandes seront annoncées en premier sur le Discord.</p>
          <a class="btn btn--ghost" href={site.discord} rel="noopener">Être prévenu sur Discord</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  document.querySelectorAll('[data-decal]').forEach((block) => {
    const buttons = block.querySelectorAll('[data-show]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const side = btn.getAttribute('data-show');
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        block.querySelectorAll('[data-side]').forEach((img) => {
          img.toggleAttribute('hidden', img.getAttribute('data-side') !== side);
        });
      });
    });
  });
</script>

<style>
  .archive__year { display: grid; grid-template-columns: minmax(0, 16rem) 1fr; gap: 2rem; padding-block: 2rem; border-top: 1px solid var(--line); }
  .archive__head h3 { font-family: var(--font-display); font-size: var(--step-3); line-height: 1; }
  .archive__head p { color: var(--muted); margin: .75rem 0 1.25rem; }
  .archive__cars { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
  .archive__stage { aspect-ratio: 16 / 9; background: #0a0a0a; border-radius: 4px; overflow: hidden; }
  .archive__stage img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .archive__stage [hidden] { display: none; }
  .archive__meta .switch { margin-top: 0; }
  .archive__meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; margin-top: .6rem; }
  @media (max-width: 760px) { .archive__year { grid-template-columns: 1fr; gap: 1rem; } }
</style>
