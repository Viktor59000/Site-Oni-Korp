---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';

const staffRoles = [
  ['Coach', 'Prépare les entraînements, analyse les matchs et fait progresser un roster.'],
  ['Manager roster', 'Organise le planning, les inscriptions en tournoi et la vie du roster.'],
  ['Casteur', 'Commente nos showmatchs et nos compétitions en direct sur Twitch.'],
  ['Recruteur', 'Repère les talents, suit les tickets de candidature et les essais.'],
  ['Graphiste', 'Bannières, miniatures, decals : donne un visage au club.'],
  ['Content creator', 'Clips, TikTok et vidéos YouTube autour des rosters.'],
  ['Community manager', 'Anime nos réseaux et le serveur Discord.'],
  ['Modérateur', 'Veille à une ambiance saine sur le Discord.'],
  ['Responsable marketing', 'Développe la visibilité du club et les partenariats.'],
];
---
<Base title="Recrutement" description="Rejoins Oni Korp : recrutement joueurs (Champion 1 minimum, 15 ans minimum) et staff (coach, manager, casteur, graphiste...).">
  <header class="page-head">
    <img class="page-head__bg" src="/img/entete-recrutement.webp" alt="" width="1983" height="793" />
    <span class="page-head__kanji" aria-hidden="true">挑</span>
    <div class="wrap">
      <h1>Recrutement</h1>
      <p>Joueurs et staff : un formulaire, un ticket Discord, et on se rencontre.</p>
    </div>
  </header>

  <section class="section section--red section--brush" id="joueurs" aria-labelledby="joueurs-title">
    <div class="wrap recruit">
      <div>
        <h2 id="joueurs-title">Joueurs</h2>
        <p class="recruit__lead">Tu en as assez des parties avec des coéquipiers qui ne jouent pas le jeu ? Nous aussi. Les profils sont sélectionnés avec soin pour garder un niveau et une ambiance au rendez-vous.</p>
        <ul class="reqs">
          <li>Rang Champion 1 minimum sur Rocket League</li>
          <li>15 ans minimum</li>
          <li>Actif, mature et disponible pour les entraînements</li>
        </ul>
        <h3 class="recruit__sub">Ce que tu y gagnes</h3>
        <ul class="reqs">
          <li>Tes matchs castés en direct sur notre Twitch</li>
          <li>Un staff actif et à l'écoute</li>
          <li>La liberté de proposer tes idées et tes projets</li>
          <li>Un roster adapté à ton niveau</li>
        </ul>
      </div>
      <div>
        <ol class="steps">
          <li><div><strong>Remplis le formulaire joueur</strong><p>Rang, jeu, disponibilités. Tu peux joindre un replay.</p></div></li>
          <li><div><strong>Ouvre un ticket sur le Discord</strong><p>Clique sur « Create ticket » dans le salon recrutement. Sans ticket, la candidature n'est pas prise en compte.</p></div></li>
          <li><div><strong>Présente-toi au staff</strong><p>Un recruteur te répond dans le ticket et organise la suite.</p></div></li>
        </ol>
        <div class="recruit__actions">
          <a class="btn btn--ink" href={site.forms.joueurs} rel="noopener">Remplir le formulaire joueur</a>
          <a class="btn btn--ghost" href={site.discord} rel="noopener"><Icon name="discord" />Ouvrir un ticket</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="staff" aria-labelledby="staff-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="staff-title">Staff</h2>
        <p>Tu t'intéresses à l'esport sans forcément jouer en compétition ? Le club cherche des profils sérieux et motivés.</p>
      </div>
      <ul class="roles">
        {staffRoles.map(([role, desc]) => (
          <li><strong>{role}</strong><span>{desc}</span></li>
        ))}
      </ul>
      <div class="recruit__actions">
        <a class="btn" href={site.forms.staff} rel="noopener">Remplir le formulaire staff</a>
        <a class="btn btn--ghost" href={site.discord} rel="noopener"><Icon name="discord" />Ouvrir un ticket</a>
      </div>
    </div>
  </section>
</Base>
