---
import { srcset } from '../../lib/img.js';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';

// Postes du staff, groupés par famille
const staffGroups = [
  ['Encadrement', [
    ['Coach', 'Prépare les entraînements, analyse les matchs et fait progresser un roster.'],
    ['Manager roster', 'Organise le planning, les inscriptions en tournoi et la vie du roster.'],
  ]],
  ['Contenu', [
    ['Casteur', 'Commente nos showmatchs en direct sur Twitch et produit le contenu de l’équipe.'],
    ['Graphiste', 'Bannières, miniatures, decals : donne un visage au club.'],
  ]],
  ['Communauté', [
    ['Community manager', 'Anime nos réseaux et le serveur Discord.'],
    ['Modérateur', 'Veille à une ambiance saine sur le Discord.'],
    ['Responsable marketing', 'Développe la visibilité du club et les partenariats.'],
  ]],
];
---
<Base title="Recrutement" description="Rejoins Oni Korp : recrutement joueurs (18 ans minimum) et staff (coach, manager, casteur, graphiste…).">
  <header class="page-head">
    <img class="page-head__bg" src="/img/entete-recrutement.webp" srcset={srcset("/img/entete-recrutement.webp")} sizes="100vw" fetchpriority="high" alt="" width="2000" height="667" />
    <div class="wrap">
      <h1>Recrutement</h1>
      <p>Joueurs et staff : un formulaire, un fil privé sur Discord, et on se rencontre.</p>
    </div>
  </header>

  <section class="section section--red section--brush" id="joueurs" aria-labelledby="joueurs-title">
    <div class="wrap recruit">
      <div>
        <h2 id="joueurs-title">Joueurs</h2>
        <p class="recruit__lead">Tu en as assez des parties avec des coéquipiers qui ne jouent pas le jeu ? Nous aussi. Les profils sont sélectionnés avec soin pour garder un niveau et une ambiance au rendez-vous.</p>
        <ul class="reqs">
          <li>18 ans minimum</li>
          <li>Actif, mature et disponible pour les entraînements</li>
        </ul>
        <h3 class="recruit__sub">Ce que tu y gagnes</h3>
        <ul class="reqs">
          <li>Tes matchs castés en direct sur notre Twitch</li>
          <li>Un staff actif et à l'écoute</li>
          <li>La liberté de proposer tes idées et tes projets</li>
          <li>Un roster adapté à ton niveau</li>
        </ul>
      </div>
      <div>
        <ol class="steps">
          <li><div><strong>Rejoins le Discord</strong><p>C'est là que tout se passe : entraînements, matchs, vie du club.</p></div></li>
          <li><div><strong>Postule en deux minutes</strong><p>Connexion avec Discord, jeu, rang, disponibilités. Tu peux ajouter un lien de tracker ou un replay.</p></div></li>
          <li><div><strong>Échange avec le staff</strong><p>Un fil privé s'ouvre aussitôt sur le serveur avec le manager et le coach du pôle.</p></div></li>
        </ol>
        <div class="recruit__actions">
          <a class="btn btn--ink" href="/postuler/?type=joueur">Postuler comme joueur</a>
          <a class="btn btn--ghost" href={site.discord} rel="noopener"><Icon name="discord" />Rejoindre le Discord</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="staff" aria-labelledby="staff-title">
    <div class="wrap">
      <div class="staff-intro">
        <div class="section__head">
          <h2 id="staff-title">Staff</h2>
          <p>Tu t'intéresses à l'esport sans forcément jouer en compétition ? Le club cherche des profils sérieux et motivés. Ta vignette t'attend.</p>
        </div>
        <img class="staff-intro__pack" src="/img/pochette.webp" alt="" width="500" height="750" loading="lazy" />
      </div>
      <div class="role-groups">
        {staffGroups.map(([famille, postes]) => (
          <section class="role-group" aria-label={famille}>
            <h3>{famille}</h3>
            <ul class="roles">
              {postes.map(([role, desc]) => <li><strong>{role}</strong><span>{desc}</span></li>)}
            </ul>
          </section>
        ))}
      </div>
      <p class="roles__note">Le recrutement est géré par les managers et les coachs de chaque pôle. Côté contenu, les casteurs portent la voix de l'équipe, et chaque joueur est libre de proposer des clips ou des vidéos.</p>
      <div class="recruit__actions">
        <a class="btn" href="/postuler/?type=staff">Postuler au staff</a>
        <a class="btn btn--ghost" href={site.discord} rel="noopener"><Icon name="discord" />Rejoindre le Discord</a>
      </div>
    </div>
  </section>
</Base>
