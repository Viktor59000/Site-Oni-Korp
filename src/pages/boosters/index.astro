---
import { album } from '../../lib/album.js';
import Base from '../../layouts/Base.astro';
import PlayerCard from '../../components/PlayerCard.astro';
import SpecialCard from '../../components/SpecialCard.astro';

// Rareté : plus le poids est faible, plus la vignette est rare dans les boosters
const WEIGHT = { commune: 2.5, or: 1, argent: 1, holo: 0.8, legendaire: 0.25 };
const pages = [
  { titre: 'Joueurs', cartes: album.games.flatMap((g) => g.rosters.flatMap((r) => r.cards)).map((c) => ({ ...c, rarete: 'commune' })) },
  { titre: 'Staff', note: 'Édition or', cartes: album.staff.map((c) => ({ ...c, rarete: 'or' })) },
  ...album.specials.map((s) => ({ titre: s.titre, note: { holo: 'Holo', argent: 'Argent', legendaire: 'Ultra-rare', commune: '' }[s.rarete], cartes: s.cartes, special: true })),
];
const cards = pages.flatMap((p) => p.cartes);
---
<Base title="Boosters" description="Ouvre un booster par jour et complète l'album Oni Korp : 27 vignettes, des holos et l'édition staff en or.">
  <header class="page-head">
    <img class="page-head__bg page-head__bg--album" src="/img/album-couverture.webp" alt="" width="1400" height="933" fetchpriority="high" />
    <div class="wrap">
      <h1>Boosters</h1>
      <p>Un booster offert chaque jour, cinq vignettes à l'intérieur. Complète l'album du club.</p>
    </div>
  </header>

  <section class="section booster" aria-labelledby="booster-title">
    <div class="wrap booster__grid">
      <div class="booster__info">
        <h2 id="booster-title" class="booster__count"><span data-credits>0</span> <span data-credits-label>booster à ouvrir</span></h2>
        <div class="booster__progress">
          <p><strong data-owned>0</strong> / {cards.length} vignettes</p>
          <div class="bar" role="progressbar" aria-label="Album complété" aria-valuemin="0" aria-valuemax={cards.length} aria-valuenow="0"><span data-bar></span></div>
        </div>
        <h3>Gagner des boosters</h3>
        <ul class="booster__rules">
          <li data-rule="daily">Un booster offert chaque jour</li>
          <li data-rule="club">Visiter <a href="/club/">Le club</a></li>
          <li data-rule="vestiaire">Visiter le <a href="/vestiaire/">Vestiaire</a></li>
          <li data-rule="recrutement">Visiter le <a href="/recrutement/">Recrutement</a></li>
        </ul>
        <p class="booster__note">Ta collection est gardée dans ce navigateur. {cards.length} vignettes : joueurs, staff en édition or, moments holo, garage et partenaires en argent, et deux légendaires très rares. Chaque vignette a aussi une chance sur six de sortir en holo.</p>
      </div>

      <div class="pack-stage">
        <button class="pack" type="button" data-pack disabled>
          <span class="pack__body"><img src="/img/pochette.webp" alt="" width="700" height="1050" /></span>
          <span class="pack__top" aria-hidden="true"><img src="/img/pochette.webp" alt="" width="700" height="1050" /></span>
          <span class="pack__label" data-pack-label>Reviens demain</span>
        </button>
      </div>
    </div>

    <div class="wrap">
      <div class="reveal" data-reveal hidden>
        <p class="reveal__hint">Clique sur les vignettes pour les retourner.</p>
        <ul class="reveal__cards" data-reveal-cards></ul>
        <div class="reveal__actions">
          <button class="btn btn--ghost" type="button" data-reveal-all>Tout retourner</button>
          <button class="btn" type="button" data-reveal-done hidden>Ranger dans l'album</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="coll-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="coll-title">Ma collection</h2>
        <p>Les vignettes manquantes restent dans l'ombre. Les doubles sont comptés.</p>
      </div>
      {pages.map((pg) => (
        <div class="collection__page">
          <h3 class="collection__title">{pg.titre}{pg.note && <span>{pg.note}</span>}</h3>
          <ul class="collection">
            {pg.cartes.map((c) => (
              <li class="collection__item is-missing" data-num={c.num} data-weight={WEIGHT[c.rarete]} data-rarete={c.rarete}>
                {pg.special ? <SpecialCard {...c} /> : <PlayerCard {...c} />}
                <span class="collection__q" aria-hidden="true">?</span>
                <span class="collection__n" hidden></span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Dos de vignette, utilisé pendant l'ouverture -->
  <template id="card-back">
    <div class="pc__back"><img src="/img/hanko-oni.webp" alt="" width="320" height="308" /></div>
  </template>
</Base>

<script>
  import { load, openPack, ownedCount, reward, BONUS_PAGES } from '../../lib/collection';

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const items = [...document.querySelectorAll<HTMLElement>('.collection__item')];
  const byNum = new Map(items.map((li) => [Number(li.dataset.num), li]));
  const pool = [...byNum.keys()];
  const weight = (n: number) => Number(byNum.get(n)!.dataset.weight) || 1;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pack = $<HTMLButtonElement>('[data-pack]');

  const refresh = () => {
    reward(null);
    const c = load();
    $('[data-credits]').textContent = String(c.credits);
    $('[data-credits-label]').textContent = c.credits > 1 ? 'boosters à ouvrir' : 'booster à ouvrir';
    const owned = ownedCount(c);
    $('[data-owned]').textContent = String(owned);
    $('[data-bar]').style.width = `${(owned / pool.length) * 100}%`;
    $('.bar').setAttribute('aria-valuenow', String(owned));
    document.querySelectorAll<HTMLElement>('.nav__badge').forEach((b) => { b.hidden = c.credits < 1; b.textContent = String(c.credits); });
    pack.disabled = c.credits < 1;
    $('[data-pack-label]').textContent = c.credits < 1 ? 'Reviens demain' : 'Ouvrir';
    pack.setAttribute('aria-label', c.credits < 1 ? 'Plus de booster pour aujourd’hui' : 'Ouvrir un booster');
    for (const [n, li] of byNum) {
      const o = c.owned[n];
      li.classList.toggle('is-missing', !o);
      li.classList.toggle('is-holo', !!o?.holo);
      const badge = li.querySelector<HTMLElement>('.collection__n')!;
      badge.hidden = !o || o.n < 2;
      badge.textContent = o ? `×${o.n}` : '';
    }
    for (const page of Object.keys(BONUS_PAGES)) {
      document.querySelector(`[data-rule="${page}"]`)?.classList.toggle('is-done', c.pages.includes(page));
    }
    $('[data-rule="daily"]').classList.add('is-done');
  };

  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));

  // Ouverture : la pochette tremble, se déchire, les vignettes sortent face cachée
  pack.addEventListener('click', async () => {
    const pulls = openPack(pool, weight);
    if (!pulls) return;
    pack.disabled = true;
    pack.classList.add('is-shaking');
    await wait(550);
    pack.classList.remove('is-shaking');
    pack.classList.add('is-torn');
    await wait(450);

    const list = $('[data-reveal-cards]');
    list.replaceChildren();
    const back = $<HTMLTemplateElement>('#card-back');
    pulls.forEach((p, i) => {
      const li = document.createElement('li');
      li.className = 'pc';
      li.style.setProperty('--i', String(i));
      const src = byNum.get(p.num)!.querySelector('.sticker')!.cloneNode(true) as HTMLElement;
      src.querySelectorAll('img').forEach((img) => (img.loading = 'eager'));
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'pc__inner';
      btn.setAttribute('aria-label', 'Retourner la vignette');
      const front = document.createElement('div');
      front.className = 'pc__front';
      front.append(src);
      if (p.holo) front.insertAdjacentHTML('beforeend', '<span class="pc__shine" aria-hidden="true"></span>');
      btn.append(back.content.cloneNode(true), front);
      li.append(btn);
      if (p.isNew) li.dataset.new = '';
      if (p.holo) li.dataset.holo = '';
      li.dataset.rarete = byNum.get(p.num)!.dataset.rarete;
      btn.addEventListener('click', () => turn(li), { once: true });
      list.append(li);
    });
    $('[data-reveal]').hidden = false;
    $('[data-reveal-done]').hidden = true;
    $('[data-reveal-all]').hidden = false;
    $('[data-reveal]').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
    await wait(900);
    pack.classList.remove('is-torn');
    refresh();
  });

  const turn = (li: HTMLElement) => {
    if (li.classList.contains('is-turned')) return;
    li.classList.add('is-turned');
    const label = [li.querySelector('.sticker__name')?.textContent, li.hasAttribute('data-new') ? 'nouvelle' : 'double', li.hasAttribute('data-holo') ? 'holo' : ''].filter(Boolean).join(', ');
    li.querySelector('.pc__inner')!.setAttribute('aria-label', label);
    const all = [...document.querySelectorAll('.pc')];
    if (all.every((x) => x.classList.contains('is-turned'))) {
      $('[data-reveal-done]').hidden = false;
      $('[data-reveal-all]').hidden = true;
    }
  };

  $('[data-reveal-all]').addEventListener('click', async () => {
    for (const li of document.querySelectorAll<HTMLElement>('.pc:not(.is-turned)')) { turn(li); await wait(180); }
  });
  $('[data-reveal-done]').addEventListener('click', () => {
    $('[data-reveal]').hidden = true;
    $('#coll-title').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
  });

  refresh();
</script>
