---
import { srcset } from '../lib/img.js';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import matches from '../data/matches.json';
import PlayerCard from '../components/PlayerCard.astro';
import Agenda from '../components/Agenda.astro';
import { album } from '../lib/album.js';

// Nombre de joueurs annoncés dans le pôle
const rosterLabel = (g) => {
  const n = g.rosters.reduce((t, r) => t + r.players.length, 0);
  return g.id === 'rocket-league' ? `${g.rosters.length} rosters, ${n} joueurs` : `Depuis ${g.since}, ${n} joueur${n > 1 ? 's' : ''}`;
};
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero__bg" src="/img/hero-fond.webp" srcset={srcset("/img/hero-fond.webp")} sizes="100vw" alt="" width="1983" height="793" fetchpriority="high" />
    <img class="hero__kanji" src="/img/kanji-oni-neon.webp" srcset={srcset("/img/kanji-oni-neon.webp")} sizes="(max-width: 860px) 95vw, 50vw" alt="" width="1402" height="1122" fetchpriority="low" decoding="async" />
    <span class="hero__hud hud" aria-hidden="true"></span>
    <span class="hero__motto" aria-hidden="true">Oni's never on knees</span>
    <div class="wrap hero__inner">
      <h1 id="hero-title">Jamais à genoux.</h1>
      <p class="hero__lead">Club esport français né sur Rocket League en 2021, aujourd'hui sur quatre jeux.</p>
      <div class="hero__actions">
        <a class="btn" href="/recrutement/">Postuler</a>
        <a class="btn btn--ghost" href={site.discord} rel="noopener"><Icon name="discord" />Rejoindre le Discord</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="poles-title">
    <div class="wrap">
      <div class="album-intro">
        <div class="section__head">
          <h2 id="poles-title">Quatre jeux,<br /> un seul album.<img class="hanko" src="/img/hanko-oni.webp" alt="" width="320" height="308" loading="lazy" /></h2>
          <p>{album.total} vignettes de joueurs et de staff, plus des séries spéciales à gagner dans les boosters : un offert chaque jour.</p>
          <p class="album-intro__actions"><a class="btn" href="/effectif/">Ouvrir l'album</a><a class="btn btn--ghost" href="/boosters/">Ouvrir un booster</a></p>
        </div>
        <a class="album-intro__cover" href="/effectif/" tabindex="-1" aria-hidden="true">
          <img class="eclat" src="/img/encre-eclat-1.webp" alt="" width="420" height="402" loading="lazy" />
          <img src="/img/album-couverture.webp" srcset={srcset("/img/album-couverture.webp")} sizes="(max-width: 860px) 100vw, 46vw" alt="" width="1400" height="933" loading="lazy" />
        </a>
      </div>
      <ul class="games">
        {album.games.map(({ game: g, rosters }) => (
          <li>
            <a class="game" href={`/effectif/#${g.id}`}>
              <div>
                <h3 translate="no">{g.name}</h3>
                <div class="game__meta">{rosterLabel(g)}</div>
                <p class="game__pitch">{g.pitch}</p>
              </div>
              <ul class="game__fan" aria-hidden="true">
                {rosters.flatMap((r) => r.cards).slice(0, 3).map((c) => <li><PlayerCard {...c} /></li>)}
              </ul>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="matchs-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="matchs-title">Sur le terrain.</h2>
        <p>Showmatchs castés en direct sur Twitch et coupes communautaires.</p>
      </div>
      <Agenda />
      <div class="match-visuals" aria-hidden="true">
        {[
          ['match-showmatch', 'Rocket League', 759],
          ['match-lol', 'League of Legends', 534],
          ['match-valo', 'Valorant', 684],
          ['match-cup', 'Coupes', 684],
        ].map(([img, label, h]) => (
          <figure class="hud"><img src={`/img/${img}.webp`} srcset={srcset(`/img/${img}.webp`)} sizes="(max-width: 720px) 100vw, 48vw" alt="" width="1600" height={h} loading="lazy" /><figcaption>{label}</figcaption></figure>
        ))}
      </div>
      <ol class="ledger">
        {matches.map((m, i) => (
          <li>
            <span class="ledger__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {m.event === 'Showmatch' ? (
              <span class="ledger__vs"><span translate="no">Oni Korp</span><span class="ledger__x">vs</span><span translate="no">{m.opponent}</span></span>
            ) : (
              <span class="ledger__vs"><span translate="no">{m.event}</span></span>
            )}
            <span class="ledger__meta">
              {m.event === 'Showmatch' ? 'Showmatch Rocket League' : m.opponent}
              {m.format && m.format !== 'Cup' && <b>{m.format}</b>}
            </span>
          </li>
        ))}
      </ol>
      <p style="margin-top:2rem"><a class="btn btn--ghost" href="https://www.twitch.tv/oni_korp" rel="noopener"><Icon name="twitch" />Suivre les matchs sur Twitch</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="partenaires-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="partenaires-title">À nos côtés.</h2>
        <p>Les partenaires qui accompagnent le club.</p>
      </div>
      <ul class="partners">
        <li>
          <img src="/img/partenaires/carl-barl.webp" alt="" width="304" height="320" loading="lazy" />
          <div><strong translate="no">Carl &amp; Barl by LNDR</strong><span>Rocket League · decals Octane et Fennec</span></div>
        </li>
        <li>
          <img class="partners__wordmark" src="/img/partenaires/lolineup.webp" alt="LoLineup.gg" width="903" height="160" loading="lazy" />
          <div><span>League of Legends · partenaire du pôle</span></div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--red section--brush" aria-labelledby="recrut-title">
    <div class="wrap recruit">
      <div>
        <h2 id="recrut-title">On recrute.</h2>
        <p style="margin-top:1rem;font-size:1.15rem">Tu veux jouer dans une dynamique plus pro, avec des coéquipiers qui ont le même niveau d'exigence ? Ta place est peut-être ici.</p>
        <ul class="reqs">
          <li>Rang Champion 1 minimum sur Rocket League</li>
          <li>15 ans minimum</li>
          <li>Actif, mature et disponible pour les entraînements</li>
        </ul>
      </div>
      <div>
        <ol class="steps">
          <li><div><strong>Remplis le formulaire</strong><p>Joueur ou staff, quelques minutes suffisent.</p></div></li>
          <li><div><strong>Ouvre un ticket sur le Discord</strong><p>C'est ce qui officialise ta candidature.</p></div></li>
          <li><div><strong>Présente-toi au staff</strong><p>Le manager ou le coach du pôle te répond et organise la suite.</p></div></li>
        </ol>
        <div class="recruit__actions">
          <a class="btn btn--ink" href="/recrutement/">Voir les postes ouverts</a>
          <a class="btn btn--ghost" href={site.discord} rel="noopener">Ouvrir un ticket</a>
        </div>
      </div>
    </div>
  </section>

</Base>
