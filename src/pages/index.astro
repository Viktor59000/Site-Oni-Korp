---
import { srcset } from '../lib/img.js';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import Agenda from '../components/Agenda.astro';
import Partners from '../components/Partners.astro';
import { album } from '../lib/album.js';

---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <picture>
      <source media="(max-width: 860px)" srcset="/img/hero-v2-mobile.webp" width="700" height="778" />
      <img class="hero__bg" src="/img/hero-v2.webp" srcset="/img/hero-v2-900.webp 900w, /img/hero-v2.webp 1916w" sizes="100vw" alt="" width="1916" height="821" fetchpriority="high" />
    </picture>
    <span class="hero__hud hud" aria-hidden="true"></span>
    <span class="hero__motto" aria-hidden="true">Oni's never on knees</span>
    <div class="wrap hero__inner">
      <h1 id="hero-title">Jamais à genoux.</h1>
      <p class="hero__lead">Club esport français né sur Rocket League en 2021, aujourd'hui sur quatre jeux.</p>
      <div class="hero__actions">
        <a class="btn" href="/recrutement/">Postuler</a>
        <a class="btn btn--ghost" href={site.discord} rel="noopener"><Icon name="discord" />Rejoindre le Discord</a>
      </div>
      <p class="hero__count" data-count hidden><span aria-hidden="true"></span><span data-count-text></span></p>
    </div>
  </section>

  <section class="section home-live" aria-labelledby="live-title" data-home-live hidden>
    <div class="wrap">
      <div class="section__head section__head--row">
        <h2 id="live-title"><span class="home-live__dot" aria-hidden="true"></span><span data-live-title>En direct.</span></h2>
        <a class="btn btn--ghost" href="/createurs/">Nos créateurs</a>
      </div>
      <div class="home-live__grid">
        <div class="home-live__player" data-live-player></div>
        <ul class="home-live__others" data-live-others></ul>
      </div>
    </div>
  </section>

  <section class="section section--red section--brush" aria-labelledby="today-title">
    <div class="wrap today">
      <div>
        <h2 id="today-title">Une nouvelle ère commence.</h2>
        <p class="today__lead">Le club se reconstruit : nouveaux rosters, nouveaux outils, la même exigence. Les places sont ouvertes, sur tous nos jeux, pour les joueurs comme pour le staff.</p>
        <div class="recruit__actions">
          <a class="btn btn--ink" href="/postuler/">Postuler</a>
          <a class="btn btn--ghost" href="/recrutement/">Voir les postes</a>
        </div>
      </div>
      <ol class="today__points">
        <li><strong>Des rosters à construire</strong><span>Rocket League, League of Legends, Valorant, osu! : chaque line-up se forme maintenant.</span></li>
        <li><strong>Un vrai cadre</strong><span>Planning, stats, débriefs, strats : chaque roster a son espace et son staff.</span></li>
        <li><strong>On joue et on se montre</strong><span>Tournois, showmatchs castés sur Twitch, contenu avec le club.</span></li>
      </ol>
    </div>
  </section>


  <section class="section next-rdv" aria-labelledby="rdv-title" data-agenda-section hidden>
    <div class="wrap">
      <div class="section__head section__head--row">
        <h2 id="rdv-title">Prochains rendez-vous.</h2>
        <a class="btn btn--ghost" href="/agenda/">Tout l'agenda</a>
      </div>
      <Agenda />
    </div>
  </section>

  <section class="section home-ih" aria-labelledby="ih-title">
    <div class="wrap home-ih__grid">
      <img class="home-ih__img" src="/img/accueil-inhouses-800.webp" srcset={srcset("/img/accueil-inhouses.webp")} sizes="(max-width: 860px) 100vw, 560px" alt="" width="800" height="500" loading="lazy" />
      <div>
        <h2 id="ih-title">Les inhouses,<br /> ouverts à tous.</h2>
        <p>Rejoins une file sur le Discord : le bot équilibre les équipes, crée les vocaux et tient l'Elo. Rocket League en 1v1, 2v2 et 3v3, League of Legends et Valorant en 5v5, osu! en 1v1 et 2v2.</p>
        <ol class="home-ih__top" data-ih-top hidden></ol>
        <div class="recruit__actions">
          <a class="btn" href="/inhouses/">Voir le classement</a>
          <a class="btn btn--ghost" href={site.discord} rel="noopener"><Icon name="discord" />Jouer sur le Discord</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="poles-title">
    <div class="wrap">
      <div class="album-intro">
        <div class="section__head">
          <h2 id="poles-title">Les légendes,<br /> en album.<img class="hanko" src="/img/hanko-oni.webp" srcset={srcset("/img/hanko-oni.webp")} sizes="64px" alt="" width="320" height="318" loading="lazy" /></h2>
          <p>{album.total} vignettes All Stars des joueurs et du staff qui ont fait le club, plus des séries spéciales à gagner dans les boosters : un offert chaque jour.</p>
          <p class="album-intro__actions"><a class="btn" href="/effectif/">Ouvrir l'album</a><a class="btn btn--ghost" href="/boosters/">Ouvrir un booster</a></p>
        </div>
        <a class="album-intro__cover" href="/effectif/" tabindex="-1" aria-hidden="true">
          <img class="eclat" src="/img/encre-eclat-1.webp" alt="" width="420" height="402" loading="lazy" />
          <img src="/img/accueil-album-560.webp" srcset={srcset("/img/accueil-album.webp")} sizes="(max-width: 860px) 80vw, 420px" alt="" width="560" height="700" loading="lazy" />
        </a>
      </div>
    </div>
  </section>



  <section class="section" aria-labelledby="partenaires-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="partenaires-title">À nos côtés.</h2>
        <p>Les partenaires qui accompagnent le club.</p>
      </div>
      <Partners compact />
    </div>
  </section>



</Base>

<script>
  // En direct : le live du club passe en premier (lecteur Twitch intégré), les autres créateurs en dessous
  type L = { titre: string; lien: string; image: string | null; jeu: string | null; club: boolean; chaine: string | null };
  fetch('/api/feed').then((r) => (r.ok ? r.json() : null)).then((d: { live: L[] } | null) => {
    const lives = d?.live ?? []; if (!lives.length) return;
    const [main, ...others] = lives;
    const section = document.querySelector<HTMLElement>('[data-home-live]')!;
    if (main.club) section.classList.add('home-live--club');
    document.querySelector('[data-live-title]')!.textContent = main.club ? 'Oni Korp est en direct.' : 'En direct chez nos créateurs.';
    const box = document.querySelector<HTMLElement>('[data-live-player]')!;
    if (main.chaine) {
      // Le lecteur Twitch (et ses cookies) ne se charge qu'au clic : aperçu du live d'ici là
      const b = document.createElement('button'); b.type = 'button'; b.className = 'home-live__facade';
      b.setAttribute('aria-label', `Lancer le live : ${main.titre}`);
      if (main.image) { const img = document.createElement('img'); img.src = main.image; img.alt = ''; img.width = 1280; img.height = 720; b.append(img); }
      const play = document.createElement('span'); play.className = 'home-live__play'; play.textContent = '▶ Lancer le live'; b.append(play);
      b.addEventListener('click', () => {
        const f = document.createElement('iframe');
        f.src = `https://player.twitch.tv/?channel=${encodeURIComponent(main.chaine!)}&parent=${location.hostname}&autoplay=true`;
        f.title = `Live Twitch : ${main.titre}`; f.allowFullscreen = true; f.allow = 'autoplay; fullscreen';
        b.replaceWith(f);
      }, { once: true });
      box.append(b);
    }
    const cap = document.createElement('a'); cap.className = 'home-live__cap'; cap.href = main.lien; cap.rel = 'noopener';
    const t = document.createElement('strong'); t.textContent = main.titre;
    const g = document.createElement('span'); g.textContent = main.jeu ? `${main.jeu} · regarder sur Twitch` : 'Regarder sur Twitch';
    cap.append(t, g); box.append(cap);
    const ul = document.querySelector<HTMLElement>('[data-live-others]')!;
    for (const o of others) {
      const li = document.createElement('li'); const a = document.createElement('a'); a.href = o.lien; a.rel = 'noopener';
      if (o.image) { const img = document.createElement('img'); img.src = o.image; img.alt = ''; img.width = 320; img.height = 180; img.loading = 'lazy'; a.append(img); }
      const tt = document.createElement('span'); tt.textContent = o.titre; a.append(tt); li.append(a); ul.append(li);
    }
    if (!others.length) ul.remove();
    section.hidden = false;
  }).catch(() => {});

  // Membres et personnes en ligne sur le Discord (relevés par Oni Bot toutes les 10 minutes)
  fetch('/api/club').then((r) => (r.ok ? r.json() : null)).then((d) => {
    const n = d?.discord; if (!n?.membres) return;
    const t = `${n.membres} membres sur le Discord${n.enLigne ? ` · ${n.enLigne} en ligne` : ''}`;
    document.querySelector('[data-count-text]')!.textContent = t;
    document.querySelector<HTMLElement>('[data-count]')!.hidden = false;
  }).catch(() => {});

  // Podium des inhouses : les 3 meilleurs Elo, tous modes confondus (au moins 3 parties)
  fetch('/api/inhouse').then((r) => (r.ok ? r.json() : null)).then((d) => {
    const LABEL: Record<string, string> = { 'rl-3v3': 'RL 3v3', 'rl-2v2': 'RL 2v2', 'rl-1v1': 'RL 1v1', 'lol-5v5': 'LoL', 'valo-5v5': 'Valorant', 'osu-1v1': 'osu! 1v1', 'osu-2v2': 'osu! 2v2' };
    const all = Object.entries(d?.modes ?? {}).flatMap(([mode, list]: [string, any]) => list.filter((p: any) => p.wins + p.losses >= 3).map((p: any) => ({ ...p, mode })));
    const top = all.sort((a: any, b: any) => b.rating - a.rating).slice(0, 3);
    if (!top.length) return;
    const el = document.querySelector<HTMLElement>('[data-ih-top]')!;
    for (const p of top) {
      const li = document.createElement('li');
      const name = document.createElement('strong'); name.textContent = p.name;
      const info = document.createElement('span'); info.textContent = `${p.rating} Elo · ${LABEL[p.mode] ?? p.mode}`;
      li.append(name, info); el.append(li);
    }
    el.hidden = false;
  }).catch(() => {});
</script>

<style>
  .home-live { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .home-live h2 { display: flex; align-items: center; gap: .7rem; }
  .home-live__dot { width: .7em; height: .7em; border-radius: 50%; background: #9146ff; box-shadow: 0 0 0 0 #9146ff88; animation: live-pulse 1.6s infinite; flex: none; }
  .home-live--club .home-live__dot { background: var(--lacquer); box-shadow: 0 0 0 0 color-mix(in srgb, var(--lacquer) 55%, transparent); }
  @keyframes live-pulse { 70% { box-shadow: 0 0 0 .6em transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  @media (prefers-reduced-motion: reduce) { .home-live__dot { animation: none; } }
  .home-live__grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .home-live__grid:has(.home-live__others:empty), .home-live__grid:not(:has(.home-live__others)) { grid-template-columns: minmax(0, 1fr); }
  .home-live__player { display: grid; gap: .75rem; }
  .home-live__player :global(iframe) { width: 100%; aspect-ratio: 16 / 9; border: 0; background: #000; display: block; }
  .home-live__player :global(.home-live__facade) { position: relative; display: grid; place-items: center; width: 100%; aspect-ratio: 16 / 9; padding: 0; border: 0; background: #000; cursor: pointer; overflow: hidden; }
  .home-live__player :global(.home-live__facade img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .8; transition: opacity .2s; }
  .home-live__player :global(.home-live__facade:hover img), .home-live__player :global(.home-live__facade:focus-visible img) { opacity: 1; }
  .home-live__player :global(.home-live__play) { position: relative; padding: .7rem 1.2rem; background: #9146ff; color: #fff; font-weight: 700; }
  .home-live--club .home-live__player :global(.home-live__play) { background: var(--lacquer); }
  .home-live--club .home-live__player :global(.home-live__facade),
  .home-live--club .home-live__player :global(iframe) { outline: 3px solid var(--lacquer); outline-offset: 4px; }
  .home-live__player :global(.home-live__cap) { display: grid; gap: .2rem; color: var(--ink); }
  .home-live__player :global(.home-live__cap span) { color: var(--muted); font-size: var(--step--1); }
  .home-live__others { display: grid; gap: 1rem; }
  .home-live__others :global(a) { display: grid; gap: .4rem; color: var(--ink); font-weight: 700; }
  .home-live__others :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  @media (max-width: 860px) { .home-live__grid { grid-template-columns: minmax(0, 1fr); } }
  .home-ih__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  .home-ih__img { width: 100%; height: auto; display: block; }
  .home-ih h2 { font-size: var(--step-3); }
  .home-ih__top { list-style: none; counter-reset: ih; margin: 1.25rem 0 0; padding: 0; display: grid; gap: .5rem; }
  .home-ih__top li { counter-increment: ih; display: flex; align-items: baseline; gap: .75rem; }
  .home-ih__top li::before { content: counter(ih); font-family: var(--font-display); color: var(--lacquer-hi); min-width: 1.2em; }
  .home-ih__top span { color: var(--ash); font-size: var(--step--1); }
  @media (max-width: 860px) { .home-ih__grid { grid-template-columns: 1fr; } }
</style>
