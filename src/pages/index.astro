---
import { srcset } from '../lib/img.js';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import Agenda from '../components/Agenda.astro';
import { album } from '../lib/album.js';

---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <img class="hero__bg" src="/img/hero-fond.webp" srcset={srcset("/img/hero-fond.webp")} sizes="100vw" alt="" width="1983" height="793" fetchpriority="high" />
    <img class="hero__kanji" src="/img/kanji-oni-neon.webp" srcset={srcset("/img/kanji-oni-neon.webp")} sizes="(max-width: 860px) 95vw, 50vw" alt="" width="1402" height="1122" fetchpriority="low" decoding="async" />
    <span class="hero__hud hud" aria-hidden="true"></span>
    <span class="hero__motto" aria-hidden="true">Oni's never on knees</span>
    <div class="wrap hero__inner">
      <h1 id="hero-title">Jamais à genoux.</h1>
      <p class="hero__lead">Club esport français né sur Rocket League en 2021, aujourd'hui sur quatre jeux.</p>
      <div class="hero__actions">
        <a class="btn" href="/recrutement/">Postuler</a>
        <a class="btn btn--ghost" href={site.discord} rel="noopener"><Icon name="discord" />Rejoindre le Discord</a>
      </div>
      <p class="hero__count" data-count hidden><span aria-hidden="true"></span><span data-count-text></span></p>
    </div>
  </section>

  <section class="section section--red section--brush" aria-labelledby="today-title">
    <div class="wrap today">
      <div>
        <h2 id="today-title">Une nouvelle ère commence.</h2>
        <p class="today__lead">Le club se reconstruit : nouveaux rosters, nouveaux outils, la même exigence. Les places sont ouvertes, sur tous nos jeux, pour les joueurs comme pour le staff.</p>
        <div class="recruit__actions">
          <a class="btn btn--ink" href="/postuler/">Postuler</a>
          <a class="btn btn--ghost" href="/recrutement/">Voir les postes</a>
        </div>
      </div>
      <ol class="today__points">
        <li><strong>Des rosters à construire</strong><span>Rocket League, League of Legends, Valorant, osu! : chaque line-up se forme maintenant.</span></li>
        <li><strong>Un vrai cadre</strong><span>Planning, stats, débriefs, strats : chaque roster a son espace et son staff.</span></li>
        <li><strong>On joue et on se montre</strong><span>Tournois, showmatchs castés sur Twitch, contenu avec le club.</span></li>
      </ol>
    </div>
  </section>


  <section class="section next-rdv" aria-labelledby="rdv-title" data-agenda-section hidden>
    <div class="wrap">
      <div class="section__head section__head--row">
        <h2 id="rdv-title">Prochains rendez-vous.</h2>
        <a class="btn btn--ghost" href="/agenda/">Tout l'agenda</a>
      </div>
      <Agenda />
    </div>
  </section>

  <section class="section" aria-labelledby="poles-title">
    <div class="wrap">
      <div class="album-intro">
        <div class="section__head">
          <h2 id="poles-title">Les légendes,<br /> en album.<img class="hanko" src="/img/hanko-oni.webp" alt="" width="320" height="308" loading="lazy" /></h2>
          <p>{album.total} vignettes All Stars des joueurs et du staff qui ont fait le club, plus des séries spéciales à gagner dans les boosters : un offert chaque jour.</p>
          <p class="album-intro__actions"><a class="btn" href="/effectif/">Ouvrir l'album</a><a class="btn btn--ghost" href="/boosters/">Ouvrir un booster</a></p>
        </div>
        <a class="album-intro__cover" href="/effectif/" tabindex="-1" aria-hidden="true">
          <img class="eclat" src="/img/encre-eclat-1.webp" alt="" width="420" height="402" loading="lazy" />
          <img src="/img/album-couverture.webp" srcset={srcset("/img/album-couverture.webp")} sizes="(max-width: 860px) 100vw, 46vw" alt="" width="1400" height="933" loading="lazy" />
        </a>
      </div>
    </div>
  </section>



  <section class="section" aria-labelledby="partenaires-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="partenaires-title">À nos côtés.</h2>
        <p>Les partenaires qui accompagnent le club.</p>
      </div>
      <ul class="partners">
        <li>
          <img src="/img/partenaires/carl-barl.webp" alt="" width="304" height="320" loading="lazy" />
          <div><strong translate="no">Carl &amp; Barl by LNDR</strong><span>Rocket League · decals Octane et Fennec</span></div>
        </li>
        <li>
          <img class="partners__wordmark" src="/img/partenaires/lolineup.webp" alt="LoLineup.gg" width="903" height="160" loading="lazy" />
          <div><span>League of Legends · partenaire du pôle</span></div>
        </li>
      </ul>
    </div>
  </section>



</Base>

<script>
  // Membres et personnes en ligne sur le Discord (relevés par Oni Bot toutes les 10 minutes)
  fetch('/api/club').then((r) => (r.ok ? r.json() : null)).then((d) => {
    const n = d?.discord; if (!n?.membres) return;
    const t = `${n.membres} membres sur le Discord${n.enLigne ? ` · ${n.enLigne} en ligne` : ''}`;
    document.querySelector('[data-count-text]')!.textContent = t;
    document.querySelector<HTMLElement>('[data-count]')!.hidden = false;
  }).catch(() => {});
</script>
