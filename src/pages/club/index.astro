---
import { srcset } from '../../lib/img.js';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { album } from '../../lib/album.js';

// Le club en chiffres, calculé depuis les données de l'album
// Une même personne peut jouer dans deux pôles (AlphA, Sheep) : on la compte une fois
const joueurs = new Set(album.games.flatMap((g) => g.rosters.flatMap((r) => r.cards.map((c) => c.name)))).size;
const chiffres = [
  ['2021', 'année de création'],
  [String(album.games.length), 'jeux joués depuis 2021'],
  [String(joueurs), "joueurs légendes"],
  [String(album.staff.length), 'membres du staff historique'],
];
---
<Base title="Le club" description="L'histoire d'Oni Korp, club esport français fondé le 12 juillet 2021 sur Rocket League : rosters League of Legends, Valorant et osu!, showmatchs, valeurs.">
  <header class="page-head">
    <img class="page-head__bg" src="/img/entete-club.webp" srcset={srcset("/img/entete-club.webp")} sizes="100vw" fetchpriority="high" alt="" width="2000" height="667" />
    <div class="wrap">
      <h1>Le club</h1>
      <p>Une structure née entre amis, devenue un club multi-jeux qui ne lâche rien.</p>
    </div>
  </header>

  <section class="section section--bone" aria-labelledby="histoire">
    <div class="wrap club">
      <div class="club__story">
        <h2 id="histoire" style="font-size:var(--step-3);margin-bottom:1.5rem">Notre histoire</h2>
        <p>Oni Korp rassemble depuis 2021 des joueurs qui ont l'ambition des plus grands. Chaque joueur est choisi avec soin : une candidature, un échange avec le staff du pôle, puis une place dans un roster adapté à son niveau.</p>
        <p>Le club a connu des succès, des défaites et des périodes difficiles. En 2024, une refonte complète a remis à plat l'organisation : nouveaux outils, procédures plus claires et un staff organisé pôle par pôle.</p>
        <p class="signature">Notre devise n'a pas changé : <em>Oni's never on knees</em>.<img class="hanko" src="/img/hanko-oni.webp" srcset={srcset("/img/hanko-oni.webp")} sizes="64px" alt="" width="300" height="300" loading="lazy" /></p>
      </div>
      <ol class="timeline" aria-label="Dates clés">
        <li><time datetime="2021-07-12">12 juillet 2021</time><p>Création d'Oni Korp sur Rocket League, et premier decal du club.</p></li>
        <li><time datetime="2022">2022</time><p>Showmatchs castés sur Twitch face à Dream Team, Passione, K-Othic ou Imperial. Deuxième génération du decal.</p></li>
        <li><time datetime="2023">2023</time><p>Partenariat avec Carl & Barl by LNDR et sortie des decals Octane et Fennec.</p></li>
        <li><time datetime="2024-01">Janvier 2024</time><p>Ouverture des pôles League of Legends, Valorant et osu!.</p></li>
        <li><time datetime="2024">2024</time><p>Refonte de la structure et des méthodes de travail.</p></li>
        <li><time datetime="2026">2026</time><p>Nouvelle ère : le club se reconstruit, avec un espace dédié à chaque roster, un bot maison et des <a href="/inhouses/">inhouses</a> ouverts à toute la communauté.</p></li>
        <li><time>Prochaine étape</time><p>Statut d'association loi 1901 et locaux.</p></li>
      </ol>
    </div>
  </section>

  <section class="section dark" aria-labelledby="chiffres-title">
    <div class="wrap">
      <h2 id="chiffres-title" class="sr-only">Le club en chiffres</h2>
      <dl class="stats">
        {chiffres.map(([n, l]) => <div><dt>{l}</dt><dd>{n}</dd></div>)}
      </dl>
      <p class="stats__link"><a href="/effectif/">Voir les légendes du club</a></p>
    </div>
  </section>

  <section class="section section--red section--brush">
    <div class="wrap recruit" style="align-items:center">
      <h2>Envie d’écrire la suite avec nous&nbsp;?</h2>
      <div class="recruit__actions" style="margin-top:0">
        <a class="btn btn--ink" href="/recrutement/">Postuler</a>
        <a class="btn btn--ghost" href={site.discord} rel="noopener">Rejoindre le Discord</a>
      </div>
    </div>
  </section>
</Base>
