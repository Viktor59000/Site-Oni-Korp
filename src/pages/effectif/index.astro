---
import { srcset } from '../../lib/img.js';
import { album, prefix } from '../../lib/album.js';
import Base from '../../layouts/Base.astro';
import PlayerCard from '../../components/PlayerCard.astro';
import CardViewer from '../../components/CardViewer.astro';
---
<Base title="Légendes du club" description="Les légendes d'Oni Korp : les joueurs et le staff qui ont écrit l'histoire du club depuis 2021, en vignettes à collectionner.">
  <header class="page-head">
    <img class="page-head__bg" src="/img/entete-effectif.webp" srcset={srcset("/img/entete-effectif.webp")} sizes="100vw" fetchpriority="high" alt="" width="2000" height="667" />
    <div class="wrap">
      <h1>Légendes du club</h1>
      <p>{album.total} vignettes All Stars : les joueurs et le staff qui ont porté Oni Korp depuis 2021.</p>
      <p class="my-album" data-my-album hidden>Ta collection : <strong data-my-owned>0</strong> / {album.totalAll} · <a href="/boosters/">Ouvrir un booster</a></p>
    </div>
  </header>

  <section class="legend-now" aria-labelledby="now-title">
    <div class="wrap legend-now__inner">
      <div>
        <h2 id="now-title">Et aujourd'hui ?</h2>
        <p>Le club se reconstruit. Les jeux et les line-ups de la nouvelle ère seront annoncés ici, roster par roster. Les places sont ouvertes : la prochaine légende, c'est peut-être toi.</p>
      </div>
      <div class="legend-now__actions">
        <a class="btn" href="/postuler/">Postuler</a>
        <a class="btn btn--ghost" href="/agenda/">Suivre l'agenda</a>
      </div>
    </div>
  </section>

  <div class="topo topo--legend">
  <div class="wrap">
    {album.games.map(({ game: g, rosters, tba }) => (
      <section class="roster-game" id={g.id} aria-labelledby={`${g.id}-title`}>
        <span class="roster-game__vertical" aria-hidden="true" translate="no">{g.name}</span>
        <div class="roster-game__head">
          <div>
            <h2 id={`${g.id}-title`} translate="no" class="roster-game__title"><img class="roster-game__logo" src={`/img/jeux/${prefix[g.id]}.webp`} alt="" width="56" height="56" loading="lazy" />{g.name}</h2>
            <p>{g.pitch}</p>
            {g.staff?.length > 0 && (
              <dl class="pole-staff">
                {g.staff.map((st) => <div><dt>{st.role}</dt><dd translate="no">{st.name}</dd></div>)}
              </dl>
            )}
          </div>
          <div class="hud"><div class="game__img"><img src={g.banner} srcset={srcset(g.banner)} sizes="(max-width: 720px) 100vw, 42vw" alt="" loading="lazy" width="1200" height="480" /></div></div>
        </div>
        <div class="rosters">
          {rosters.map((r) => (
            <div class={`roster${rosters.length === 1 ? ' roster--wide' : ''}`} data-equipe={r.equipe}>
              <h3>{r.lettre && <span class="roster__lettre" aria-hidden="true">{r.lettre}</span>}{r.title}{r.equipe && <span class="roster__equipe">Équipe {r.equipe}</span>}</h3>
              <ul class="players">
                {r.cards.map((c) => <li><PlayerCard {...c} zoom /></li>)}
              </ul>
            </div>
          ))}
        </div>
        {tba.length > 0 && (
          <p class="rosters-tba"><strong>{tba.join(', ')}</strong> : à annoncer. <a href="/recrutement/">Les places sont ouvertes</a>.</p>
        )}
      </section>
    ))}

    <section class="roster-game roster-game--last" id="staff" aria-labelledby="staff-title">
      <div class="section__head">
        <h2 id="staff-title">Staff</h2>
        <p>Ceux qui font tourner le club, avec tous leurs rôles. Le recrutement est assuré par les managers et les coachs de chaque pôle.</p>
      </div>
      <ul class="players players--staff">
        {album.staff.map((c) => <li><PlayerCard {...c} zoom /></li>)}
        {album.open.map((s) => (
          <li>
            <a class="slot" href="/recrutement/#staff">
              <span class="slot__num">{String(s.num).padStart(2, '0')}</span>
              <span class="slot__plus" aria-hidden="true">+</span>
              <span class="slot__role">{s.role}</span>
              <span class="slot__cta">Emplacement libre : postuler</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
  </div>
  <CardViewer total={album.total} />
  <script>
    import { load, ownedCount } from '../../lib/collection';
    // Vignettes déjà obtenues dans les boosters : tampon « obtenue » sur l'album
    const c = load();
    const n = ownedCount(c);
    if (n > 0) {
      document.querySelector<HTMLElement>('[data-my-album]')!.hidden = false;
      document.querySelector('[data-my-owned]')!.textContent = String(n);
      document.querySelectorAll<HTMLElement>('.sticker[data-num]').forEach((el) => {
        const o = c.owned[el.dataset.num!];
        if (!o) return;
        el.classList.add('is-owned');
        if (o.holo) el.classList.add('is-holo');
      });
    }
  </script>
</Base>
