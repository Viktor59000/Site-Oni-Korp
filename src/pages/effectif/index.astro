---
import { srcset, small } from '../../lib/img.js';
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import PlayerCard from '../../components/PlayerCard.astro';
import data from '../../data/rosters.json';

// Un joueur peut être un simple pseudo ou un objet { name, role, photo }
const norm = (p) => (typeof p === 'string' ? { name: p } : p);
---
<Base title="Effectif" description="Les rosters Oni Korp sur Rocket League, League of Legends, Valorant et osu!, et le staff du club.">
  <header class="page-head">
    <img class="page-head__bg" src="/img/entete-effectif.webp" srcset={srcset("/img/entete-effectif.webp")} sizes="100vw" fetchpriority="high" alt="" width="1983" height="793" />
    <span class="page-head__kanji" aria-hidden="true">隊</span>
    <div class="wrap">
      <h1>Effectif</h1>
      <p>Les rosters par jeu et le staff qui les fait tourner.</p>
    </div>
  </header>

  <div class="wrap">
    {data.games.map((g) => (
      <section class="roster-game" id={g.id} aria-labelledby={`${g.id}-title`}>
        <div class="roster-game__head">
          <div>
            <h2 id={`${g.id}-title`}>{g.name}</h2>
            <p>{g.pitch}</p>
            {g.staff?.length > 0 && (
              <dl class="pole-staff">
                {g.staff.map((st) => <div><dt>{st.role}</dt><dd>{st.name}</dd></div>)}
              </dl>
            )}
          </div>
          <div class="game__img"><img src={g.banner} srcset={srcset(g.banner)} sizes="(max-width: 720px) 100vw, 42vw" alt="" loading="lazy" width="1200" height="480" /></div>
        </div>
        <div class="rosters">
          {g.rosters.filter((r) => r.players.length).map((r) => (
            <div class={`roster${g.rosters.length === 1 ? ' roster--wide' : ''}`}>
              <h3>{g.rosters.length > 1 ? `Roster ${r.name}` : r.name}</h3>
              <ul class="players">
                {r.players.map(norm).map((p) => (
                  <li><PlayerCard name={p.name} photo={p.photo} art={small(g.banner)} roster={p.role ?? (g.rosters.length > 1 ? `Roster ${r.name}` : g.name)} /></li>
                ))}
              </ul>
            </div>
          ))}
          {!g.rosters.some((r) => r.players.length) && (
            <div class="roster">
              <h3>{g.rosters[0].name}</h3>
              <ul class="players">
                <li>
                  <a class="pcard pcard--open" href="/recrutement/">
                    <img class="pcard__art" src={small(g.banner)} alt="" loading="lazy" />
                    <span class="pcard__plus" aria-hidden="true">+</span>
                    <span class="pcard__foot"><span class="pcard__roster">{g.name}</span><span class="pcard__name" style="font-size:9cqi">Ta place est ici</span></span>
                  </a>
                </li>
              </ul>
            </div>
          )}
        </div>
        {g.rosters.some((r) => r.players.length) && (() => {
          const tba = g.rosters.filter((r) => !r.players.length);
          if (!tba.length) return null;
          const label = g.rosters.length > 1 ? tba.map((r) => `Roster ${r.name}`).join(', ') : 'Line-up';
          return <p class="rosters-tba"><strong>{label}</strong> : à annoncer. <a href="/recrutement/">Les places sont ouvertes</a>.</p>;
        })()}
      </section>
    ))}

    <section class="roster-game roster-game--last" id="staff" aria-labelledby="staff-title">
      <div class="section__head">
        <h2 id="staff-title">Staff</h2>
        <p>Les managers et coachs sont présentés avec leur pôle. Les postes sans nom sont ouverts : <a href="/recrutement/#staff">candidater au staff</a>.</p>
      </div>
      <ul class="staff">
        {data.staff.map((s) => (
          <li class="staff__item">
            {s.names.length ? <Avatar name={s.names[0]} size="sm" /> : <a class="avatar avatar--sm avatar--open" href="/recrutement/#staff" aria-label={`Candidater au poste ${s.role}`}>+</a>}
            <div>
              <span class="staff__role">{s.role}</span>
              {s.names.length ? <span class="staff__name">{s.names.join(', ')}</span> : <span class="staff__name open">Poste ouvert</span>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
