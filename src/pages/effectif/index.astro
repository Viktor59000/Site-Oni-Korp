---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import data from '../../data/rosters.json';

// Un joueur peut être un simple pseudo ou un objet { name, photo }
const norm = (p) => (typeof p === 'string' ? { name: p } : p);
---
<Base title="Effectif" description="Les rosters Oni Korp sur Rocket League, League of Legends, Valorant et osu!, et le staff du club.">
  <header class="page-head">
    <img class="page-head__bg" src="/img/entete-effectif.webp" alt="" width="1983" height="793" />
    <span class="page-head__kanji" aria-hidden="true">隊</span>
    <div class="wrap">
      <h1>Effectif</h1>
      <p>Les rosters par jeu et le staff qui les fait tourner.</p>
    </div>
  </header>

  <div class="wrap">
    {data.games.map((g) => (
      <section class="roster-game" id={g.id} aria-labelledby={`${g.id}-title`}>
        <div class="roster-game__head">
          <div>
            <h2 id={`${g.id}-title`}>{g.name}</h2>
            <p>{g.pitch}</p>
          </div>
          <div class="game__img"><img src={g.banner} alt="" loading="lazy" width="1983" height="793" /></div>
        </div>
        <div class="rosters">
          {g.rosters.map((r) => (
            <div class="roster">
              <h3>{g.rosters.length > 1 ? `Roster ${r.name}` : r.name}</h3>
              {r.players.length ? (
                <ul class="players">
                  {r.players.map(norm).map((p) => (
                    <li><Avatar name={p.name} photo={p.photo} /><span>{p.name}</span></li>
                  ))}
                </ul>
              ) : <p class="tba">Line-up à annoncer</p>}
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="roster-game roster-game--last" id="staff" aria-labelledby="staff-title">
      <div class="section__head">
        <h2 id="staff-title">Staff</h2>
        <p>Les postes sans nom sont ouverts. <a href="/recrutement/#staff">Candidater au staff</a></p>
      </div>
      <ul class="staff">
        {data.staff.map((s) => (
          <li class="staff__item">
            {s.name ? <Avatar name={s.name} photo={s.photo} size="sm" /> : <a class="avatar avatar--sm avatar--open" href="/recrutement/#staff" aria-label={`Candidater au poste ${s.role}`}>+</a>}
            <div>
              <span class="staff__role">{s.role}</span>
              {s.name ? <span class="staff__name">{s.name}</span> : <span class="staff__name open">Poste ouvert</span>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
